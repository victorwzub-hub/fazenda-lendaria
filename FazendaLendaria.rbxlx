		max = 12,
		baseCost = 150,
		growth = 1.9,
	},
	Velocidade = {
		id = "Velocidade",
		name = "Botas Rápidas",
		emoji = "👢",
		desc = "+3 de velocidade para fugir dos guardiões",
		max = 8,
		baseCost = 100,
		growth = 1.8,
	},
	Rede = {
		id = "Rede",
		name = "Rede de Coleta",
		emoji = "🥅",
		desc = "Pega mais itens em cada coleta",
		max = 8,
		baseCost = 150,
		growth = 1.8,
	},
	Cesta = {
		id = "Cesta",
		name = "Cesta Maior",
		emoji = "🧺",
		desc = "+10 de espaço na cesta antes de voltar para casa",
		max = 10,
		baseCost = 120,
		growth = 1.75,
	},
	Esteira = {
		id = "Esteira",
		name = "Esteira Turbo",
		emoji = "🏃",
		desc = "Treina muito mais rápido na esteira",
		max = 4,
		baseCost = 200,
		growth = 2.6,
	},
	Pulo = {
		id = "Pulo",
		name = "Botas de Pulo",
		emoji = "🦘",
		desc = "Nv 1: pulo duplo • Nv 2: pulo triplo • depois: pulo mais alto",
		max = 5,
		baseCost = 300,
		growth = 2.2,
	},
}

-- Equipamentos aparecem no boneco; melhorias da fazenda não.
Upgrades.equipment = { "Velocidade", "Pulo", "Rede", "Cesta" }
Upgrades.farm = { "Esteira", "Sorte", "Fazenda" }
Upgrades.order = { "Esteira", "Sorte", "Fazenda", "Velocidade", "Pulo", "Rede", "Cesta" }

function Upgrades.cost(id: string, level: number): number
	local def = Upgrades.byId[id]
	return math.floor(def.baseCost * def.growth ^ level)
end

return Upgrades
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

function Format.number(value: number): string
	local n = math.floor(value)
	if n < 1000 then
		return tostring(n)
	end
	local index = 1
	local scaled = n
	while scaled >= 1000 and index < #SUFFIXES do
		scaled /= 1000
		index += 1
	end
	local pattern = if scaled < 10 then "%.2f%s" elseif scaled < 100 then "%.1f%s" else "%.0f%s"
	return string.format(pattern, scaled, SUFFIXES[index])
end

function Format.rate(value: number): string
	if value < 10 and value % 1 ~= 0 then
		return string.format("%.1f", value)
	end
	return Format.number(value)
end

function Format.time(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	if s >= 3600 then
		return string.format("%dh %02dm", s // 3600, (s % 3600) // 60)
	end
	return string.format("%d:%02d", s // 60, s % 60)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DEFINITIONS = {
	Request = "RemoteFunction",
	Notify = "RemoteEvent",
	Profile = "RemoteEvent",
	Effect = "RemoteEvent",
	Bater = "RemoteEvent",
}

local folder: Folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder
	if not folder then
		local created = Instance.new("Folder")
		created.Name = "Remotes"
		folder = created
	end
	for name, className in DEFINITIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

local Remotes = {}

function Remotes.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Style</string><ProtectedString name="Source"><![CDATA[-- Visual "de brinquedo" dos simuladores de Roblox: plástico com pecinhas (studs) e cores vivas.
local Style = {}

-- Materiais realistas que viram plástico. Neon, vidro, água e plástico liso ficam como estão.
local TOY: { [Enum.Material]: boolean } = {
	[Enum.Material.Grass] = true,
	[Enum.Material.LeafyGrass] = true,
	[Enum.Material.Ground] = true,
	[Enum.Material.Mud] = true,
	[Enum.Material.Sand] = true,
	[Enum.Material.Cobblestone] = true,
	[Enum.Material.Slate] = true,
	[Enum.Material.Wood] = true,
	[Enum.Material.WoodPlanks] = true,
	[Enum.Material.Fabric] = true,
}

local function vivid(color: Color3): Color3
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, math.min(1, s * 1.2), math.min(1, v * 1.08))
end

-- Pecinhas em todas as faces (paredes, troncos, laterais), não só no topo:
-- é isso que dá o visual "LEGO" dos simuladores.
function Style.studs(part: BasePart)
	part.TopSurface = Enum.SurfaceType.Studs
	part.FrontSurface = Enum.SurfaceType.Studs
	part.BackSurface = Enum.SurfaceType.Studs
	part.LeftSurface = Enum.SurfaceType.Studs
	part.RightSurface = Enum.SurfaceType.Studs
	part.BottomSurface = Enum.SurfaceType.Inlet
end

function Style.toy(part: BasePart)
	local isBlock = part:IsA("WedgePart") or (part:IsA("Part") and part.Shape == Enum.PartType.Block)
	if TOY[part.Material] then
		part.Material = Enum.Material.Plastic
		part.Color = vivid(part.Color)
	end
	if isBlock and part.Material == Enum.Material.Plastic then
		Style.studs(part)
	end
end

-- Cor um pouco mais clara ou escura, para montar objetos em dois tons.
function Style.shade(color: Color3, amount: number): Color3
	if amount >= 0 then
		return color:Lerp(Color3.new(1, 1, 1), amount)
	end
	return color:Lerp(Color3.new(0, 0, 0), -amount)
end

function Style.apply(root: Instance)
	if root:IsA("BasePart") then
		Style.toy(root)
	end
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			Style.toy(descendant)
		end
	end
end

-- Contorno preto grosso nos textos, igual aos títulos dos simuladores.
function Style.outline(label: TextLabel | TextButton, thickness: number?)
	label.TextStrokeTransparency = 1
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = thickness or 3
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	return stroke
end

return Style
]]></ProtectedString></Properties></Item></Item></Item>
<Item class="ServerScriptService" referent="RBX00000023"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000022"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")

local Services = script.Services
local ActionService = require(Services.ActionService)
local Basket = require(Services.Basket)
local BossService = require(Services.BossService)
local BoostService = require(Services.BoostService)
local DataService = require(Services.DataService)
local EquipmentService = require(Services.EquipmentService)
local FarmService = require(Services.FarmService)
local GuardianService = require(Services.GuardianService)
local MapBuilder = require(Services.MapBuilder)
local Notify = require(Services.Notify)
local PassService = require(Services.PassService)
local RouteService = require(Services.RouteService)
local MissionService = require(Services.MissionService)
local TrainingService = require(Services.TrainingService)
local TreasureService = require(Services.TreasureService)

local map = MapBuilder.build()
DataService.init()
PassService.init()
FarmService.init(map.plots)
RouteService.init(map.zones, map.portals)
GuardianService.init(map.zones)
BoostService.init(map.zones)
GuardianService.onKnockout = function(zone, position, def)
	BoostService.dropFood(zone, position, def.food)
end
BossService.init(map.zones)
GuardianService.beforeHit = BossService.hit
EquipmentService.init()
TreasureService.init(map.zones)
TrainingService.init(map.plots)
MissionService.init()
ActionService.init()

PassService.onGranted(function(player)
	DataService.push(player)
end)

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		FarmService.onCharacter(player, character)
	end)

	local profile, isNew, loaded = DataService.load(player)
	if not profile then
		return
	end
	PassService.load(player)
	if not player.Parent or not DataService.get(player) then
		return
	end
	FarmService.applyOfflineEarnings(player)
	FarmService.assignPlot(player)
	Basket.setup(player)
	EquipmentService.refresh(player)
	TrainingService.setup(player)
	MissionService.setup(player)
	if isNew then
		FarmService.giveStarter(player)
	end
	DataService.push(player)

	if player.Character then
		task.spawn(FarmService.onCharacter, player, player.Character)
	end

	if not loaded then
		Notify.big(
			player,
			"⚠️ Progresso não será salvo",
			"Não foi possível acessar o salvamento agora. Tente entrar de novo mais tarde.",
			Color3.fromRGB(255, 120, 100)
		)
	elseif isNew then
		Notify.big(
			player,
			"Bem-vindo à Fazenda Lendária! 🐔",
			"Entre no portal da Rota do Galinheiro para coletar materiais e achar ninhos",
			Color3.fromRGB(255, 205, 60)
		)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	FarmService.releasePlot(player)
	Basket.release(player)
	DataService.release(player)
end)
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00000021"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">ActionService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Upgrades = require(Shared.Config.Upgrades)

local Basket = require(script.Parent.Basket)
local DataService = require(script.Parent.DataService)
local EquipmentService = require(script.Parent.EquipmentService)
local FarmService = require(script.Parent.FarmService)
local PassService = require(script.Parent.PassService)
local RouteService = require(script.Parent.RouteService)

local ActionService = {}

local RATE_WINDOW = 1
local RATE_LIMIT = 8

type Handler = (Player, string) -> (boolean, any)

local function buyUpgrade(player: Player, upgradeId: string): (boolean, string?)
	local def = Upgrades.byId[upgradeId]
	if not def then
		return false, "Melhoria inválida"
	end
	local profile = DataService.get(player)
	local level = profile.upgrades[upgradeId] or 0
	if level >= def.max then
		return false, "Nível máximo!"
	end
	if not DataService.spendCoins(player, Upgrades.cost(upgradeId, level)) then
		return false, "Moedas insuficientes"
	end
	profile.upgrades[upgradeId] = level + 1
	if upgradeId == "Velocidade" or upgradeId == "Pulo" then
		FarmService.applySpeed(player)
	elseif upgradeId == "Cesta" then
		Basket.refresh(player)
	elseif upgradeId == "Fazenda" then
		FarmService.decorate(player)
	end
	EquipmentService.refresh(player)
	DataService.push(player)
	return true, def.emoji .. " " .. def.name .. " nível " .. (level + 1) .. "!"
end

local HANDLERS: { [string]: Handler } = {
	GetProfile = function(player)
		return true, DataService.get(player)
	end,
	Evolve = FarmService.evolve,
	Sell = FarmService.sell,
	BuyUpgrade = buyUpgrade,
	UnlockRoute = RouteService.unlock,
	Travel = RouteService.travel,
	BuyPass = PassService.prompt,
}

local calls: { [Player]: { start: number, count: number } } = {}

local function allowed(player: Player): boolean
	local now = os.clock()
	local entry = calls[player]
	if not entry or now - entry.start > RATE_WINDOW then
		calls[player] = { start = now, count = 1 }
		return true
	end
	entry.count += 1
	return entry.count <= RATE_LIMIT
end

function ActionService.init()
	Remotes.func("Request").OnServerInvoke = function(player: Player, action: unknown, arg: unknown)
		if type(action) ~= "string" or not HANDLERS[action] then
			return false, "Ação inválida"
		end
		if arg ~= nil and type(arg) ~= "string" then
			return false, "Argumento inválido"
		end
		if not allowed(player) then
			return false, "Calma! Muitas ações ao mesmo tempo"
		end
		if not DataService.get(player) then
			return false, "Carregando seu progresso..."
		end
		local ok, success, result = pcall(HANDLERS[action], player, (arg or "") :: string)
		if not ok then
			warn("[ActionService]", action, success)
			return false, "Erro no servidor"
		end
		return success, result
	end

	Players.PlayerRemoving:Connect(function(player)
		calls[player] = nil
	end)
end

return ActionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Basket</string><ProtectedString name="Source"><![CDATA[-- Cesta: o que o jogador coletou na rota e ainda não levou para casa.
-- Só vira material de verdade (profile.materials) quando ele volta para a fazenda.
-- Não é salva: sair do jogo guarda tudo automaticamente (ver init.server).
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Balance = require(ReplicatedStorage:WaitForChild("Shared").Balance)

local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.Notify)

local Basket = {}

local baskets: { [Player]: { [string]: number } } = {}

local function total(basket: { [string]: number }): number
	local sum = 0
	for _, amount in basket do
		sum += amount
	end
	return sum
end

local function sync(player: Player)
	local basket = baskets[player] or {}
	player:SetAttribute("Cesta", total(basket))
	player:SetAttribute("CestaMax", Basket.capacity(player))
	player:SetAttribute("CestaItens", HttpService:JSONEncode(basket))
end

function Basket.capacity(player: Player): number
	local profile = DataService.get(player)
	return if profile then Balance.basketCapacity(profile) else Balance.BASKET_BASE
end

function Basket.count(player: Player): number
	return total(baskets[player] or {})
end

function Basket.space(player: Player): number
	return math.max(0, Basket.capacity(player) - Basket.count(player))
end

-- Coloca até `amount` itens; devolve quantos couberam.
function Basket.add(player: Player, materialId: string, amount: number): number
	local added = math.min(amount, Basket.space(player))
	if added <= 0 then
		return 0
	end
	local basket = baskets[player] or {}
	baskets[player] = basket
	basket[materialId] = (basket[materialId] or 0) + added
	sync(player)
	return added
end

-- Tira uma fração da cesta (arredondada para cima) e devolve o que saiu.
function Basket.take(player: Player, fraction: number): { [string]: number }
	local basket = baskets[player]
	local removed: { [string]: number } = {}
	if not basket then
		return removed
	end
	local target = math.ceil(total(basket) * fraction)
	local taken = 0
	while taken < target do
		local biggest, most = nil, 0
		for materialId, amount in basket do
			if amount > most then
				biggest, most = materialId, amount
			end
		end
		if not biggest then
			break
		end
		basket[biggest] -= 1
		if basket[biggest] <= 0 then
			basket[biggest] = nil
		end
		removed[biggest] = (removed[biggest] or 0) + 1
		taken += 1
	end
	sync(player)
	return removed
end

-- Passa tudo da cesta para os materiais do jogador. Devolve quantos itens foram guardados.
function Basket.deposit(player: Player, silent: boolean?): number
	local basket = baskets[player]
	local amount = if basket then total(basket) else 0
	if amount == 0 or not DataService.get(player) then
		return 0
	end
	for materialId, count in basket :: { [string]: number } do
		DataService.addMaterial(player, materialId, count)
	end
	baskets[player] = nil
	local profile = DataService.get(player)
	profile.stats.deposited = (profile.stats.deposited or 0) + 1
	sync(player)
	DataService.push(player)
	if not silent then
		Notify.big(
			player,
			"🧺 +" .. amount .. " itens guardados!",
			"Use os itens para EVOLUIR seus animais no botão 🐔 Animais",
			Color3.fromRGB(95, 235, 70),
			"guardar"
		)
	end
	return amount
end

function Basket.setup(player: Player)
	sync(player)
end

-- Recalcula a capacidade (depois de comprar Cesta Maior).
Basket.refresh = sync

function Basket.release(player: Player)
	Basket.deposit(player, true)
	baskets[player] = nil
end

return Basket
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">BoostService</string><ProtectedString name="Source"><![CDATA[-- Boosts: ícones que aparecem nas rotas. Quem encosta ganha um poder por alguns segundos.
-- O fim de cada boost fica num atributo do jogador ("Boost<Id>", em tempo do servidor),
-- que o HUD usa para mostrar a contagem e os outros serviços usam para aplicar o efeito.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Style = require(Shared.Style)

local FarmService = require(script.Parent.FarmService)
local Notify = require(script.Parent.Notify)
local RouteService = require(script.Parent.RouteService)

local BoostService = {}

type BoostDef = { id: string, emoji: string, name: string, seconds: number, color: Color3, weight: number }

BoostService.DEFS = {
	{ id = "Velocidade", emoji = "👟", name = "Supervelocidade", seconds = 10, color = Color3.fromRGB(80, 200, 255), weight = 3 },
	{ id = "Ima", emoji = "🧲", name = "Ímã", seconds = 10, color = Color3.fromRGB(255, 80, 90), weight = 3 },
	{ id = "Escudo", emoji = "🛡️", name = "Escudo", seconds = 12, color = Color3.fromRGB(255, 215, 70), weight = 2 },
} :: { BoostDef }

local PER_ZONE = 3
local RESPAWN_MIN, RESPAWN_MAX = 20, 35
local MAGNET_RADIUS = 16
local MAGNET_TICK = 0.3

local rng = Random.new()

function BoostService.active(player: Player, id: string): boolean
	return (player:GetAttribute("Boost" .. id) or 0) > Workspace:GetServerTimeNow()
end

local function pick(): BoostDef
	local total = 0
	for _, def in BoostService.DEFS do
		total += def.weight
	end
	local roll = rng:NextNumber() * total
	for _, def in BoostService.DEFS do
		roll -= def.weight
		if roll <= 0 then
			return def
		end
	end
	return BoostService.DEFS[1]
end

local function apply(player: Player, def: BoostDef)
	local character = player.Character
	if not character then
		return
	end
	local ends = Workspace:GetServerTimeNow() + def.seconds
	player:SetAttribute("Boost" .. def.id, ends)
	Notify.toast(player, def.emoji .. " " .. def.name .. " por " .. def.seconds .. " segundos!", def.color, "boost")

	if def.id == "Velocidade" then
		FarmService.applySpeed(player)
	elseif def.id == "Escudo" then
		local old = character:FindFirstChild("EscudoBoost")
		if old then
			old:Destroy()
		end
		local field = Instance.new("ForceField")
		field.Name = "EscudoBoost"
		field.Parent = character
	end

	task.delay(def.seconds + 0.05, function()
		if BoostService.active(player, def.id) then
			return -- pegou outro igual no meio do caminho
		end
		if def.id == "Velocidade" then
			FarmService.applySpeed(player)
		elseif def.id == "Escudo" and player.Character then
			local field = player.Character:FindFirstChild("EscudoBoost")
			if field then
				field:Destroy()
			end
		end
	end)
end

-- Ícone flutuante que dá o boost `def` para quem encostar. onTaken roda depois de pegar.
local function buildPickup(parent: Instance, position: Vector3, def: BoostDef, iconText: string, onTaken: () -> ())
	local model = Instance.new("Model")
	model.Name = "Boost" .. def.id
	local core = Instance.new("Part")
	core.Name = "Nucleo"
	core.Size = Vector3.one * 2.2
	core.Material = Enum.Material.Neon
	core.Color = def.color
	core.Transparency = 0.25
	core.Anchored = true
	core.CanCollide = false
	core.CFrame = CFrame.new(position + Vector3.new(0, 3, 0)) * CFrame.Angles(math.rad(45), 0, math.rad(45))
	core.Parent = model
	local base = Instance.new("Part")
	base.Size = Vector3.new(4, 0.4, 4)
	base.Color = Style.shade(def.color, -0.35)
	base.Material = Enum.Material.Plastic
	base.Anchored = true
	base.CanCollide = false
	base.CanTouch = false
	base.CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0))
	base.Parent = model
	Style.studs(base)

	local light = Instance.new("PointLight")
	light.Color = def.color
	light.Range = 12
	light.Brightness = 2
	light.Parent = core
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(def.color)
	sparkles.LightEmission = 1
	sparkles.Rate = 8
	sparkles.Lifetime = NumberRange.new(0.6, 1.2)
	sparkles.Speed = NumberRange.new(1, 2)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new(0.4, 0)
	sparkles.Parent = core

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(4, 4)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	local icon = Instance.new("TextLabel")
	icon.BackgroundTransparency = 1
	icon.Size = UDim2.fromScale(1, 1)
	icon.Text = iconText
	icon.TextScaled = true
	icon.Parent = gui
	gui.Parent = core

	local used = false
	core.Touched:Connect(function(hit)
		if used then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		used = true
		model:Destroy()
		apply(player, def)
		onTaken()
	end)
	model.Parent = parent
	return model
end

local function spawnPickup(zone, randomPoint: () -> Vector3)
	local def = pick()
	buildPickup(zone.nodes.Parent, randomPoint(), def, def.emoji, function()
		task.delay(rng:NextNumber(RESPAWN_MIN, RESPAWN_MAX), spawnPickup, zone, randomPoint)
	end)
end

local FOOD_LIFETIME = 30

-- Comida que o guardião derrubado solta: dá o boost da comida (ex.: 🥓 Bacon = Escudo).
function BoostService.dropFood(zone, position: Vector3, food)
	local def: BoostDef? = nil
	for _, candidate in BoostService.DEFS do
		if candidate.id == food.boost then
			def = candidate
		end
	end
	if not def then
		return
	end
	local model = buildPickup(zone.nodes.Parent, position, def, food.emoji, function() end)
	model.Name = "Comida"
	task.delay(FOOD_LIFETIME, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

function BoostService.init(zones)
	for _, zone in zones do
		local half = zone.size / 2 - 16
		local function randomPoint(): Vector3
			return zone.origin + Vector3.new(rng:NextNumber(-half, half), 0, rng:NextNumber(-half, half))
		end
		for _ = 1, PER_ZONE do
			spawnPickup(zone, randomPoint)
		end
	end

	-- Ímã: puxa os itens comuns em volta de quem está com o boost.
	task.spawn(function()
		while true do
			task.wait(MAGNET_TICK)
			for _, player in Players:GetPlayers() do
				if BoostService.active(player, "Ima") then
					local character = player.Character
					local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root then
						RouteService.pull(player, root.Position, MAGNET_RADIUS)
					end
				end
			end
		end
	end)
end

return BoostService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">BossService</string><ProtectedString name="Source"><![CDATA[-- ⚔️ Chefões: de tempos em tempos um bicho gigante (Galo Rei, Porco Rei…) aparece numa rota
-- onde tem gente. Todo mundo bate nele com 👊; ele persegue devagar e pisoteia o chão.
-- Quem ajudou ganha moedas, um ovo com muita sorte e comidas de poder.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AnimalModel = require(Shared.AnimalModel)
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Guardians = require(Shared.Config.Guardians)
local Rarities = require(Shared.Config.Rarities)
local Remotes = require(Shared.Remotes)
local Routes = require(Shared.Config.Routes)
local Style = require(Shared.Style)

local BoostService = require(script.Parent.BoostService)
local DataService = require(script.Parent.DataService)
local FarmService = require(script.Parent.FarmService)
local Notify = require(script.Parent.Notify)

local BossService = {}

local FIRST_DELAY = 3 * 60
local INTERVAL_MIN, INTERVAL_MAX = 4 * 60, 6 * 60
local TIME_LIMIT = 90
local BASE_HP = 12
local HP_PER_EXTRA_PLAYER = 6
local MODEL_SCALE = 3.2
local HIT_RANGE = 16
local HIT_COOLDOWN = 0.6
local SPEED_FACTOR = 0.55 -- em relação ao guardião da rota
local STOMP_EVERY = 5
local STOMP_WINDUP = 1
local STOMP_RADIUS = 16
local EGG_LUCK = 10
local COINS_PER_ROUTE = 300
local FOOD_DROPS = 5
local KING = Color3.fromRGB(255, 200, 40)

type Boss = {
	routeId: string,
	zone: any,
	def: any,
	model: Model,
	root: BasePart,
	hp: number,
	maxHp: number,
	ends: number,
	nextStomp: number,
	windupEnds: number,
	bar: Frame,
	hpText: TextLabel,
	warning: BillboardGui,
	helpers: { [Player]: boolean },
}

local zones = {}
local current: Boss? = nil
local lastHit: { [Player]: number } = {}
local rng = Random.new()
local EffectRemote: RemoteEvent

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function inZone(zone, position: Vector3): boolean
	local offset = position - zone.origin
	local half = zone.size / 2
	return math.abs(offset.X) <= half and math.abs(offset.Z) <= half
end

local function inSafe(zone, position: Vector3): boolean
	return (flat(position) - flat(zone.safeCenter)).Magnitude <= zone.safeRadius + 2
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function playersIn(zone): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root and inZone(zone, root.Position) then
			table.insert(list, player)
		end
	end
	return list
end

local function kingName(routeId: string): string
	local def = Guardians.byRoute[routeId]
	return (string.gsub(def.name, " Bravo", "")):gsub(" Selvagem", "") .. " Rei"
end

local function healthBar(root: BasePart, title: string): (Frame, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Vida"
	gui.Size = UDim2.fromOffset(360, 80)
	gui.StudsOffset = Vector3.new(0, 30, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 400
	gui.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.new(1, 0, 0, 40)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.Text = "👑 " .. string.upper(title)
	name.TextColor3 = KING
	Style.outline(name, 3)
	name.Parent = gui
	local back = Instance.new("Frame")
	back.BackgroundColor3 = Color3.fromRGB(30, 10, 10)
	back.Position = UDim2.fromOffset(0, 44)
	back.Size = UDim2.new(1, 0, 0, 30)
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 12)
	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.fromRGB(235, 60, 60)
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 12)
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.ZIndex = 2
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	Style.outline(text, 2)
	text.Parent = back
	gui.Parent = root
	return fill, text
end

local function warningSign(root: BasePart): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(10, 10)
	gui.StudsOffset = Vector3.new(0, 22, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = "⚠️"
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = root
	return gui
end

local function updateBar(boss: Boss)
	boss.hpText.Text = "❤️ " .. boss.hp .. " / " .. boss.maxHp
	TweenService:Create(boss.bar, TweenInfo.new(0.2), { Size = UDim2.fromScale(boss.hp / boss.maxHp, 1) }):Play()
end

local function despawn(boss: Boss)
	if current == boss then
		current = nil
	end
	Workspace:SetAttribute("ChefeRota", nil)
	Workspace:SetAttribute("ChefeNome", nil)
	boss.model:Destroy()
end

-- Onda de choque no chão (anel que cresce e some).
local function shockwave(at: Vector3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 4, 4)
	ring.Color = KING
	ring.Material = Enum.Material.Neon
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CFrame = CFrame.new(Vector3.new(at.X, 0.3, at.Z)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = Workspace
	local size = STOMP_RADIUS * 2
	TweenService:Create(ring, TweenInfo.new(0.4), { Size = Vector3.new(0.3, size, size), Transparency = 1 }):Play()
	task.delay(0.5, function()
		ring:Destroy()
	end)
end

local function stomp(boss: Boss)
	local center = boss.root.Position
	shockwave(center)
	for _, player in playersIn(boss.zone) do
		local root = rootOf(player)
		local shielded = (player:GetAttribute("BoostEscudo") or 0) > Workspace:GetServerTimeNow()
		if root and not shielded and (flat(root.Position) - flat(center)).Magnitude <= STOMP_RADIUS then
			-- Só empurra e deixa tonto: chefão é para ser divertido, não para roubar a cesta.
			EffectRemote:FireClient(player, { kind = "knock", from = center })
		end
	end
end

local function reward(boss: Boss)
	local index = table.find(Routes.order, boss.routeId) or 1
	local coins = COINS_PER_ROUTE * index
	local names = {}
	for player in boss.helpers do
		local profile = DataService.get(player)
		if profile and player.Parent then
			table.insert(names, player.DisplayName)
			DataService.addCoins(player, coins)
			profile.stats.bosses = (profile.stats.bosses or 0) + 1
			local route = Routes.byId[boss.routeId]
			local luck = Balance.luck(profile, false, false) * EGG_LUCK
			local rarity = Balance.rollRarity(luck, rng)
			local shiny = Balance.rollShiny(luck, rng)
			local animal = FarmService.addAnimal(player, route.species, rarity, shiny)
			local shown = animal or { id = "", species = route.species, rarity = rarity, shiny = shiny }
			Notify.reveal(player, {
				title = "👑 OVO DO REI!",
				name = Balance.animalName(shown),
				color = Rarities.list[rarity].color,
				sub = "Você ajudou a derrotar o " .. kingName(boss.routeId) .. "! +💰 " .. Format.number(coins),
			})
			DataService.push(player)
		end
	end
	for i = 1, FOOD_DROPS do
		local angle = (i / FOOD_DROPS) * math.pi * 2
		local at = boss.root.Position + Vector3.new(math.cos(angle) * 8, 0, math.sin(angle) * 8)
		BoostService.dropFood(boss.zone, Vector3.new(at.X, 0, at.Z), boss.def.food)
	end
	Notify.bigAll("⚔️ " .. kingName(boss.routeId) .. " DERROTADO!", "Heróis: " .. table.concat(names, ", "), KING)
end

-- Golpe do jogador no chefão. Devolve true se acertou (aí o golpe não vai para os guardiões).
function BossService.hit(player: Player): boolean
	local boss = current
	local root = rootOf(player)
	if not boss or not root then
		return false
	end
	local distance = (flat(boss.root.Position) - flat(root.Position)).Magnitude
	if distance > HIT_RANGE then
		return false
	end
	local now = os.clock()
	if lastHit[player] and now - lastHit[player] < HIT_COOLDOWN then
		return true
	end
	lastHit[player] = now
	boss.helpers[player] = true
	boss.hp -= 1
	EffectRemote:FireClient(player, { kind = "pow", at = boss.root.Position + Vector3.new(0, 6, 0) })
	updateBar(boss)
	if boss.hp <= 0 then
		reward(boss)
		despawn(boss)
	end
	return true
end

local function spawnBoss(routeId: string)
	local zone = zones[routeId]
	local def = Guardians.byRoute[routeId]
	local here = playersIn(zone)
	local name = kingName(routeId)
	local model = AnimalModel.build(def.species, Rarities.LEGENDARY, false, name)
	model.Name = "Chefe"
	model:ScaleTo(MODEL_SCALE)
	local root = model.PrimaryPart :: BasePart
	local tag = root:FindFirstChild("Tag")
	if tag then
		tag:Destroy()
	end
	local start = zone.origin + Vector3.new(0, 0, -40)
	model:PivotTo(CFrame.new(start))
	model.Parent = zone.nodes.Parent

	local maxHp = BASE_HP + HP_PER_EXTRA_PLAYER * math.max(0, #here - 1)
	local bar, hpText = healthBar(root, name)
	local boss: Boss = {
		routeId = routeId,
		zone = zone,
		def = def,
		model = model,
		root = root,
		hp = maxHp,
		maxHp = maxHp,
		ends = os.clock() + TIME_LIMIT,
		nextStomp = os.clock() + STOMP_EVERY,
		windupEnds = 0,
		bar = bar,
		hpText = hpText,
		warning = warningSign(root),
		helpers = {},
	}
	updateBar(boss)
	current = boss
	Workspace:SetAttribute("ChefeRota", routeId)
	Workspace:SetAttribute("ChefeNome", name)
	Notify.bigAll(
		"⚔️ CHEFÃO: " .. string.upper(name) .. "!",
		"Apareceu na " .. Routes.byId[routeId].name .. ". Bata nele com 👊 junto com todo mundo!",
		KING,
		"galo"
	)
end

local function step(boss: Boss, dt: number, now: number)
	if now > boss.ends then
		Notify.bigAll("💨 O " .. kingName(boss.routeId) .. " fugiu!", "Fique atento: outro chefão aparece daqui a pouco", KING)
		despawn(boss)
		return
	end
	local position = boss.root.Position
	-- Pisão: avisa (⚠️ e pulinho alto), depois bate no chão.
	if boss.windupEnds > 0 then
		local hop = math.sin(math.clamp(1 - (boss.windupEnds - now) / STOMP_WINDUP, 0, 1) * math.pi) * 6
		boss.root.CFrame = CFrame.new(position.X, hop, position.Z) * boss.root.CFrame.Rotation
		if now >= boss.windupEnds then
			boss.windupEnds = 0
			boss.warning.Enabled = false
			boss.root.CFrame = CFrame.new(position.X, 0, position.Z) * boss.root.CFrame.Rotation
			stomp(boss)
			boss.nextStomp = now + STOMP_EVERY
		end
		return
	end
	if now >= boss.nextStomp then
		boss.windupEnds = now + STOMP_WINDUP
		boss.warning.Enabled = true
		return
	end
	-- Anda devagar atrás do jogador mais perto (fora da zona segura).
	local target: BasePart? = nil
	local best = math.huge
	for _, player in playersIn(boss.zone) do
		local root = rootOf(player)
		if root and not inSafe(boss.zone, root.Position) then
			local distance = (flat(root.Position) - flat(position)).Magnitude
			if distance < best then
				target, best = root, distance
			end
		end
	end
	if not target or best < 6 then
		return
	end
	local direction = (flat((target :: BasePart).Position) - flat(position)).Unit
	local moved = flat(position) + direction * boss.def.speed * SPEED_FACTOR * dt
	if inSafe(boss.zone, moved) then
		return
	end
	local hop = math.abs(math.sin(now * 5)) * 0.8
	local at = Vector3.new(moved.X, hop, moved.Z)
	boss.root.CFrame = CFrame.lookAt(at, at + direction)
end

local function tryStart()
	if current then
		return
	end
	local candidates = {}
	for _, routeId in Routes.order do
		local zone = zones[routeId]
		if zone and #playersIn(zone) > 0 then
			table.insert(candidates, routeId)
		end
	end
	if #candidates > 0 then
		spawnBoss(candidates[rng:NextInteger(1, #candidates)])
	end
end

function BossService.init(zoneMap)
	zones = zoneMap
	EffectRemote = Remotes.event("Effect")

	RunService.Heartbeat:Connect(function(dt)
		local boss = current
		if boss then
			step(boss, dt, os.clock())
		end
	end)

	task.spawn(function()
		task.wait(FIRST_DELAY)
		while true do
			tryStart()
			-- Sem ninguém nas rotas, tenta de novo logo; senão espera o intervalo.
			task.wait(if current then rng:NextNumber(INTERVAL_MIN, INTERVAL_MAX) else 20)
		end
	end)

	-- Só no Studio: marcar Workspace.ForcarChefe = true chama um chefão na hora (para testar).
	if RunService:IsStudio() then
		Workspace:GetAttributeChangedSignal("ForcarChefe"):Connect(function()
			if Workspace:GetAttribute("ForcarChefe") then
				Workspace:SetAttribute("ForcarChefe", nil)
				tryStart()
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastHit[player] = nil
		if current then
			current.helpers[player] = nil
		end
	end)
end

return BossService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local DataService = {}

local STORE_NAME = "FazendaLendaria_v1"
local AUTOSAVE_SECONDS = 60
local MAX_ATTEMPTS = 3

local ProfileRemote = Remotes.event("Profile")

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponível:", result)
	end
end

local profiles: { [Player]: any } = {}
local canSave: { [Player]: boolean } = {}
local pendingPush: { [Player]: boolean } = {}

local function template()
	return {
		version = 1,
		coins = 0,
		materials = {},
		animals = {},
		nextAnimalId = 1,
		upgrades = { Sorte = 0, Fazenda = 0, Velocidade = 0, Pulo = 0, Rede = 0, Cesta = 0, Esteira = 0 },
		training = 0,
		mission = { index = 1, base = 0 },
		routes = { Galinheiro = true },
		index = {},
		stats = { legendaries = 0, nests = 0, collected = 0, deposited = 0, evolved = 0, chests = 0, knockouts = 0, bosses = 0 },
		lastOnline = 0,
	}
end

local function reconcile(target, defaults)
	for key, value in defaults do
		if target[key] == nil then
			target[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function createLeaderstats(player: Player, profile)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local coins = Instance.new("NumberValue")
	coins.Name = "Moedas"
	coins.Value = math.floor(profile.coins)
	coins.Parent = folder
	local legendaries = Instance.new("IntValue")
	legendaries.Name = "Lendários"
	legendaries.Value = profile.stats.legendaries
	legendaries.Parent = folder
	folder.Parent = player
end

-- Retorna (profile, isNew, loadedFromStore). Se o DataStore falhar, o jogador joga com um perfil
-- temporário que NUNCA é salvo, para não sobrescrever o progresso real.
function DataService.load(player: Player)
	local data = nil
	local loaded = false
	if store then
		for attempt = 1, MAX_ATTEMPTS do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			warn(
				string.format(
					"[DataService] Falha ao carregar %s (tentativa %d): %s",
					player.Name,
					attempt,
					tostring(result)
				)
			)
			if RunService:IsStudio() and string.find(tostring(result), "Studio", 1, true) then
				break
			end
			task.wait(attempt * 2)
		end
	end

	if not player.Parent then
		return nil, false, false
	end

	local isNew = data == nil
	local profile = data or template()
	reconcile(profile, template())
	profiles[player] = profile
	canSave[player] = loaded
	createLeaderstats(player, profile)
	return profile, isNew, loaded
end

function DataService.get(player: Player)
	return profiles[player]
end

function DataService.all(): { [Player]: any }
	return profiles
end

function DataService.save(player: Player)
	local profile = profiles[player]
	if not profile or not canSave[player] or not store then
		return
	end
	profile.lastOnline = os.time()
	for attempt = 1, MAX_ATTEMPTS do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function()
				return profile
			end)
		end)
		if ok then
			return
		end
		warn(string.format("[DataService] Falha ao salvar %s (tentativa %d): %s", player.Name, attempt, tostring(err)))
		task.wait(attempt * 2)
	end
end

function DataService.release(player: Player)
	DataService.save(player)
	profiles[player] = nil
	canSave[player] = nil
	pendingPush[player] = nil
end

-- Agrupa várias mudanças no mesmo frame em um único envio para o cliente.
function DataService.push(player: Player)
	if pendingPush[player] then
		return
	end
	pendingPush[player] = true
	task.defer(function()
		pendingPush[player] = nil
		local profile = profiles[player]
		if profile and player.Parent then
			ProfileRemote:FireClient(player, profile)
		end
	end)
end

local function syncCoins(player: Player, profile)
	local leaderstats = player:FindFirstChild("leaderstats")
	local value = leaderstats and leaderstats:FindFirstChild("Moedas")
	if value then
		(value :: NumberValue).Value = math.floor(profile.coins)
	end
end

function DataService.addCoins(player: Player, amount: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.coins += amount
	syncCoins(player, profile)
end

function DataService.spendCoins(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or profile.coins < amount then
		return false
	end
	profile.coins -= amount
	syncCoins(player, profile)
	return true
end

function DataService.addMaterial(player: Player, materialId: string, amount: number)
	local profile = profiles[player]
	if profile then
		profile.materials[materialId] = (profile.materials[materialId] or 0) + amount
	end
end

function DataService.syncLegendaries(player: Player)
	local profile = profiles[player]
	local leaderstats = player:FindFirstChild("leaderstats")
	local value = leaderstats and leaderstats:FindFirstChild("Lendários")
	if profile and value then
		(value :: IntValue).Value = profile.stats.legendaries
	end
end

function DataService.init()
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local remaining = 0
		for _, player in Players:GetPlayers() do
			if profiles[player] then
				remaining += 1
				task.spawn(function()
					DataService.save(player)
					remaining -= 1
				end)
			end
		end
		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">EquipmentService</string><ProtectedString name="Source"><![CDATA[-- Mostra os equipamentos comprados no boneco (todo mundo vê):
-- 👢 botas nos pés, 🥅 rede na mão e 🧺 cesta nas costas que enche conforme a coleta.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Style = require(Shared.Style)

local DataService = require(script.Parent.DataService)

local EquipmentService = {}

local FOLDER = "Equipamento"
local WICKER = Color3.fromRGB(196, 140, 72)
-- Cor das botas sobe de "tier" a cada 3 níveis: couro, azul, roxo, dourada.
local BOOT_TIERS = {
	Color3.fromRGB(120, 72, 40),
	Color3.fromRGB(60, 140, 235),
	Color3.fromRGB(165, 90, 230),
	Color3.fromRGB(255, 200, 50),
}

local function findPart(character: Model, ...: string): BasePart?
	for _, name in { ... } do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local function attach(folder: Instance, anchor: BasePart, size: Vector3, offset: CFrame, color: Color3, name: string?): Part
	local part = Instance.new("Part")
	part.Name = name or "Peca"
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.Plastic
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.CFrame = anchor.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function boots(folder: Instance, character: Model, level: number)
	local color = BOOT_TIERS[math.clamp(math.ceil(level / 3), 1, #BOOT_TIERS)]
	for _, pair in { { "LeftFoot", "Left Leg" }, { "RightFoot", "Right Leg" } } do
		local foot = findPart(character, pair[1], pair[2])
		if foot then
			local isR6 = foot.Name:find("Leg") ~= nil
			local y = if isR6 then -foot.Size.Y / 2 + 0.35 else 0
			local boot = attach(folder, foot, Vector3.new(foot.Size.X + 0.2, 0.7, foot.Size.Z + 0.3), CFrame.new(0, y, -0.05), color)
			Style.studs(boot)
			attach(folder, foot, Vector3.new(foot.Size.X + 0.25, 0.2, foot.Size.Z + 0.35), CFrame.new(0, y + 0.4, -0.05), Style.shade(color, 0.35))
		end
	end
end

-- Molinhas das Botas de Pulo embaixo de cada pé.
local function springs(folder: Instance, character: Model, level: number)
	local color = if level >= 3 then Color3.fromRGB(255, 200, 50) else Color3.fromRGB(80, 230, 120)
	for _, pair in { { "LeftFoot", "Left Leg" }, { "RightFoot", "Right Leg" } } do
		local foot = findPart(character, pair[1], pair[2])
		if foot then
			local bottom = -foot.Size.Y / 2
			for i = 0, 2 do
				local ring = attach(
					folder,
					foot,
					Vector3.new(0.18, 0.7, 0.7),
					CFrame.new(0, bottom - 0.15 - i * 0.22, 0) * CFrame.Angles(0, 0, math.rad(90)),
					color
				)
				ring.Shape = Enum.PartType.Cylinder
				ring.Material = Enum.Material.Metal
			end
		end
	end
end

local function net(folder: Instance, character: Model, level: number)
	local hand = findPart(character, "RightHand", "Right Arm")
	if not hand then
		return
	end
	local isR6 = hand.Name == "Right Arm"
	local grip = CFrame.new(0, if isR6 then -hand.Size.Y / 2 else 0, 0)
	attach(folder, hand, Vector3.new(0.25, 3.2, 0.25), grip * CFrame.new(0, 0.9, -0.3) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(150, 95, 50))
	local ring = attach(folder, hand, Vector3.new(1.6, 0.2, 1.6), grip * CFrame.new(0, 2.6, -0.9) * CFrame.Angles(math.rad(-20), 0, 0), Color3.fromRGB(235, 235, 235))
	ring.Transparency = 0.35
	-- A rede fica mais colorida conforme o nível.
	ring.Color = if level >= 6 then Color3.fromRGB(255, 205, 60) elseif level >= 3 then Color3.fromRGB(120, 210, 255) else ring.Color
end

local function basket(folder: Instance, character: Model, level: number, fill: number)
	local torso = findPart(character, "UpperTorso", "Torso")
	if not torso then
		return
	end
	local grow = 1 + 0.05 * level
	local depth = torso.Size.Z / 2
	local body = attach(folder, torso, Vector3.new(1.8, 1.8, 1.2) * grow, CFrame.new(0, -0.1, depth + 0.6 * grow), WICKER, "Cesta")
	Style.studs(body)
	attach(folder, torso, Vector3.new(1.95, 0.25, 1.35) * grow, CFrame.new(0, 0.85 * grow - 0.1, depth + 0.6 * grow), Style.shade(WICKER, -0.25))
	-- Alças.
	for _, x in { -0.55, 0.55 } do
		attach(folder, torso, Vector3.new(0.2, torso.Size.Y * 0.9, 0.12), CFrame.new(x, 0, depth + 0.05), Style.shade(WICKER, -0.35))
	end
	-- O "recheio" sobe conforme a cesta enche.
	if fill > 0 then
		local height = math.max(0.15, 1.6 * grow * math.min(fill, 1))
		attach(
			folder,
			torso,
			Vector3.new(1.5, height, 0.9) * Vector3.new(grow, 1, grow),
			CFrame.new(0, -0.1 - 0.9 * grow + height / 2 + 0.05, depth + 0.6 * grow),
			Color3.fromRGB(255, 205, 60),
			"Recheio"
		)
	end
end

function EquipmentService.refresh(player: Player)
	local character = player.Character
	local profile = DataService.get(player)
	if not character or not profile then
		return
	end
	local old = character:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Model")
	folder.Name = FOLDER

	local upgrades = profile.upgrades
	if (upgrades.Velocidade or 0) > 0 then
		boots(folder, character, upgrades.Velocidade)
	end
	if (upgrades.Pulo or 0) > 0 then
		springs(folder, character, upgrades.Pulo)
	end
	if (upgrades.Rede or 0) > 0 then
		net(folder, character, upgrades.Rede)
	end
	local count = player:GetAttribute("Cesta") or 0
	local max = player:GetAttribute("CestaMax") or 1
	if (upgrades.Cesta or 0) > 0 or count > 0 then
		basket(folder, character, upgrades.Cesta or 0, count / math.max(max, 1))
	end
	folder.Parent = character
end

function EquipmentService.init()
	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			task.wait(0.5)
			EquipmentService.refresh(player)
		end)
		player:GetAttributeChangedSignal("Cesta"):Connect(function()
			EquipmentService.refresh(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

return EquipmentService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">FarmService</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AnimalModel = require(Shared.AnimalModel)
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Rarities = require(Shared.Config.Rarities)
local Species = require(Shared.Config.Species)
local Style = require(Shared.Style)

local Basket = require(script.Parent.Basket)
local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.Notify)
local PassService = require(script.Parent.PassService)
local Teleport = require(script.Parent.Teleport)

local FarmService = {}

local BOUNDS = { minX = -30, maxX = 30, minZ = -29, maxZ = 13 }
local WALK_SPEED = 5
local HUB_SPAWN = CFrame.new(0, 3, 14)
local GOLD = Color3.fromRGB(255, 205, 60)

local plots = {}
local plotOf: { [Player]: any } = {}
local modelsOf: { [Player]: { [string]: Model } } = {}
local rng = Random.new()

local function randomSpot(plot): CFrame
	local x = rng:NextNumber(BOUNDS.minX, BOUNDS.maxX)
	local z = rng:NextNumber(BOUNDS.minZ, BOUNDS.maxZ)
	return plot.cframe * CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
end

local function wander(model: Model, plot)
	local root = model.PrimaryPart :: BasePart
	while model.Parent do
		task.wait(rng:NextNumber(2, 6))
		if not model.Parent then
			break
		end
		local from = root.Position
		local target = randomSpot(plot).Position
		local flat = Vector3.new(target.X, from.Y, target.Z)
		local distance = (flat - from).Magnitude
		if distance > 1 then
			local facing = CFrame.lookAt(from, flat)
			TweenService:Create(root, TweenInfo.new(0.3), { CFrame = facing }):Play()
			task.wait(0.3)
			local duration = distance / WALK_SPEED
			TweenService
				:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = facing + (flat - from) })
				:Play()
			task.wait(duration)
		end
	end
end

local function spawnModel(player: Player, animal)
	local plot = plotOf[player]
	local models = modelsOf[player]
	if not plot or not models then
		return
	end
	local previous = models[animal.id]
	local spot = if previous then previous:GetPivot() else randomSpot(plot)
	if previous then
		previous:Destroy()
	end
	local model = AnimalModel.build(animal.species, animal.rarity, animal.shiny, Balance.animalName(animal))
	model:PivotTo(spot)
	model.Parent = plot.animals
	models[animal.id] = model
	task.spawn(wander, model, plot)
end

local function despawnModel(player: Player, animalId: string)
	local models = modelsOf[player]
	if models and models[animalId] then
		models[animalId]:Destroy()
		models[animalId] = nil
	end
end

local function findAnimal(profile, animalId: string): (any, number?)
	for i, animal in profile.animals do
		if animal.id == animalId then
			return animal, i
		end
	end
	return nil, nil
end

local function registerDiscovery(player: Player, profile, animal)
	profile.index[animal.species .. ":" .. animal.rarity] = true
	if animal.rarity >= Rarities.LEGENDARY then
		profile.stats.legendaries += 1
		DataService.syncLegendaries(player)
		local species = Species.byId[animal.species]
		local article = if species.feminine then "uma" else "um"
		Notify.bigAll(
			"🌟 " .. player.DisplayName .. " conseguiu " .. article .. " " .. Balance.animalName(animal) .. "!",
			nil,
			Rarities.list[animal.rarity].color
		)
	end
end

function FarmService.assignPlot(player: Player)
	local profile = DataService.get(player)
	for _, plot in plots do
		if not plot.owner then
			plot.owner = player
			plot.sign.Text = "Fazenda de " .. player.DisplayName
			plotOf[player] = plot
			modelsOf[player] = {}
			for _, animal in profile.animals do
				spawnModel(player, animal)
			end
			FarmService.decorate(player)
			return plot
		end
	end
	warn("[FarmService] Sem lotes livres para", player.Name, "- aumente PLOT_COUNT ou reduza o máximo de jogadores")
	return nil
end

-- Enfeites da fazenda que aparecem conforme o nível de "Fazenda Maior".
local DECOR_LEVELS = { silo = 1, flores = 3, postes = 5, moinho = 8, cataVento = 12 }

local function decorPart(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Plastic
	if shape then
		part.Shape = shape
	end
	part.Parent = parent
	return part
end

function FarmService.decorate(player: Player)
	local plot = plotOf[player]
	local profile = DataService.get(player)
	if not plot or not profile then
		return
	end
	local level = profile.upgrades.Fazenda or 0
	plot.sign.Text = "🏡 Fazenda de " .. player.DisplayName .. " • Nv " .. level
	local plotModel = plot.animals.Parent :: Instance
	local old = plotModel:FindFirstChild("Melhorias")
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "Melhorias"
	local at = plot.cframe

	if level >= DECOR_LEVELS.silo then
		local silo = at * CFrame.new(25, 0, 6)
		decorPart(model, Vector3.new(14, 7, 7), silo * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(200, 50, 45), nil, Enum.PartType.Cylinder)
		decorPart(model, Vector3.new(1, 7.2, 7.2), silo * CFrame.new(0, 10, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.new(1, 1, 1), nil, Enum.PartType.Cylinder)
		decorPart(model, Vector3.one * 7, silo * CFrame.new(0, 14, 0), Color3.fromRGB(190, 195, 205), Enum.Material.Metal, Enum.PartType.Ball)
	end
	if level >= DECOR_LEVELS.flores then
		local colors = { Color3.fromRGB(255, 90, 170), Color3.fromRGB(255, 225, 60), Color3.fromRGB(170, 110, 255) }
		for _, x in { -9, 9 } do
			local bed = at * CFrame.new(x, 0, -24)
			decorPart(model, Vector3.new(6, 0.8, 3), bed * CFrame.new(0, 0.4, 0), Color3.fromRGB(120, 75, 40), Enum.Material.WoodPlanks)
			for i = 1, 4 do
				decorPart(model, Vector3.new(0.9, 0.9, 0.9), bed * CFrame.new(-2.25 + i * 0.9, 1.2, (i % 2) * 0.6 - 0.3), colors[(i % #colors) + 1])
			end
		end
	end
	if level >= DECOR_LEVELS.postes then
		for _, x in { -31, 31 } do
			for _, z in { -31, 31 } do
				local post = at * CFrame.new(x, 0, z)
				decorPart(model, Vector3.new(0.7, 8, 0.7), post * CFrame.new(0, 4, 0), Color3.fromRGB(50, 50, 60), Enum.Material.Metal)
				local lamp = decorPart(model, Vector3.new(1.6, 1.4, 1.6), post * CFrame.new(0, 8.6, 0), Color3.fromRGB(255, 230, 140), Enum.Material.Neon)
				local light = Instance.new("PointLight")
				light.Color = Color3.fromRGB(255, 220, 150)
				light.Range = 18
				light.Brightness = 1.5
				light.Parent = lamp
			end
		end
	end
	if level >= DECOR_LEVELS.moinho then
		local mill = at * CFrame.new(-25, 0, 6)
		decorPart(model, Vector3.new(5, 14, 5), mill * CFrame.new(0, 7, 0), Color3.fromRGB(245, 240, 230), Enum.Material.WoodPlanks)
		decorPart(model, Vector3.new(6, 3, 6), mill * CFrame.new(0, 15.5, 0), Color3.fromRGB(200, 50, 45), Enum.Material.WoodPlanks)
		for i = 0, 3 do
			decorPart(model, Vector3.new(1.2, 9, 0.3), mill * CFrame.new(0, 12, -2.8) * CFrame.Angles(0, 0, math.rad(i * 90 + 20)) * CFrame.new(0, 4.5, 0), Color3.fromRGB(235, 225, 200), Enum.Material.WoodPlanks)
		end
	end
	if level >= DECOR_LEVELS.cataVento then
		local top = at * CFrame.new(0, 14.5, 24)
		decorPart(model, Vector3.new(0.3, 3, 0.3), top * CFrame.new(0, 1.5, 0), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		decorPart(model, Vector3.new(3, 0.5, 0.3), top * CFrame.new(0, 2.6, 0), Color3.fromRGB(255, 200, 40), Enum.Material.Metal)
		decorPart(model, Vector3.one * 0.9, top * CFrame.new(0, 3.3, 0), Color3.fromRGB(255, 215, 80), Enum.Material.Neon, Enum.PartType.Ball)
	end

	Style.apply(model)
	model.Parent = plotModel
end

function FarmService.releasePlot(player: Player)
	local plot = plotOf[player]
	if plot then
		plot.owner = nil
		plot.sign.Text = "Fazenda livre"
		plot.animals:ClearAllChildren()
		local decorations = (plot.animals.Parent :: Instance):FindFirstChild("Melhorias")
		if decorations then
			decorations:Destroy()
		end
	end
	plotOf[player] = nil
	modelsOf[player] = nil
end

function FarmService.teleportHome(player: Player): (boolean, string?)
	local plot = plotOf[player]
	Teleport.to(player, if plot then plot.spawn else HUB_SPAWN)
	-- Chegou em casa: o que estava na cesta fica guardado de vez.
	Basket.deposit(player)
	return true, nil
end

function FarmService.applySpeed(player: Player)
	local profile = DataService.get(player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if profile and humanoid then
		local boosted = (player:GetAttribute("BoostVelocidade") or 0) > Workspace:GetServerTimeNow()
		humanoid.WalkSpeed = Balance.walkSpeed(profile) + (if boosted then Balance.BOOST_SPEED else 0)
		humanoid.UseJumpPower = false
		humanoid.JumpHeight = Balance.jumpHeight(profile)
	end
end

function FarmService.onCharacter(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	if not DataService.get(player) or player.Character ~= character then
		return
	end
	task.wait()
	FarmService.applySpeed(player)
	FarmService.teleportHome(player)
end

function FarmService.addAnimal(player: Player, speciesId: string, rarity: number, shiny: boolean): (any, number?)
	local profile = DataService.get(player)
	if not profile then
		return nil, nil
	end
	local animal = { id = "a" .. profile.nextAnimalId, species = speciesId, rarity = rarity, shiny = shiny }
	profile.nextAnimalId += 1
	registerDiscovery(player, profile, animal)

	local capacity = Balance.capacity(profile, PassService.has(player, "FazendaGigante"))
	if #profile.animals >= capacity then
		local value = Balance.sellPrice(animal)
		DataService.addCoins(player, value)
		DataService.push(player)
		return nil, value
	end

	table.insert(profile.animals, animal)
	spawnModel(player, animal)
	DataService.push(player)
	return animal, nil
end

function FarmService.evolve(player: Player, animalId: string): (boolean, string?)
	local profile = DataService.get(player)
	local animal = findAnimal(profile, animalId)
	if not animal then
		return false, "Animal não encontrado"
	end
	if animal.rarity >= Rarities.MAX then
		return false, "Esse animal já está no máximo!"
	end
	local cost = Balance.evolveCost(animal.species, animal.rarity)
	if not cost then
		return false, "Não dá para evoluir"
	end
	local ok, reason = Balance.missingForCost(profile, profile.coins, cost)
	if not ok then
		return false, reason
	end

	DataService.spendCoins(player, cost.coins)
	for materialId, amount in cost.materials do
		profile.materials[materialId] -= amount
	end
	animal.rarity += 1
	profile.stats.evolved = (profile.stats.evolved or 0) + 1
	registerDiscovery(player, profile, animal)
	spawnModel(player, animal)
	DataService.push(player)

	Notify.reveal(player, {
		title = "⬆️ EVOLUIU!",
		name = Balance.animalName(animal),
		color = Rarities.list[animal.rarity].color,
		sub = "Agora produz 💰 " .. Format.rate(Balance.animalProduction(animal)) .. "/s",
	})
	return true, nil
end

function FarmService.sell(player: Player, animalId: string): (boolean, string?)
	local profile = DataService.get(player)
	if #profile.animals <= 1 then
		return false, "Você precisa manter pelo menos 1 animal"
	end
	local animal, index = findAnimal(profile, animalId)
	if not animal or not index then
		return false, "Animal não encontrado"
	end
	table.remove(profile.animals, index)
	local value = Balance.sellPrice(animal)
	DataService.addCoins(player, value)
	despawnModel(player, animalId)
	DataService.push(player)
	return true, "Vendido por 💰 " .. Format.number(value)
end

function FarmService.giveStarter(player: Player)
	FarmService.addAnimal(player, "Galinha", 1, false)
end

function FarmService.applyOfflineEarnings(player: Player)
	local profile = DataService.get(player)
	if not profile or profile.lastOnline <= 0 then
		return
	end
	local amount = Balance.offlineEarnings(profile, os.time() - profile.lastOnline, PassService.has(player, "VIP"))
	if amount > 0 then
		DataService.addCoins(player, amount)
		Notify.welcome(player, amount, os.time() - profile.lastOnline)
	end
end

function FarmService.init(plotList)
	plots = plotList
	task.spawn(function()
		while true do
			task.wait(1)
			for player, profile in DataService.all() do
				local rate = Balance.totalProduction(profile, PassService.has(player, "VIP"))
				if rate > 0 then
					DataService.addCoins(player, rate)
				end
			end
		end
	end)
end

return FarmService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">GuardianService</string><ProtectedString name="Source"><![CDATA[-- Guardiões: bichos bravos que vigiam cada rota. Quando alguém mexe num ninho (ou às vezes
-- num item), o guardião mais perto corre atrás. Se pegar, empurra, deixa tonto e derruba
-- parte da cesta no chão, que o jogador pode pegar de volta.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AnimalModel = require(Shared.AnimalModel)
local Guardians = require(Shared.Config.Guardians)
local Materials = require(Shared.Config.Materials)
local Remotes = require(Shared.Remotes)
local Style = require(Shared.Style)

local Basket = require(script.Parent.Basket)
local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.Notify)

local GuardianService = {}

type Food = { emoji: string, name: string, boost: string }
type Def = { species: string, name: string, emoji: string, speed: number, rarity: number, food: Food }

local DEFS: { [string]: Def } = Guardians.byRoute

local PER_ZONE = 3
local MODEL_SCALE = 1.6
local ALERT_RADIUS = 70
local CATCH_DISTANCE = 4
local NOTICE_SECONDS = 0.8
local CHASE_SECONDS = 7
local CHARGE_SECONDS = 2
local CHARGE_MULT = 1.3
local COOLDOWN = 5
local DROP_FRACTION = 0.3
local DROP_LIFETIME = 45
local WANDER_RADIUS = 22
local WANDER_SPEED = 5
local ANGRY = Color3.fromRGB(255, 70, 60)
-- Bater: alcance, recarga, golpes até desmaiar, tontura curta e desmaio.
local HIT_RANGE = 10
local HIT_COOLDOWN = 0.7
local HITS_TO_KO = 3
local STUN_SECONDS = 2
local KO_SECONDS = 6
local HEAL_AFTER = 15

type Guardian = {
	def: Def,
	routeId: string,
	zone: any,
	model: Model,
	root: BasePart,
	alert: BillboardGui,
	home: Vector3,
	state: string,
	target: Player?,
	chaseEnds: number,
	chargeEnds: number,
	noticeEnds: number,
	cooldownUntil: number,
	wanderTo: Vector3?,
	nextWander: number,
	tag: TextLabel?,
	alertLabel: TextLabel,
	hits: number,
	lastHitAt: number,
	stunnedUntil: number,
	knockedOut: boolean,
}

local guardians: { Guardian } = {}
local chasing: { [Player]: Guardian } = {}
local rng = Random.new()
local EffectRemote: RemoteEvent
local lastHit: { [Player]: number } = {}
local updateTag: (Guardian) -> ()

-- Chamado quando um guardião desmaia (init.server liga no BoostService para soltar a comida).
GuardianService.beforeHit = nil :: ((Player) -> boolean)?
GuardianService.onKnockout = nil :: ((zone: any, position: Vector3, def: Def, player: Player) -> ())?

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function inZone(zone, position: Vector3): boolean
	local offset = position - zone.origin
	local half = zone.size / 2
	return math.abs(offset.X) <= half and math.abs(offset.Z) <= half
end

-- Zona segura (chegada/portal de volta): guardião não entra e desiste de quem estiver lá.
local function inSafe(zone, position: Vector3, margin: number?): boolean
	return (flat(position) - flat(zone.safeCenter)).Magnitude <= zone.safeRadius + (margin or 0)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function stopChase(guardian: Guardian)
	if guardian.target then
		if chasing[guardian.target] == guardian then
			chasing[guardian.target] = nil
			guardian.target:SetAttribute("Perseguido", nil)
		end
	end
	guardian.target = nil
	guardian.state = "return"
	guardian.alert.Enabled = false
end

-- Monta a pilha de itens caídos; só o dono pode pegar de volta.
local function dropPile(owner: Player, zone, position: Vector3, items: { [string]: number })
	local model = Instance.new("Model")
	model.Name = "Cesta caída"
	local base = Instance.new("Part")
	base.Size = Vector3.new(2.6, 0.8, 2.6)
	base.Color = Color3.fromRGB(170, 110, 55)
	base.Material = Enum.Material.WoodPlanks
	base.Anchored = true
	base.CanCollide = false
	base.CFrame = CFrame.new(position.X, 0.4, position.Z)
	base.Parent = model
	local i = 0
	for materialId in items do
		local material = Materials.byId[materialId]
		local cube = Instance.new("Part")
		cube.Size = Vector3.one * 0.8
		cube.Color = if material then material.color else Color3.new(1, 1, 1)
		cube.Material = Enum.Material.SmoothPlastic
		cube.Anchored = true
		cube.CanCollide = false
		cube.CFrame = base.CFrame * CFrame.new((i % 2) * 0.9 - 0.45, 0.8, math.floor(i / 2) * 0.9 - 0.45)
		cube.Parent = model
		i += 1
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 120)
	light.Range = 8
	light.Parent = base
	Style.apply(model)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pegar de volta"
	prompt.ObjectText = "Seus itens"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = base

	local taken = false
	prompt.Triggered:Connect(function(player)
		if taken then
			return
		end
		if player ~= owner then
			Notify.toast(player, "Esses itens são de " .. owner.DisplayName, ANGRY)
			return
		end
		taken = true
		local recovered = 0
		for materialId, amount in items do
			recovered += Basket.add(player, materialId, amount)
		end
		model:Destroy()
		Notify.toast(player, "🧺 Pegou de volta " .. recovered .. " itens!", Color3.fromRGB(95, 235, 70))
	end)
	model.Parent = zone.nodes
	task.delay(DROP_LIFETIME, function()
		if model.Parent then
			model:Destroy()
		end
	end)
end

local function catch(guardian: Guardian, player: Player)
	local root = rootOf(player)
	stopChase(guardian)
	guardian.cooldownUntil = os.clock() + COOLDOWN
	if not root then
		return
	end
	-- Boost de escudo: o guardião bate e desiste, sem derrubar nada.
	if (player:GetAttribute("BoostEscudo") or 0) > Workspace:GetServerTimeNow() then
		Notify.toast(player, "🛡️ O escudo te protegeu do " .. guardian.def.name .. "!", Color3.fromRGB(255, 215, 70))
		return
	end
	EffectRemote:FireClient(player, { kind = "knock", from = guardian.root.Position })
	local dropped = Basket.take(player, DROP_FRACTION)
	local count = 0
	for _, amount in dropped do
		count += amount
	end
	if count > 0 then
		dropPile(player, guardian.zone, root.Position, dropped)
		Notify.toast(player, "💥 O " .. guardian.def.name .. " te pegou! Caíram " .. count .. " itens", ANGRY)
	else
		Notify.toast(player, "💥 O " .. guardian.def.name .. " te pegou!", ANGRY)
	end
end

-- Primeiro o guardião "percebe" (para, vira, "!" e pulinho); só depois corre.
-- Esse aviso dá tempo de reagir mesmo quando o ninho nasce perto dele.
local function startChase(guardian: Guardian, player: Player)
	local now = os.clock()
	guardian.state = "alert"
	guardian.target = player
	guardian.chaseEnds = now + NOTICE_SECONDS + CHASE_SECONDS
	guardian.chargeEnds = now + NOTICE_SECONDS + CHARGE_SECONDS
	guardian.noticeEnds = now + NOTICE_SECONDS
	guardian.alert.Enabled = true
	chasing[player] = guardian
	player:SetAttribute("Perseguido", guardian.def.name)
end

-- Chamado pela coleta: `chance` é a probabilidade de o guardião mais perto vir atrás.
function GuardianService.alert(player: Player, position: Vector3, chance: number)
	if chasing[player] or rng:NextNumber() > chance then
		return
	end
	local root = rootOf(player)
	if root then
		for _, guardian in guardians do
			if inZone(guardian.zone, position) and inSafe(guardian.zone, root.Position) then
				return
			end
		end
	end
	local now = os.clock()
	local best: Guardian? = nil
	local bestDistance = ALERT_RADIUS
	for _, guardian in guardians do
		if guardian.state ~= "chase" and guardian.state ~= "alert" and now >= guardian.cooldownUntil and now >= guardian.stunnedUntil and inZone(guardian.zone, position) then
			local distance = (flat(guardian.root.Position) - flat(position)).Magnitude
			if distance < bestDistance then
				best, bestDistance = guardian, distance
			end
		end
	end
	if best then
		startChase(best, player)
	end
end

-- Nome com corações: ❤️ = golpes que ainda aguenta.
function updateTag(guardian: Guardian)
	if not guardian.tag then
		return
	end
	local hearts = string.rep("❤️", HITS_TO_KO - guardian.hits) .. string.rep("🖤", guardian.hits)
	guardian.tag.Text = "😠 " .. guardian.def.name .. " ⚡" .. guardian.def.speed .. "  " .. hearts
end

-- Golpe do jogador: acerta o guardião mais perto na frente dele. 3 golpes = desmaio + comida.
function GuardianService.hit(player: Player): boolean
	local now = os.clock()
	if lastHit[player] and now - lastHit[player] < HIT_COOLDOWN then
		return false
	end
	lastHit[player] = now
	local root = rootOf(player)
	if not root then
		return false
	end
	local best: Guardian? = nil
	local bestDistance = HIT_RANGE
	for _, guardian in guardians do
		if not guardian.knockedOut and inZone(guardian.zone, root.Position) then
			local offset = guardian.root.Position - root.Position
			local distance = flat(offset).Magnitude
			if distance < bestDistance and math.abs(offset.Y) < 7 then
				best, bestDistance = guardian, distance
			end
		end
	end
	if not best then
		return false
	end
	local guardian = best :: Guardian
	if guardian.target then
		stopChase(guardian)
	end
	guardian.state = "idle"
	guardian.hits += 1
	guardian.lastHitAt = now

	-- Tranco para trás (sem entrar na zona segura).
	local away = flat(guardian.root.Position - root.Position)
	away = if away.Magnitude > 0.1 then away.Unit else flat(root.CFrame.LookVector).Unit
	local pushed = flat(guardian.root.Position) + away * 6
	if not inSafe(guardian.zone, pushed, 2) and inZone(guardian.zone, pushed) then
		guardian.root.CFrame = CFrame.lookAt(pushed, pushed - away)
	end
	EffectRemote:FireClient(player, { kind = "pow", at = guardian.root.Position })

	guardian.alert.Enabled = true
	guardian.alertLabel.Text = "💫"
	if guardian.hits >= HITS_TO_KO then
		guardian.knockedOut = true
		guardian.stunnedUntil = now + KO_SECONDS
		guardian.cooldownUntil = now + KO_SECONDS + COOLDOWN
		local profile = DataService.get(player)
		if profile then
			profile.stats.knockouts = (profile.stats.knockouts or 0) + 1
			local perRoute = "ko_" .. guardian.routeId
			profile.stats[perRoute] = (profile.stats[perRoute] or 0) + 1
		end
		local food = guardian.def.food
		Notify.toast(player, "💥 Você derrubou o " .. guardian.def.name .. "! Pegue: " .. food.emoji .. " " .. food.name, Color3.fromRGB(255, 205, 60), "revelar")
		if GuardianService.onKnockout then
			GuardianService.onKnockout(guardian.zone, guardian.root.Position + away * 3, guardian.def, player)
		end
	else
		guardian.stunnedUntil = now + STUN_SECONDS
		guardian.cooldownUntil = math.max(guardian.cooldownUntil, now + STUN_SECONDS)
	end
	updateTag(guardian)
	return true
end

local function step(guardian: Guardian, dt: number, now: number)
	local position = guardian.root.Position
	local goal: Vector3? = nil
	local speed = WANDER_SPEED

	if guardian.stunnedUntil > 0 then
		if now < guardian.stunnedUntil then
			local base = CFrame.new(position.X, 0, position.Z) * guardian.root.CFrame.Rotation
			if guardian.knockedOut then
				-- Desmaiado: deitado de lado.
				local look = flat(guardian.root.CFrame.LookVector)
				look = if look.Magnitude > 0.1 then look.Unit else Vector3.zAxis
				guardian.root.CFrame = CFrame.lookAt(Vector3.new(position.X, 0.6, position.Z), Vector3.new(position.X, 0.6, position.Z) + look) * CFrame.Angles(0, 0, math.rad(90))
			else
				-- Tonto: balançando no lugar.
				guardian.root.CFrame = base * CFrame.Angles(0, 0, math.sin(now * 12) * 0.25)
			end
			return
		end
		-- Acordou: fica em pé de novo.
		guardian.stunnedUntil = 0
		guardian.alert.Enabled = false
		guardian.alertLabel.Text = "!"
		if guardian.knockedOut then
			guardian.knockedOut = false
			guardian.hits = 0
			updateTag(guardian)
		end
		local look = flat(guardian.root.CFrame.LookVector)
		look = if look.Magnitude > 0.1 then look.Unit else Vector3.zAxis
		guardian.root.CFrame = CFrame.lookAt(Vector3.new(position.X, 0, position.Z), Vector3.new(position.X, 0, position.Z) + look)
	end
	if guardian.hits > 0 and now - guardian.lastHitAt > HEAL_AFTER then
		guardian.hits = 0
		updateTag(guardian)
	end

	if guardian.state == "alert" then
		local target = guardian.target and rootOf(guardian.target)
		if not target then
			stopChase(guardian)
			return
		end
		local look = flat(target.Position) - flat(position)
		local at = Vector3.new(position.X, math.abs(math.sin(now * 18)) * 1.4, position.Z)
		guardian.root.CFrame = if look.Magnitude > 0.1
			then CFrame.lookAt(at, at + look.Unit)
			else CFrame.new(at) * guardian.root.CFrame.Rotation
		if now >= guardian.noticeEnds then
			guardian.state = "chase"
		end
		return
	end

	if guardian.state == "chase" then
		local player = guardian.target :: Player
		local target = rootOf(player)
		if not target or now > guardian.chaseEnds or not inZone(guardian.zone, target.Position) then
			stopChase(guardian)
		elseif inSafe(guardian.zone, target.Position) then
			stopChase(guardian)
			guardian.cooldownUntil = now + COOLDOWN
			Notify.toast(player, "🛡️ Você está na zona segura! O " .. guardian.def.name .. " desistiu", Color3.fromRGB(150, 230, 255))
		else
			goal = target.Position
			speed = guardian.def.speed * (if now < guardian.chargeEnds then CHARGE_MULT else 1)
			-- Quem está em cima de uma plataforma não é pego por baixo.
			local below = math.abs(target.Position.Y - position.Y) < 7
			if below and (flat(target.Position) - flat(position)).Magnitude <= CATCH_DISTANCE then
				catch(guardian, player)
				goal = nil
			end
		end
	end
	if guardian.state == "return" then
		goal = guardian.home
		speed = guardian.def.speed * 0.6
		if (flat(guardian.home) - flat(position)).Magnitude < 2 then
			guardian.state = "idle"
		end
	end
	if guardian.state == "idle" then
		if not guardian.wanderTo or now > guardian.nextWander then
			local angle = rng:NextNumber(0, math.pi * 2)
			local radius = rng:NextNumber(4, WANDER_RADIUS)
			guardian.wanderTo = guardian.home + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
			guardian.nextWander = now + rng:NextNumber(3, 6)
		end
		goal = guardian.wanderTo
	end

	if not goal then
		return
	end
	local offset = flat(goal) - flat(position)
	local distance = offset.Magnitude
	if distance < 0.5 then
		return
	end
	local direction = offset.Unit
	local moved = flat(position) + direction * math.min(distance, speed * dt)
	if inSafe(guardian.zone, moved, 2) then
		return
	end
	-- Pulinho enquanto anda: mais alto quando está correndo atrás de alguém.
	local hop = math.abs(math.sin(now * (if guardian.state == "chase" then 14 else 8))) * (if guardian.state
			== "chase"
		then 0.9
		else 0.3)
	local at = Vector3.new(moved.X, hop, moved.Z)
	guardian.root.CFrame = CFrame.lookAt(at, at + direction)
end

local function makeAlert(root: BasePart): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Alerta"
	gui.Size = UDim2.fromScale(4, 4)
	gui.StudsOffset = Vector3.new(0, 12, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Enabled = false
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = "!"
	label.TextScaled = true
	label.TextColor3 = ANGRY
	Style.outline(label, 4)
	label.Parent = gui
	gui.Parent = root
	return gui, label
end

function GuardianService.init(zones)
	EffectRemote = Remotes.event("Effect")
	for routeId, zone in zones do
		local def = DEFS[routeId]
		if def then
			local folder = Instance.new("Folder")
			folder.Name = "Guardioes"
			folder.Parent = zone.nodes.Parent
			for i = 1, PER_ZONE do
				local model = AnimalModel.build(def.species, def.rarity, false, def.name, true)
				model:ScaleTo(MODEL_SCALE)
				local root = model.PrimaryPart :: BasePart
				local tag = root:FindFirstChild("Tag")
				local tagLabel = tag and tag:FindFirstChildOfClass("TextLabel")
				if tagLabel then
					tagLabel.TextColor3 = ANGRY
				end
				local alert, alertLabel = makeAlert(root)
				local angle = (i / PER_ZONE) * math.pi * 2
				local home = zone.origin + Vector3.new(math.cos(angle), 0, math.sin(angle)) * zone.size * 0.25
				model:PivotTo(CFrame.new(home))
				model.Parent = folder
				table.insert(guardians, {
					def = def,
					routeId = routeId,
					zone = zone,
					model = model,
					root = root,
					alert = alert,
					alertLabel = alertLabel,
					tag = tagLabel :: TextLabel?,
					hits = 0,
					lastHitAt = 0,
					stunnedUntil = 0,
					knockedOut = false,
					home = home,
					state = "idle",
					target = nil,
					chaseEnds = 0,
					chargeEnds = 0,
					noticeEnds = 0,
					cooldownUntil = 0,
					wanderTo = nil,
					nextWander = 0,
				})
				updateTag(guardians[#guardians])
			end
		end
	end

	Remotes.event("Bater").OnServerEvent:Connect(function(player)
		-- O chefão tem prioridade: se o golpe acertou ele, não vai para os guardiões.
		if GuardianService.beforeHit and GuardianService.beforeHit(player) then
			return
		end
		GuardianService.hit(player)
	end)

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, guardian in guardians do
			step(guardian, dt, now)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local guardian = chasing[player]
		if guardian then
			stopChase(guardian)
		end
		lastHit[player] = nil
	end)
end

return GuardianService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Routes = require(Shared.Config.Routes)
local Style = require(Shared.Style)

local MapBuilder = {}

local PLOT_COUNT = 8
local PLOT_RADIUS = 150
local PLOT_SIZE = 70
local PORTAL_RADIUS = 58
local HUB_SIZE = 440
local SAFE_RADIUS = 22

local GRASS = Color3.fromRGB(96, 196, 70)
local SAND = Color3.fromRGB(230, 212, 160)
local WOOD = Color3.fromRGB(150, 105, 65)
local FENCE = Color3.fromRGB(238, 228, 208)
local STONE = Color3.fromRGB(125, 125, 135)

export type Plot = {
	index: number,
	cframe: CFrame,
	spawn: CFrame,
	sign: TextLabel,
	animals: Folder,
	treadmill: BasePart,
	owner: Player?,
}

export type Zone = {
	routeId: string,
	origin: Vector3,
	size: number,
	spawn: CFrame,
	nodes: Folder,
	returnField: BasePart,
	treasure: BasePart,
	safeCenter: Vector3,
	safeRadius: number,
}

local function rad(deg: number): number
	return math.rad(deg)
end

local function block(
	parent: Instance,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	if shape then
		part.Shape = shape
	end
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function decor(part: BasePart): BasePart
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

local function billboard(adornee: BasePart, size: UDim2, offset: Vector3, maxDistance: number): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance
	gui.LightInfluence = 0
	gui.Parent = adornee
	return gui
end

local function textLabel(
	parent: Instance,
	name: string,
	text: string,
	size: UDim2,
	position: UDim2,
	color: Color3
): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	Style.outline(label, 4)
	label.Parent = parent
	return label
end

local function setupLighting()
	-- Dia claro e colorido: sombra suave e ambiente forte, para nada ficar escuro.
	Lighting.ClockTime = 14
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(95, 95, 105)
	Lighting.OutdoorAmbient = Color3.fromRGB(175, 175, 185)
	-- Sombra marcada do sol: é ela que dá volume aos blocos.
	Lighting.ShadowSoftness = 0.15
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.3
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local atmosphere = Instance.new("Atmosphere")
		atmosphere.Density = 0.2
		atmosphere.Offset = 0.05
		atmosphere.Color = Color3.fromRGB(205, 228, 255)
		atmosphere.Decay = Color3.fromRGB(140, 175, 230)
		atmosphere.Glare = 0.1
		atmosphere.Haze = 0.4
		atmosphere.Parent = Lighting
	end
	if not Lighting:FindFirstChild("Bloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "Bloom"
		bloom.Intensity = 0.35
		bloom.Size = 24
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChild("Cor") then
		local color = Instance.new("ColorCorrectionEffect")
		color.Name = "Cor"
		color.Saturation = 0.25
		color.Contrast = 0.06
		color.Brightness = 0.02
		color.Parent = Lighting
	end
end

local function island(parent: Instance, center: Vector3, size: number, color: Color3, material: Enum.Material)
	Workspace.Terrain:FillBlock(
		CFrame.new(center.X, -8, center.Z),
		Vector3.new(size + 700, 12, size + 700),
		Enum.Material.Water
	)
	block(parent, Vector3.new(size + 24, 3, size + 24), CFrame.new(center.X, -2.5, center.Z), SAND, Enum.Material.Sand)
	block(parent, Vector3.new(size, 4, size), CFrame.new(center.X, -2, center.Z), color, material)
end

local function fenceLine(parent: Instance, cframe: CFrame, length: number)
	local posts = math.max(2, math.floor(length / 6) + 1)
	for i = 0, posts - 1 do
		local x = -length / 2 + i * (length / (posts - 1))
		block(parent, Vector3.new(0.6, 3.2, 0.6), cframe * CFrame.new(x, 1.6, 0), FENCE, Enum.Material.WoodPlanks)
	end
	for _, y in { 1.2, 2.4 } do
		block(parent, Vector3.new(length, 0.4, 0.3), cframe * CFrame.new(0, y, 0), FENCE, Enum.Material.WoodPlanks)
	end
end

local function barn(parent: Instance, cframe: CFrame, color: Color3, width: number, depth: number, height: number)
	local roofColor = Color3.fromRGB(95, 55, 45)
	block(
		parent,
		Vector3.new(width, height, depth),
		cframe * CFrame.new(0, height / 2, 0),
		color,
		Enum.Material.WoodPlanks
	)
	local rise = (width / 2) * math.tan(rad(30))
	local panel = (width / 2) / math.cos(rad(30)) + 1
	for _, side in { -1, 1 } do
		block(
			parent,
			Vector3.new(panel, 0.8, depth + 2),
			cframe * CFrame.new(side * width / 4, height + rise / 2 + 0.4, 0) * CFrame.Angles(0, 0, -side * rad(30)),
			roofColor,
			Enum.Material.WoodPlanks
		)
		local gable = Instance.new("WedgePart")
		gable.Anchored = true
		gable.Size = Vector3.new(depth, rise, width / 2)
		gable.CFrame = cframe
			* CFrame.new(side * width / 4, height + rise / 2, 0)
			* CFrame.Angles(0, -side * rad(90), 0)
		gable.Color = color
		gable.Material = Enum.Material.WoodPlanks
		gable.Parent = parent
	end
	block(
		parent,
		Vector3.new(width * 0.35, height * 0.65, 0.3),
		cframe * CFrame.new(0, height * 0.325, -depth / 2 - 0.1),
		Color3.fromRGB(70, 40, 30),
		Enum.Material.WoodPlanks
	)
	-- Acabamento branco: quinas, faixa no alto e moldura da porta.
	local trim = Color3.fromRGB(250, 246, 238)
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			block(
				parent,
				Vector3.new(1, height, 1),
				cframe * CFrame.new(x * (width / 2), height / 2, z * (depth / 2)),
				trim,
				Enum.Material.WoodPlanks
			)
		end
	end
	block(
		parent,
		Vector3.new(width + 0.6, 0.8, depth + 0.6),
		cframe * CFrame.new(0, height - 0.4, 0),
		trim,
		Enum.Material.WoodPlanks
	)
	local doorWidth, doorHeight = width * 0.35, height * 0.65
	for _, x in { -1, 1 } do
		block(
			parent,
			Vector3.new(0.7, doorHeight + 0.7, 0.4),
			cframe * CFrame.new(x * (doorWidth / 2 + 0.35), (doorHeight + 0.7) / 2, -depth / 2 - 0.2),
			trim,
			Enum.Material.WoodPlanks
		)
	end
	block(
		parent,
		Vector3.new(doorWidth + 1.4, 0.7, 0.4),
		cframe * CFrame.new(0, doorHeight + 0.35, -depth / 2 - 0.2),
		trim,
		Enum.Material.WoodPlanks
	)
end

-- Árvore de blocos: tronco quadrado e copa de cubos empilhados em dois tons.
local function tree(parent: Instance, position: Vector3, foliage: Color3, rng: Random)
	local base = CFrame.new(position) * CFrame.Angles(0, rad(rng:NextInteger(0, 3) * 90 + rng:NextNumber(-12, 12)), 0)
	local height = math.floor(rng:NextNumber(6, 10))
	local trunk = Style.shade(Color3.fromRGB(150, 85, 40), rng:NextNumber(-0.1, 0.05))
	local dark = Style.shade(foliage, -0.18)
	local light = Style.shade(foliage, 0.12)
	block(parent, Vector3.new(2, height, 2), base * CFrame.new(0, height / 2, 0), trunk, Enum.Material.Wood)

	local width = math.floor(rng:NextNumber(8, 11))
	local top = height + 2
	block(parent, Vector3.new(width, 4, width), base * CFrame.new(0, top, 0), dark, Enum.Material.Grass)
	block(parent, Vector3.new(width - 3, 3, width - 3), base * CFrame.new(0.5, top + 3.5, -0.5), foliage, Enum.Material.Grass)
	block(parent, Vector3.new(width - 6, 2, width - 6), base * CFrame.new(0, top + 6, 0), light, Enum.Material.Grass)
	-- Tufos laterais deixam a silhueta menos "caixa".
	for _ = 1, 2 do
		local side = rng:NextInteger(0, 3) * 90
		local tuft = CFrame.Angles(0, rad(side), 0) * CFrame.new(width / 2, rng:NextNumber(-0.5, 1.5), 0)
		block(parent, Vector3.new(3, 3, 4), base * CFrame.new(0, top, 0) * tuft, foliage, Enum.Material.Grass)
	end
end

local FLOWER_COLORS = {
	Color3.fromRGB(255, 90, 170),
	Color3.fromRGB(255, 225, 60),
	Color3.fromRGB(255, 80, 70),
	Color3.fromRGB(170, 110, 255),
	Color3.fromRGB(255, 255, 255),
}

-- Florzinha de blocos: caule, pétalas e miolo.
local function flower(parent: Instance, position: Vector3, rng: Random)
	local base = CFrame.new(position) * CFrame.Angles(0, rad(rng:NextNumber(0, 90)), 0)
	local height = rng:NextNumber(1.2, 2)
	decor(block(parent, Vector3.new(0.3, height, 0.3), base * CFrame.new(0, height / 2, 0), Color3.fromRGB(60, 150, 50)))
	local petals = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
	decor(block(parent, Vector3.new(1.3, 0.4, 0.5), base * CFrame.new(0, height + 0.2, 0), petals))
	decor(block(parent, Vector3.new(0.5, 0.4, 1.3), base * CFrame.new(0, height + 0.2, 0), petals))
	decor(block(parent, Vector3.new(0.45, 0.5, 0.45), base * CFrame.new(0, height + 0.3, 0), Color3.fromRGB(255, 200, 40)))
end

-- Manchas de grama em outro tom quebram o chão "chapado".
local function patch(parent: Instance, position: Vector3, ground: Color3, rng: Random)
	local size = rng:NextNumber(6, 14)
	local tone = if rng:NextNumber() < 0.5 then -0.1 else 0.08
	decor(
		block(
			parent,
			Vector3.new(size, 0.2, size * rng:NextNumber(0.6, 1)),
			CFrame.new(position + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, rad(rng:NextNumber(0, 90)), 0),
			Style.shade(ground, tone),
			Enum.Material.Grass
		)
	)
end

-- Arbusto em degraus, como os dos simuladores.
local function bush(parent: Instance, position: Vector3, foliage: Color3, rng: Random)
	local base = CFrame.new(position) * CFrame.Angles(0, rad(rng:NextNumber(0, 90)), 0)
	local size = rng:NextNumber(4, 6)
	block(parent, Vector3.new(size, 1.6, size), base * CFrame.new(0, 0.8, 0), Style.shade(foliage, -0.15), Enum.Material.Grass)
	block(parent, Vector3.new(size - 1.6, 1.4, size - 1.6), base * CFrame.new(0, 2.3, 0), foliage, Enum.Material.Grass)
	block(parent, Vector3.new(size - 3, 1, size - 3), base * CFrame.new(0, 3.5, 0), Style.shade(foliage, 0.12), Enum.Material.Grass)
end

local function rock(parent: Instance, position: Vector3, rng: Random)
	local size = Vector3.new(rng:NextNumber(2, 5), rng:NextNumber(1.5, 3.5), rng:NextNumber(2, 5))
	block(
		parent,
		size,
		CFrame.new(position + Vector3.new(0, size.Y / 2 - 0.3, 0))
			* CFrame.Angles(0, rng:NextNumber(0, math.pi), rad(rng:NextNumber(-10, 10))),
		STONE,
		Enum.Material.Slate
	)
end

local function buildPortal(
	parent: Instance,
	name: string,
	cframe: CFrame,
	color: Color3,
	title: string
): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = name
	for _, x in { -7, 7 } do
		block(model, Vector3.new(2, 15, 2), cframe * CFrame.new(x, 7.5, 0), STONE, Enum.Material.Slate)
	end
	local beam =
		block(model, Vector3.new(17, 2.4, 2.4), cframe * CFrame.new(0, 15.5, 0), color, Enum.Material.WoodPlanks)
	local field = block(model, Vector3.new(12, 14, 0.5), cframe * CFrame.new(0, 7.5, 0), color, Enum.Material.Neon)
	field.Name = "Campo"
	field.Transparency = 0.45
	field.CanCollide = false

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = 6
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Speed = NumberRange.new(0.5, 1)
	emitter.Size = NumberSequence.new(0.4, 0)
	emitter.Parent = field

	local gui = billboard(beam, UDim2.fromScale(28, 8), Vector3.new(0, 6, 0), 260)
	gui.Name = "Rotulo"
	textLabel(gui, "Titulo", title, UDim2.fromScale(1, 0.55), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))
	textLabel(gui, "Status", "", UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0.58), Color3.fromRGB(255, 235, 150))

	model.PrimaryPart = beam
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	model.Parent = parent
	return model, field
end

local function buildHub(world: Instance): SpawnLocation
	local hub = Instance.new("Model")
	hub.Name = "Centro"
	hub.Parent = world
	island(hub, Vector3.zero, HUB_SIZE, GRASS, Enum.Material.Grass)

	block(
		hub,
		Vector3.new(0.4, 44, 44),
		CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, rad(90)),
		Color3.fromRGB(200, 195, 185),
		Enum.Material.Cobblestone,
		Enum.PartType.Cylinder
	)
	block(
		hub,
		Vector3.new(3, 8, 8),
		CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, rad(90)),
		STONE,
		Enum.Material.Cobblestone,
		Enum.PartType.Cylinder
	)
	decor(
		block(
			hub,
			Vector3.new(0.2, 6.6, 6.6),
			CFrame.new(0, 3.05, 0) * CFrame.Angles(0, 0, rad(90)),
			Color3.fromRGB(70, 150, 230),
			Enum.Material.Glass,
			Enum.PartType.Cylinder
		)
	)
	for _, x in { -3.4, 3.4 } do
		block(hub, Vector3.new(0.6, 7, 0.6), CFrame.new(x, 6.5, 0), WOOD, Enum.Material.Wood)
	end
	block(hub, Vector3.new(9, 0.6, 5), CFrame.new(0, 10.2, 0), Color3.fromRGB(180, 60, 50), Enum.Material.WoodPlanks)

	local signAnchor = decor(block(hub, Vector3.one, CFrame.new(0, 44, 0), GRASS))
	signAnchor.Transparency = 1
	local sign = billboard(signAnchor, UDim2.fromScale(44, 9), Vector3.zero, 400)
	textLabel(
		sign,
		"Titulo",
		"🌾 FAZENDA LENDÁRIA 🌾",
		UDim2.fromScale(1, 0.7),
		UDim2.fromScale(0, 0),
		Color3.fromRGB(255, 215, 80)
	)
	textLabel(
		sign,
		"Sub",
		"Explore as rotas • Colete materiais • Evolua seus animais",
		UDim2.fromScale(1, 0.3),
		UDim2.fromScale(0, 0.7),
		Color3.new(1, 1, 1)
	)

	for i = 1, PLOT_COUNT do
		local angle = (i - 0.5) * (2 * math.pi / PLOT_COUNT)
		local length = PLOT_RADIUS - PLOT_SIZE / 2 - 22
		decor(
			block(
				hub,
				Vector3.new(8, 0.2, length),
				CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.1, 22 + length / 2),
				Color3.fromRGB(165, 125, 80),
				Enum.Material.Ground
			)
		)
	end

	-- Árvores entre os lotes e na borda da ilha, arbustos perto dos caminhos.
	local rng = Random.new(2024)
	local hubFoliage = Color3.fromRGB(70, 185, 60)
	for i = 1, PLOT_COUNT do
		local between = i * (2 * math.pi / PLOT_COUNT)
		tree(hub, (CFrame.Angles(0, between, 0) * CFrame.new(0, 0, PLOT_RADIUS)).Position, hubFoliage, rng)
		tree(hub, (CFrame.Angles(0, between + rad(8), 0) * CFrame.new(0, 0, 205)).Position, hubFoliage, rng)
		tree(hub, (CFrame.Angles(0, between - rad(9), 0) * CFrame.new(0, 0, 200)).Position, hubFoliage, rng)
		local path = (i - 0.5) * (2 * math.pi / PLOT_COUNT)
		for _, side in { -1, 1 } do
			bush(hub, (CFrame.Angles(0, path, 0) * CFrame.new(side * 9, 0, 80)).Position, hubFoliage, rng)
		end
		-- Flores na beira do caminho e manchas de grama perto da borda.
		for step = 1, 3 do
			local at = CFrame.Angles(0, path, 0) * CFrame.new(rng:NextNumber(-7, 7), 0, 30 + step * 12)
			flower(hub, at.Position, rng)
		end
		for _ = 1, 3 do
			local angle = between + rad(rng:NextNumber(-18, 18))
			patch(hub, (CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, rng:NextNumber(190, 212))).Position, GRASS, rng)
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.5, 14)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = hub
	return spawn
end

-- Esteira de treino no estilo dos simuladores: lona escura larga com setas brancas que
-- andam (animadas no cliente) e moldura laranja. Quem sobe corre sozinho e treina
-- (ver TrainingService e o cliente Treadmill). Para sair, é só andar para fora.
local TREADMILL_BELT = Vector3.new(7, 0.3, 10)
local CHEVRON_COUNT = 5

local function buildTreadmill(parent: Instance, at: CFrame): BasePart
	local model = Instance.new("Model")
	model.Name = "Esteira"
	model.Parent = parent
	local frame = Color3.fromRGB(255, 150, 40)
	block(model, Vector3.new(TREADMILL_BELT.X + 1.6, 0.9, TREADMILL_BELT.Z + 1.6), at * CFrame.new(0, 0.45, 0), frame, Enum.Material.Plastic)
	local belt = block(model, TREADMILL_BELT, at * CFrame.new(0, 1.05, 0), Color3.fromRGB(28, 32, 58))
	belt.Name = "Lona"

	-- Setas ">" apontando para a frente; o cliente faz elas correrem para trás.
	local chevrons = Instance.new("Folder")
	chevrons.Name = "Setas"
	chevrons.Parent = model
	for i = 1, CHEVRON_COUNT do
		local chevron = Instance.new("Model")
		chevron.Name = "Seta"
		for _, side in { -1, 1 } do
			local arm = decor(
				block(
					chevron,
					Vector3.new(0.7, 0.06, 3),
					CFrame.new(side * 1.05, 0, 0.55) * CFrame.Angles(0, side * rad(-38), 0),
					Color3.fromRGB(235, 238, 250)
				)
			)
			arm.CastShadow = false
		end
		chevron.WorldPivot = CFrame.identity
		chevron:SetAttribute("Indice", i)
		chevron:PivotTo(at * CFrame.new(0, 1.23, -TREADMILL_BELT.Z / 2 + (i - 0.5) * TREADMILL_BELT.Z / CHEVRON_COUNT))
		chevron.Parent = chevrons
	end

	-- Painel na frente com tela e duas alças, como o dos simuladores.
	local front = at * CFrame.new(0, 0, -TREADMILL_BELT.Z / 2 - 1.3)
	for _, x in { -2.6, 2.6 } do
		block(model, Vector3.new(1, 4.6, 1), front * CFrame.new(x, 2.3, 0), frame, Enum.Material.Plastic)
	end
	local console = block(model, Vector3.new(6.2, 1.8, 1.2), front * CFrame.new(0, 4.4, 0) * CFrame.Angles(rad(20), 0, 0), frame, Enum.Material.Plastic)
	decor(block(model, Vector3.new(4.4, 1.1, 0.1), front * CFrame.new(0, 4.45, 0.62) * CFrame.Angles(rad(20), 0, 0), Color3.fromRGB(40, 60, 110), Enum.Material.Neon))
	textLabel(
		billboard(console, UDim2.fromOffset(300, 56), Vector3.new(0, 4, 0), 140),
		"Titulo",
		"🏃 ESTEIRA DE TREINO",
		UDim2.fromScale(1, 1),
		UDim2.fromScale(0, 0),
		Color3.fromRGB(120, 230, 255)
	)
	return belt
end

local function buildPlot(parent: Instance, index: number): Plot
	local angle = (index - 0.5) * (2 * math.pi / PLOT_COUNT)
	local cframe = CFrame.Angles(0, angle, 0) * CFrame.new(0, 1, PLOT_RADIUS)
	local half = PLOT_SIZE / 2

	local model = Instance.new("Model")
	model.Name = "Lote" .. index
	model.Parent = parent

	block(
		model,
		Vector3.new(PLOT_SIZE, 1, PLOT_SIZE),
		cframe * CFrame.new(0, -0.5, 0),
		Color3.fromRGB(118, 208, 78),
		Enum.Material.Grass
	)
	fenceLine(model, cframe * CFrame.new(0, 0, half), PLOT_SIZE)
	fenceLine(model, cframe * CFrame.new(half, 0, 0) * CFrame.Angles(0, rad(90), 0), PLOT_SIZE)
	fenceLine(model, cframe * CFrame.new(-half, 0, 0) * CFrame.Angles(0, rad(90), 0), PLOT_SIZE)
	fenceLine(model, cframe * CFrame.new(-(half + 7) / 2, 0, -half), half - 7)
	fenceLine(model, cframe * CFrame.new((half + 7) / 2, 0, -half), half - 7)

	for _, x in { -7.5, 7.5 } do
		block(model, Vector3.new(1, 9, 1), cframe * CFrame.new(x, 4.5, -half), WOOD, Enum.Material.Wood)
	end
	local beam =
		block(model, Vector3.new(17, 1.5, 1), cframe * CFrame.new(0, 9.5, -half), WOOD, Enum.Material.WoodPlanks)

	barn(model, cframe * CFrame.new(0, 0, 24), Color3.fromRGB(190, 45, 40), 16, 12, 9)
	for _, x in { -26, 26 } do
		block(
			model,
			Vector3.new(4, 3, 3),
			cframe * CFrame.new(x, 1.5, 22),
			Color3.fromRGB(225, 195, 95),
			Enum.Material.Fabric
		)
	end
	block(model, Vector3.new(8, 1.5, 2.5), cframe * CFrame.new(-22, 0.75, -12), WOOD, Enum.Material.WoodPlanks)
	decor(
		block(
			model,
			Vector3.new(7.4, 0.2, 1.9),
			cframe * CFrame.new(-22, 1.45, -12),
			Color3.fromRGB(80, 160, 230),
			Enum.Material.Glass
		)
	)

	local treadmill = buildTreadmill(model, cframe * CFrame.new(21, 0, -16))

	local gui = billboard(beam, UDim2.fromScale(18, 3), Vector3.new(0, 2.4, 0), 250)
	local sign =
		textLabel(gui, "Dono", "Fazenda livre", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.new(1, 1, 1))

	local animals = Instance.new("Folder")
	animals.Name = "Animais"
	animals.Parent = model

	return {
		index = index,
		cframe = cframe,
		spawn = cframe * CFrame.new(0, 3, -28) * CFrame.Angles(0, math.pi, 0),
		sign = sign,
		animals = animals,
		treadmill = treadmill,
		owner = nil,
	}
end

local ROUTE_DECOR: { [string]: (Instance, any, Random, (number) -> Vector3) -> () } = {
	Galinheiro = function(parent, route, rng, randomPoint)
		for _ = 1, 4 do
			barn(
				parent,
				CFrame.new(randomPoint(20)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0),
				route.theme,
				8,
				6,
				5
			)
		end
	end,
	Chiqueiro = function(parent, _route, rng, randomPoint)
		for _ = 1, 12 do
			local diameter = rng:NextNumber(10, 20)
			decor(
				block(
					parent,
					Vector3.new(0.3, diameter, diameter),
					CFrame.new(randomPoint(12) + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, rad(90)),
					Color3.fromRGB(85, 60, 40),
					Enum.Material.Mud,
					Enum.PartType.Cylinder
				)
			)
		end
	end,
	Pasto = function(parent, _route, rng, randomPoint)
		local colors = {
			Color3.fromRGB(255, 240, 90),
			Color3.fromRGB(255, 255, 255),
			Color3.fromRGB(255, 130, 200),
			Color3.fromRGB(170, 120, 255),
		}
		for _ = 1, 90 do
			decor(
				block(
					parent,
					Vector3.one * 0.9,
					CFrame.new(randomPoint(4) + Vector3.new(0, 0.4, 0)),
					colors[rng:NextInteger(1, #colors)],
					Enum.Material.SmoothPlastic,
					Enum.PartType.Ball
				)
			)
		end
	end,
	Pradaria = function(parent, _route, rng, randomPoint)
		for _ = 1, 16 do
			block(
				parent,
				Vector3.new(4, 5, 5),
				CFrame.new(randomPoint(8) + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
				Color3.fromRGB(225, 195, 95),
				Enum.Material.Fabric,
				Enum.PartType.Cylinder
			)
		end
		for _ = 1, 6 do
			fenceLine(parent, CFrame.new(randomPoint(20)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), 24)
		end
	end,
}

-- Árvore do Tesouro: tronco gigante com plataformas em espiral e um baú na copa.
-- As 6 primeiras sobem 4 studs (pulo normal = 7,2); as 3 últimas sobem 9 (precisa de pulo duplo).
local TREASURE_HEIGHTS = { 3, 7, 11, 15, 19, 23, 32, 41, 50 }
-- Copa estreita (meia largura 6) deixa 3 studs livres até a última plataforma (borda em 9),
-- senão a cabeça bate na copa no último pulo.
local CANOPY_TOP = 55

local function treasureTree(parent: Instance, center: Vector3, route): BasePart
	local model = Instance.new("Model")
	model.Name = "ArvoreDoTesouro"
	model.Parent = parent
	local bark = Color3.fromRGB(135, 80, 40)
	block(model, Vector3.new(5, CANOPY_TOP - 3, 5), CFrame.new(center + Vector3.new(0, (CANOPY_TOP - 3) / 2, 0)), bark, Enum.Material.Wood)
	for i = 0, 3 do
		local side = CFrame.Angles(0, i * math.pi / 2, 0)
		block(model, Vector3.new(3, 3, 5), CFrame.new(center) * side * CFrame.new(0, 1.5, 4.5), Style.shade(bark, -0.1), Enum.Material.Wood)
	end
	local leaves = route.foliage
	block(model, Vector3.new(12, 3, 12), CFrame.new(center + Vector3.new(0, CANOPY_TOP - 1.5, 0)), leaves, Enum.Material.Grass)
	for i = 0, 3 do
		local side = CFrame.Angles(0, i * math.pi / 2 + rad(45), 0)
		decor(block(model, Vector3.new(3, 2, 3), CFrame.new(center) * side * CFrame.new(0, CANOPY_TOP + 1, 5), Style.shade(leaves, 0.12), Enum.Material.Grass))
	end

	for i, height in TREASURE_HEIGHTS do
		local angle = rad(i * 52)
		local at = center + Vector3.new(math.cos(angle) * 12, height - 0.5, math.sin(angle) * 12)
		local color = if i > 6 then route.theme else Style.shade(route.theme, 0.35)
		block(model, Vector3.new(6, 1, 6), CFrame.new(at) * CFrame.Angles(0, -angle, 0), color, Enum.Material.WoodPlanks)
	end

	-- Baú dourado na copa.
	local gold = Color3.fromRGB(255, 200, 50)
	local chestAt = CFrame.new(center + Vector3.new(0, CANOPY_TOP + 1.25, 0))
	local chest = block(model, Vector3.new(4, 2.5, 3), chestAt, Color3.fromRGB(150, 85, 35), Enum.Material.WoodPlanks)
	chest.Name = "Bau"
	block(model, Vector3.new(4.3, 1.1, 3.3), chestAt * CFrame.new(0, 1.7, 0), Color3.fromRGB(120, 65, 25), Enum.Material.WoodPlanks)
	for _, x in { -1.5, 1.5 } do
		decor(block(model, Vector3.new(0.4, 3.9, 3.4), chestAt * CFrame.new(x, 0.55, 0), gold, Enum.Material.SmoothPlastic))
	end
	decor(block(model, Vector3.new(0.8, 0.9, 0.3), chestAt * CFrame.new(0, 0.9, -1.65), gold, Enum.Material.SmoothPlastic))
	local light = Instance.new("PointLight")
	light.Color = gold
	light.Range = 16
	light.Brightness = 2
	light.Parent = chest
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(gold)
	sparkles.LightEmission = 1
	sparkles.Rate = 10
	sparkles.Lifetime = NumberRange.new(1, 1.6)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Size = NumberSequence.new(0.5, 0)
	sparkles.Parent = chest

	local topSign = billboard(chest, UDim2.fromScale(22, 4), Vector3.new(0, 7, 0), 420)
	textLabel(topSign, "Titulo", "💎 BAÚ DO TESOURO", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), gold)
	local base = decor(block(model, Vector3.one, CFrame.new(center + Vector3.new(0, 9, 0)), bark))
	base.Transparency = 1
	textLabel(
		billboard(base, UDim2.fromScale(20, 3), Vector3.zero, 140),
		"Aviso",
		"🌳 Suba até o topo! Precisa de 🦘 Pulo Duplo",
		UDim2.fromScale(1, 1),
		UDim2.fromScale(0, 0),
		Color3.new(1, 1, 1)
	)
	return chest
end

local function buildZone(parent: Instance, routeId: string, index: number): Zone
	local route = Routes.byId[routeId]
	local origin: Vector3 = route.origin
	local size: number = route.size
	local half = size / 2
	local rng = Random.new(index * 97)

	local model = Instance.new("Model")
	model.Name = routeId
	model.Parent = parent
	island(model, origin, size, route.ground, route.groundMaterial)

	local spawnPosition = origin + Vector3.new(0, 3, half - 24)
	local spawn = CFrame.lookAt(spawnPosition, origin + Vector3.new(0, 3, 0))

	local function randomPoint(margin: number): Vector3
		for _ = 1, 20 do
			local point = origin
				+ Vector3.new(
					rng:NextNumber(-half + margin, half - margin),
					0,
					rng:NextNumber(-half + margin, half - margin)
				)
			local clearOfNinhal = (point - origin).Magnitude > 28
			if (point - Vector3.new(spawnPosition.X, 0, spawnPosition.Z)).Magnitude > 34 and clearOfNinhal then
				return point
			end
		end
		return origin
	end

	local sign = decor(block(model, Vector3.one, CFrame.new(origin + Vector3.new(0, 30, 0)), route.theme))
	sign.Transparency = 1
	local gui = billboard(sign, UDim2.fromScale(40, 7), Vector3.zero, 500)
	textLabel(
		gui,
		"Titulo",
		route.name,
		UDim2.fromScale(1, 1),
		UDim2.fromScale(0, 0),
		route.theme:Lerp(Color3.new(1, 1, 1), 0.35)
	)

	local _, returnField = buildPortal(
		model,
		"Retorno",
		CFrame.new(origin + Vector3.new(0, 0, half - 8)),
		Color3.fromRGB(110, 205, 110),
		"🏡 Voltar para a Fazenda"
	)
	barn(model, CFrame.new(origin + Vector3.new(-half + 26, 0, half - 26)), route.theme, 18, 14, 10)

	-- Zona segura em volta da chegada e do portal de volta: guardião não entra.
	local safeCenter = origin + Vector3.new(0, 0, half - 18)
	local safe = decor(
		block(
			model,
			Vector3.new(0.3, SAFE_RADIUS * 2, SAFE_RADIUS * 2),
			CFrame.new(safeCenter + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, rad(90)),
			Color3.fromRGB(120, 215, 255),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Cylinder
		)
	)
	safe.Name = "ZonaSegura"
	safe.Transparency = 0.35
	decor(
		block(
			model,
			Vector3.new(0.3, SAFE_RADIUS * 2 + 2, SAFE_RADIUS * 2 + 2),
			CFrame.new(safeCenter + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, rad(90)),
			Color3.new(1, 1, 1),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Cylinder
		)
	)
	local safeSign = decor(block(model, Vector3.one, CFrame.new(safeCenter + Vector3.new(-SAFE_RADIUS + 4, 9, 0)), GRASS))
	safeSign.Transparency = 1
	textLabel(
		billboard(safeSign, UDim2.fromScale(16, 3.5), Vector3.zero, 160),
		"Titulo",
		"🛡️ ZONA SEGURA",
		UDim2.fromScale(1, 1),
		UDim2.fromScale(0, 0),
		Color3.fromRGB(150, 230, 255)
	)

	local treasure = treasureTree(model, origin + Vector3.new(half - 34, 0, -half + 34), route)

	-- Ninhal: plataforma de palha no meio com os 3 ninhos fixos (RouteService coloca os ninhos).
	local straw = Color3.fromRGB(222, 180, 90)
	block(model, Vector3.new(0.8, 40, 40), CFrame.new(origin + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, rad(90)), straw, Enum.Material.Fabric, Enum.PartType.Cylinder)
	block(model, Vector3.new(0.6, 42, 42), CFrame.new(origin + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, rad(90)), Style.shade(straw, -0.25), Enum.Material.Fabric, Enum.PartType.Cylinder)
	local ninhalSign = decor(block(model, Vector3.one, CFrame.new(origin + Vector3.new(0, 16, 0)), straw))
	ninhalSign.Transparency = 1
	textLabel(billboard(ninhalSign, UDim2.fromScale(26, 6), Vector3.zero, 500), "Titulo", "🥚 NINHAL", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), Color3.fromRGB(255, 225, 120))

	-- Trilha de pedras saindo da zona segura para o meio da rota.
	local pathRng = Random.new(index * 31)
	local toCenter = (origin - safeCenter).Unit
	local sideways = Vector3.new(toCenter.Z, 0, -toCenter.X)
	for step = 1, 9 do
		local at = safeCenter + toCenter * (SAFE_RADIUS + step * 5) + sideways * pathRng:NextNumber(-1.2, 1.2)
		decor(
			block(
				model,
				Vector3.new(3.4, 0.4, 3.4),
				CFrame.new(at + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, rad(pathRng:NextNumber(-20, 20)), 0),
				Color3.fromRGB(215, 210, 200),
				Enum.Material.Slate
			)
		)
	end

	local scenery = Instance.new("Folder")
	scenery.Name = "Cenario"
	scenery.Parent = model
	for _ = 1, math.floor(size / 6) do
		tree(scenery, randomPoint(8), route.foliage, rng)
	end
	for _ = 1, math.floor(size / 8) do
		bush(scenery, randomPoint(6), route.foliage, rng)
	end
	for _ = 1, math.floor(size / 5) do
		patch(scenery, randomPoint(8), route.ground, rng)
	end
	for _ = 1, math.floor(size / 4) do
		flower(scenery, randomPoint(4), rng)
	end
	for _ = 1, 18 do
		rock(scenery, randomPoint(6), rng)
	end
	local decorate = ROUTE_DECOR[routeId]
	if decorate then
		decorate(scenery, route, rng, randomPoint)
	end

	local nodes = Instance.new("Folder")
	nodes.Name = "Nos"
	nodes.Parent = model

	return {
		routeId = routeId,
		origin = origin,
		size = size,
		spawn = spawn,
		nodes = nodes,
		returnField = returnField,
		treasure = treasure,
		safeCenter = safeCenter,
		safeRadius = SAFE_RADIUS,
	}
end

function MapBuilder.build(): { plots: { Plot }, zones: { [string]: Zone }, portals: { [string]: BasePart } }
	local oldBaseplate = Workspace:FindFirstChild("Baseplate")
	if oldBaseplate then
		oldBaseplate:Destroy()
	end
	for _, child in Workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "Mundo"

	buildHub(world)

	local plotFolder = Instance.new("Folder")
	plotFolder.Name = "Lotes"
	plotFolder.Parent = world
	local plots = {}
	for i = 1, PLOT_COUNT do
		plots[i] = buildPlot(plotFolder, i)
	end

	local portalFolder = Instance.new("Folder")
	portalFolder.Name = "Portais"
	portalFolder.Parent = world
	local zoneFolder = Instance.new("Folder")
	zoneFolder.Name = "Rotas"
	zoneFolder.Parent = world

	local portals = {}
	local zones = {}
	for i, routeId in Routes.order do
		local route = Routes.byId[routeId]
		local angle = (i - 1) * (2 * math.pi / #Routes.order)
		local _, field = buildPortal(
			portalFolder,
			routeId,
			CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, PORTAL_RADIUS),
			route.theme,
			route.name
		)
		portals[routeId] = field
		zones[routeId] = buildZone(zoneFolder, routeId, i)
	end

	Style.apply(world)
	world.Parent = Workspace
	return { plots = plots, zones = zones, portals = portals }
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">MissionService</string><ProtectedString name="Source"><![CDATA[-- Acompanha a missão atual de cada jogador, paga o prêmio ao completar e publica o estado
-- em atributos ("Missao*") para o painel do HUD e o guia.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Missions = require(Shared.Config.Missions)

local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.Notify)

local MissionService = {}

local CHECK_EVERY = 0.5
local GREEN = Color3.fromRGB(95, 235, 70)

local function statValue(profile, stat: string?): number
	return if stat then profile.stats[stat] or 0 else 0
end

-- Devolve (progresso, meta) da missão atual.
local function progressOf(profile, mission): (number, number)
	if mission.kind == "stat" then
		return math.max(0, statValue(profile, mission.stat) - (profile.mission.base or 0)), mission.goal
	elseif mission.kind == "speed" then
		return Balance.walkSpeed(profile), mission.goal
	elseif mission.kind == "upgrade" then
		return profile.upgrades[mission.id] or 0, mission.goal
	elseif mission.kind == "animal" then
		return if Balance.hasAnimal(profile, mission.id, mission.goal) then 1 else 0, 1
	elseif mission.kind == "route" then
		return if profile.routes[mission.id] then 1 else 0, 1
	end
	return 0, 1
end

local function start(profile, index: number)
	local mission = Missions.get(index)
	profile.mission = { index = index, base = if mission.kind == "stat" then statValue(profile, mission.stat) else 0 }
end

local function publish(player: Player, profile)
	local mission = Missions.get(profile.mission.index)
	local progress, goal = progressOf(profile, mission)
	player:SetAttribute("MissaoNumero", profile.mission.index)
	player:SetAttribute("MissaoTexto", mission.text)
	player:SetAttribute("MissaoProgresso", math.min(progress, goal))
	player:SetAttribute("MissaoMeta", goal)
	player:SetAttribute("MissaoPremio", mission.reward)
	player:SetAttribute("MissaoDica", mission.hint or "")
	player:SetAttribute("MissaoStat", if mission.kind == "stat" then mission.stat else nil)
	player:SetAttribute("MissaoUpgrade", if mission.kind == "upgrade" then mission.id else nil)
end

local function check(player: Player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local mission = Missions.get(profile.mission.index)
	local progress, goal = progressOf(profile, mission)
	if progress >= goal then
		DataService.addCoins(player, mission.reward)
		Notify.big(
			player,
			"✅ MISSÃO COMPLETA!",
			mission.text .. "   +💰 " .. Format.number(mission.reward),
			GREEN,
			"revelar"
		)
		start(profile, profile.mission.index + 1)
		DataService.push(player)
	end
	publish(player, profile)
end

function MissionService.setup(player: Player)
	local profile = DataService.get(player)
	if profile and (profile.mission.index or 0) < 1 then
		start(profile, 1)
	end
	check(player)
end

function MissionService.init()
	task.spawn(function()
		while true do
			task.wait(CHECK_EVERY)
			for _, player in Players:GetPlayers() do
				check(player)
			end
		end
	end)
end

return MissionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Notify</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local NotifyRemote = Remotes.event("Notify")

local Notify = {}

-- `sfx` é o nome de um som de Config.Sounds (opcional).
function Notify.toast(player: Player, text: string, color: Color3?, sfx: string?)
	NotifyRemote:FireClient(player, { kind = "toast", text = text, color = color, sfx = sfx })
end

function Notify.big(player: Player, title: string, subtitle: string?, color: Color3?, sfx: string?)
	NotifyRemote:FireClient(player, { kind = "big", text = title, sub = subtitle, color = color, sfx = sfx })
end

-- Janela "Bem-vindo de volta!" com o que a fazenda rendeu offline.
function Notify.welcome(player: Player, amount: number, seconds: number)
	NotifyRemote:FireClient(player, { kind = "welcome", amount = amount, seconds = seconds, sfx = "guardar" })
end

function Notify.bigAll(title: string, subtitle: string?, color: Color3?, sfx: string?)
	NotifyRemote:FireAllClients({ kind = "big", text = title, sub = subtitle, color = color, sfx = sfx })
end

function Notify.reveal(player: Player, payload)
	payload.kind = "reveal"
	NotifyRemote:FireClient(player, payload)
end

return Notify
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">PassService</string><ProtectedString name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GamePasses = require(ReplicatedStorage:WaitForChild("Shared").Config.GamePasses)
local Notify = require(script.Parent.Notify)

local PassService = {}

local listeners: { (Player, string) -> () } = {}

local function grant(player: Player, key: string)
	player:SetAttribute("Pass_" .. key, true)
	for _, listener in listeners do
		task.spawn(listener, player, key)
	end
end

function PassService.has(player: Player, key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

function PassService.onGranted(listener: (Player, string) -> ())
	table.insert(listeners, listener)
end

function PassService.load(player: Player)
	for _, key in GamePasses.order do
		local pass = GamePasses.byId[key]
		if pass.id > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if ok and owns then
				grant(player, key)
			end
		end
	end
end

function PassService.prompt(player: Player, key: string): (boolean, string?)
	local pass = GamePasses.byId[key]
	if not pass then
		return false, "Passe inválido"
	end
	if PassService.has(player, key) then
		return false, "Você já tem esse passe!"
	end
	if pass.id <= 0 then
		return false, "Em breve!"
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.id)
	return true, nil
end

function PassService.init()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased or not player.Parent then
			return
		end
		for _, key in GamePasses.order do
			local pass = GamePasses.byId[key]
			if pass.id == passId then
				grant(player, key)
				Notify.big(
					player,
					pass.emoji .. " " .. pass.name .. " ativado!",
					pass.desc,
					Color3.fromRGB(255, 205, 60)
				)
			end
		end
	end)
end

return PassService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">RouteService</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Materials = require(Shared.Config.Materials)
local Rarities = require(Shared.Config.Rarities)
local Routes = require(Shared.Config.Routes)
local Species = require(Shared.Config.Species)
local Guardians = require(Shared.Config.Guardians)
local Style = require(Shared.Style)

local Basket = require(script.Parent.Basket)
local DataService = require(script.Parent.DataService)
local FarmService = require(script.Parent.FarmService)
local GuardianService = require(script.Parent.GuardianService)
local Notify = require(script.Parent.Notify)
local PassService = require(script.Parent.PassService)
local Teleport = require(script.Parent.Teleport)

local RouteService = {}

local GOLDEN_INTERVAL = 12 * 60
local GOLDEN_DURATION = 2 * 60
local GOLDEN_RARE_BOOST = 3
local RESPAWN_MIN, RESPAWN_MAX = 6, 14
local TOUCH_COOLDOWN = 2
local NEST_HOLD = 1.5
-- Ninhal no meio de cada rota: 3 ninhos fixos, sempre visíveis. Os melhores pedem velocidade
-- mínima (velocidade do guardião da rota + extra) e dão muito mais sorte na raridade.
local NEST_TIERS = {
	{ name = "Ninho", emoji = "🥚", extra = nil, luck = 1, hold = 1.5, respawn = 12, egg = Color3.fromRGB(255, 248, 230), neon = false },
	{ name = "Ninho Raro", emoji = "💙", extra = 3, luck = 3, hold = 2, respawn = 25, egg = Color3.fromRGB(90, 160, 255), neon = false },
	{ name = "Ninho Dourado", emoji = "💛", extra = 9, luck = 8, hold = 2.5, respawn = 50, egg = Color3.fromRGB(255, 205, 50), neon = true },
}
local NEST_SPACING = 12
local NINHAL_CLEAR = 26 -- itens aleatórios não nascem em cima do Ninhal
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local GOLD = Color3.fromRGB(255, 205, 60)

local zones = {}
local rng = Random.new()
local lastTouch: { [Player]: number } = {}
local magnetic: { [Model]: { root: BasePart, take: (Player) -> boolean } } = {}

function RouteService.isGoldenHour(): boolean
	return (Workspace:GetAttribute("GoldenHourEnds") or 0) > Workspace:GetServerTimeNow()
end

local function piece(
	model: Model,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	shape: Enum.PartType?
): Part
	local part = Instance.new("Part")
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function glow(part: BasePart, color: Color3, rate: number)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = part
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLES
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.8, 1.5)
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.35, 0)
	emitter.Parent = part
end

local function buildNode(def, route): (Model, BasePart)
	local model = Instance.new("Model")
	local root: BasePart
	if def.nest then
		-- Ninho quadrado de palha, com borda e um ovo oval com pintinhas da cor da rota.
		model.Name = "Ninho"
		local straw = Color3.fromRGB(222, 180, 90)
		root = piece(model, Vector3.new(4.4, 0.6, 4.4), CFrame.new(0, 0.3, 0), straw, Enum.Material.Fabric)
		for i = 0, 3 do
			local side = CFrame.Angles(0, i * math.pi / 2, 0)
			piece(
				model,
				Vector3.new(4.4, 0.9, 0.9),
				side * CFrame.new(0, 0.95, 1.75),
				Style.shade(straw, -0.18),
				Enum.Material.Fabric
			)
		end
		local egg = piece(
			model,
			Vector3.one * 1.9,
			CFrame.new(0, 2, 0),
			Color3.fromRGB(255, 248, 230),
			Enum.Material.SmoothPlastic,
			Enum.PartType.Ball
		)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(1, 1.3, 1)
		mesh.Parent = egg
		for _, spot in { Vector3.new(0.62, 2.4, -0.6), Vector3.new(-0.7, 1.9, -0.45), Vector3.new(0.2, 2.9, 0.7) } do
			piece(model, Vector3.new(0.45, 0.45, 0.45), CFrame.new(spot), route.theme, Enum.Material.SmoothPlastic)
		end
		glow(egg, route.theme, 4)
	else
		local material = Materials.byId[def.material]
		model.Name = material.name
		if material.tier == 1 then
			-- Arbustinho em degraus com frutinhas quadradas.
			root = piece(
				model,
				Vector3.new(3, 1.4, 3),
				CFrame.new(0, 0.7, 0),
				Style.shade(route.foliage, -0.1),
				Enum.Material.Grass
			)
			piece(model, Vector3.new(2, 1.1, 2), CFrame.new(0, 1.95, 0), route.foliage, Enum.Material.Grass)
			for i = 0, 2 do
				local angle = i * math.pi * 2 / 3
				piece(
					model,
					Vector3.new(0.7, 0.7, 0.7),
					CFrame.new(math.cos(angle) * 1.2, 1.9 + (i % 2) * 0.7, math.sin(angle) * 1.2)
						* CFrame.Angles(0, angle, 0),
					material.color,
					Enum.Material.SmoothPlastic
				)
			end
		elseif material.tier == 2 then
			-- Caixote de madeira com faixas escuras e tampa colorida.
			local wood = Color3.fromRGB(190, 130, 70)
			root = piece(model, Vector3.one * 2.4, CFrame.new(0, 1.2, 0), wood, Enum.Material.WoodPlanks)
			for _, y in { 0.45, 1.95 } do
				piece(
					model,
					Vector3.new(2.55, 0.35, 2.55),
					CFrame.new(0, y, 0),
					Style.shade(wood, -0.3),
					Enum.Material.WoodPlanks
				)
			end
			piece(model, Vector3.new(2.6, 0.4, 2.6), CFrame.new(0, 2.6, 0), material.color, Enum.Material.SmoothPlastic)
		elseif material.tier == 3 then
			-- Pedra com uma gema de cubo girado brilhando em cima.
			root = piece(
				model,
				Vector3.new(2.6, 1.2, 2.6),
				CFrame.new(0, 0.6, 0) * CFrame.Angles(0, math.rad(20), 0),
				Color3.fromRGB(140, 145, 160),
				Enum.Material.Slate
			)
			piece(
				model,
				Vector3.new(1.6, 0.6, 1.6),
				CFrame.new(0.2, 1.5, 0.1) * CFrame.Angles(0, math.rad(50), 0),
				Color3.fromRGB(165, 170, 185),
				Enum.Material.Slate
			)
			local gem = piece(
				model,
				Vector3.one * 1.2,
				CFrame.new(0, 2.8, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
				material.color,
				Enum.Material.Neon
			)
			glow(gem, material.color, 5)
		else
			root = piece(
				model,
				Vector3.new(1.1, 4, 1.1),
				CFrame.new(0, 1.8, 0) * CFrame.Angles(0, math.rad(45), math.rad(8)),
				material.color,
				Enum.Material.Neon
			)
			piece(
				model,
				Vector3.new(0.7, 2.4, 0.7),
				CFrame.new(0.9, 1.1, 0.3) * CFrame.Angles(0, 0, math.rad(-25)),
				material.color,
				Enum.Material.Neon
			)
			piece(
				model,
				Vector3.new(0.6, 2, 0.6),
				CFrame.new(-0.8, 1, -0.4) * CFrame.Angles(math.rad(20), 0, math.rad(22)),
				material.color,
				Enum.Material.Neon
			)
			glow(root, material.color, 10)
		end
	end
	model.WorldPivot = CFrame.identity
	Style.apply(model)
	return model, root
end

local function pickDef(route, golden: boolean)
	local weights = {}
	for i, def in route.nodes do
		local boosted = def.nest or Materials.byId[def.material].tier >= 3
		weights[i] = if def.nest then 0 else def.weight * (if golden and boosted then GOLDEN_RARE_BOOST else 1)
	end
	return route.nodes[Balance.pickWeighted(weights, rng:NextNumber())]
end

local function randomNodeCFrame(zone): CFrame
	local half = zone.size / 2 - 10
	local spawnFlat = Vector3.new(zone.spawn.Position.X, 0, zone.spawn.Position.Z)
	local barnFlat = zone.origin + Vector3.new(-zone.size / 2 + 26, 0, zone.size / 2 - 26)
	local point = zone.origin
	for _ = 1, 30 do
		point = zone.origin + Vector3.new(rng:NextNumber(-half, half), 0, rng:NextNumber(-half, half))
		local clearOfNinhal = (point - zone.origin).Magnitude > NINHAL_CLEAR
		if (point - spawnFlat).Magnitude > 30 and (point - barnFlat).Magnitude > 16 and clearOfNinhal then
			break
		end
	end
	return CFrame.new(point) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
end

local function collect(player: Player, route, def, luckMult: number?): boolean
	local profile = DataService.get(player)
	if not profile or not profile.routes[route.id] then
		return false
	end
	local luck = Balance.luck(profile, PassService.has(player, "SorteDupla"), RouteService.isGoldenHour()) * (luckMult or 1)

	if def.nest then
		local rarity = Balance.rollRarity(luck, rng)
		local shiny = Balance.rollShiny(luck, rng)
		profile.stats.nests += 1
		local animal, soldFor = FarmService.addAnimal(player, route.species, rarity, shiny)
		local shown = animal or { id = "", species = route.species, rarity = rarity, shiny = shiny }
		Notify.reveal(player, {
			title = "🥚 NINHO ABERTO!",
			name = Balance.animalName(shown),
			color = Rarities.list[rarity].color,
			sub = if soldFor
				then "Fazenda cheia! Vendido por 💰 " .. Format.number(soldFor) .. " — aumente a fazenda na 🛒 Loja"
				else "Foi para a sua fazenda: +💰 " .. Format.rate(Balance.animalProduction(shown)) .. "/s",
		})
		return true
	end

	local material = Materials.byId[def.material]
	local amount = rng:NextInteger(def.min, def.max)
	local doubled = rng:NextNumber() < Balance.doubleDropChance(luck)
	if doubled then
		amount *= 2
	end
	amount += Balance.netBonus(profile, rng:NextNumber())
	-- Vai para a cesta: só vira material de verdade quando o jogador volta para a fazenda.
	amount = Basket.add(player, def.material, amount)
	profile.stats.collected += 1
	if material.tier >= 4 then
		Notify.big(
			player,
			"💎 CRISTAL ESTELAR!",
			"Material ultra-raro usado para criar animais Míticos",
			material.color
		)
	else
		Notify.toast(
			player,
			"+" .. amount .. " " .. material.emoji .. " " .. material.name .. (if doubled then "   🍀 x2!" else ""),
			material.color,
			"coleta"
		)
	end
	return true
end

local function spawnNode(routeId: string)
	local zone = zones[routeId]
	local route = Routes.byId[routeId]
	local def = pickDef(route, RouteService.isGoldenHour())
	local model, root = buildNode(def, route)
	model:PivotTo(randomNodeCFrame(zone))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = if def.nest then "Abrir ninho" else "Coletar"
	prompt.ObjectText = model.Name
	-- Ninho demora para abrir: é a janela em que o guardião chega correndo.
	prompt.HoldDuration = if def.nest then NEST_HOLD elseif Materials.byId[def.material].tier >= 3 then 0.6 else 0.3
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	local alertChance = if def.nest then 1 elseif Materials.byId[def.material].tier >= 3 then 0.5 else 0.15
	prompt.PromptButtonHoldBegan:Connect(function(player)
		GuardianService.alert(player, root.Position, alertChance)
	end)

	local taken = false
	local function take(player: Player): boolean
		if taken then
			return false
		end
		local profile = DataService.get(player)
		if not profile or not profile.routes[routeId] then
			return false
		end
		if not def.nest and Basket.space(player) <= 0 then
			Notify.toast(player, "🧺 Cesta cheia! Volte para a fazenda para guardar", Color3.fromRGB(255, 120, 100))
			return false
		end
		taken = true
		magnetic[model] = nil
		model:Destroy()
		collect(player, route, def)
		task.delay(rng:NextNumber(RESPAWN_MIN, RESPAWN_MAX), spawnNode, routeId)
		return true
	end
	prompt.Triggered:Connect(take)

	-- Itens comuns podem ser puxados pelo boost de ímã.
	if not def.nest and Materials.byId[def.material].tier <= 2 then
		magnetic[model] = { root = root, take = take }
	end
	model.Parent = zone.nodes
end

-- Ímã: coleta sozinho os itens comuns perto do jogador. Devolve quantos pegou.
function RouteService.pull(player: Player, position: Vector3, radius: number): number
	local count = 0
	for _, node in magnetic do
		if (node.root.Position - position).Magnitude <= radius and node.take(player) then
			count += 1
		end
	end
	return count
end

local function nestRequirement(routeId: string, tier): number?
	local guardian = Guardians.byRoute[routeId]
	return if tier.extra and guardian then guardian.speed + tier.extra else nil
end

local function nestSign(root: BasePart, tier, requirement: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Placa"
	gui.Size = UDim2.fromOffset(220, 70)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.MaxDistance = 260
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(1, 0.55)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.Text = tier.emoji .. " " .. string.upper(tier.name)
	title.TextColor3 = tier.egg:Lerp(Color3.new(1, 1, 1), 0.2)
	Style.outline(title, 3)
	title.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0, 0.55)
	sub.Size = UDim2.fromScale(1, 0.45)
	sub.Font = Enum.Font.FredokaOne
	sub.TextScaled = true
	sub.Text = if requirement then "precisa de ⚡" .. requirement else "qualquer um abre"
	sub.TextColor3 = Color3.new(1, 1, 1)
	Style.outline(sub, 2.5)
	sub.Parent = gui
	gui.Parent = root
end

local function spawnFixedNest(routeId: string, tierIndex: number)
	local zone = zones[routeId]
	local route = Routes.byId[routeId]
	local tier = NEST_TIERS[tierIndex]
	local requirement = nestRequirement(routeId, tier)
	local model, root = buildNode({ nest = true }, route)
	model.Name = "Ninho"
	model:SetAttribute("Requisito", requirement or 0)
	model:SetAttribute("Tipo", tier.name)
	-- Ovo da cor do ninho; o dourado brilha.
	for _, part in model:GetDescendants() do
		if part:IsA("Part") and part.Shape == Enum.PartType.Ball then
			part.Color = tier.egg
			if tier.neon then
				part.Material = Enum.Material.Neon
			end
		end
	end
	local offset = (tierIndex - 2) * NEST_SPACING
	model:PivotTo(CFrame.new(zone.origin + Vector3.new(offset, 0.8, 0)))
	nestSign(root, tier, requirement)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Abrir ninho"
	prompt.ObjectText = tier.name .. (if requirement then " (⚡" .. requirement .. ")" else "")
	prompt.HoldDuration = tier.hold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = root

	local function fastEnough(player: Player): boolean
		local profile = DataService.get(player)
		return profile ~= nil and (requirement == nil or Balance.walkSpeed(profile) >= requirement)
	end
	prompt.PromptButtonHoldBegan:Connect(function(player)
		if fastEnough(player) then
			GuardianService.alert(player, root.Position, 1)
		end
	end)
	local taken = false
	prompt.Triggered:Connect(function(player)
		local profile = DataService.get(player)
		if taken or not profile or not profile.routes[routeId] then
			return
		end
		if not fastEnough(player) then
			Notify.toast(player, "🔒 Precisa de ⚡" .. requirement .. " para o " .. tier.name .. ". Treine na esteira!", Color3.fromRGB(255, 120, 100))
			return
		end
		taken = true
		model:Destroy()
		collect(player, route, { nest = true }, tier.luck)
		task.delay(tier.respawn, spawnFixedNest, routeId, tierIndex)
	end)
	model.Parent = zone.nodes
end

function RouteService.travel(player: Player, target: string): (boolean, string?)
	if target == "Fazenda" then
		return FarmService.teleportHome(player)
	end
	local route = Routes.byId[target]
	local profile = DataService.get(player)
	if not route or not profile then
		return false, "Rota inválida"
	end
	if not profile.routes[target] then
		return false,
			"🔒 " .. route.name .. ": precisa de " .. Balance.requirementText(target) .. " + 💰 " .. Format.number(
				route.unlockCost
			) .. ". Desbloqueie no menu 🗺️ Rotas"
	end
	Teleport.to(player, zones[target].spawn)
	local species = Species.byId[route.species]
	Notify.big(
		player,
		species.emoji .. " " .. route.name,
		"Colete materiais e procure ninhos de " .. species.name .. "!",
		route.theme
	)
	return true, nil
end

function RouteService.unlock(player: Player, routeId: string): (boolean, string?)
	local profile = DataService.get(player)
	local ok, reason = Balance.canUnlockRoute(profile, profile.coins, routeId)
	if not ok then
		return false, reason
	end
	local route = Routes.byId[routeId]
	if not DataService.spendCoins(player, route.unlockCost) then
		return false, "Moedas insuficientes"
	end
	profile.routes[routeId] = true
	DataService.push(player)
	Notify.big(
		player,
		"🔓 " .. route.name .. " desbloqueada!",
		"Entre no portal ou toque em Ir no menu de rotas",
		route.theme
	)
	return true, nil
end

local function onPortalTouched(hit: BasePart, target: string)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player then
		return
	end
	local now = os.clock()
	if lastTouch[player] and now - lastTouch[player] < TOUCH_COOLDOWN then
		return
	end
	lastTouch[player] = now
	local ok, message = RouteService.travel(player, target)
	if not ok and message then
		Notify.toast(player, message, Color3.fromRGB(255, 120, 100))
	end
end

function RouteService.init(zoneMap, portals: { [string]: BasePart })
	zones = zoneMap
	for routeId, zone in zones do
		for _ = 1, Routes.byId[routeId].nodeCount do
			spawnNode(routeId)
		end
		for tierIndex = 1, #NEST_TIERS do
			spawnFixedNest(routeId, tierIndex)
		end
		zone.returnField.Touched:Connect(function(hit)
			onPortalTouched(hit, "Fazenda")
		end)
	end
	for routeId, field in portals do
		field.Touched:Connect(function(hit)
			onPortalTouched(hit, routeId)
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastTouch[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(GOLDEN_INTERVAL)
			Workspace:SetAttribute("GoldenHourEnds", Workspace:GetServerTimeNow() + GOLDEN_DURATION)
			Notify.bigAll("🌟 HORA DOURADA! 🌟", "Sorte x2 e itens raros aparecendo mais por 2 minutos!", GOLD)
		end
	end)
end

return RouteService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Teleport</string><ProtectedString name="Source"><![CDATA[local Teleport = {}

function Teleport.to(player: Player, target: CFrame): boolean
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return false
	end
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 3)
	end)
	if player.Character ~= character then
		return false
	end
	character:PivotTo(target + Vector3.new(0, 3, 0))
	return true
end

return Teleport
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">TrainingService</string><ProtectedString name="Source"><![CDATA[-- Treino na esteira: quem está em cima da lona corre sozinho (animação no cliente) e ganha
-- Balance.TRAIN_GAIN pontos por segundo; cada TRAIN_PER_SPEED pontos = +1 de velocidade.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Guardians = require(Shared.Config.Guardians)

local DataService = require(script.Parent.DataService)
local FarmService = require(script.Parent.FarmService)
local Notify = require(script.Parent.Notify)

local TrainingService = {}

local TICK = 0.5
local SECONDS_PER_GAIN = 1

local belts: { BasePart } = {}
local progress: { [Player]: number } = {}

local function onBelt(root: BasePart): boolean
	for _, belt in belts do
		local rel = belt.CFrame:PointToObjectSpace(root.Position)
		if math.abs(rel.X) <= belt.Size.X / 2 + 0.3 and math.abs(rel.Z) <= belt.Size.Z / 2 and rel.Y > 0 and rel.Y < 5 then
			return true
		end
	end
	return false
end

local function tick(player: Player)
	local profile = DataService.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not profile or not root then
		return
	end
	local training = onBelt(root)
	if player:GetAttribute("NaEsteira") ~= training then
		player:SetAttribute("NaEsteira", training)
	end
	if not training or (profile.training or 0) >= Balance.TRAIN_MAX then
		return
	end
	progress[player] = (progress[player] or 0) + TICK
	if progress[player] < SECONDS_PER_GAIN then
		return
	end
	progress[player] = 0
	local before = Balance.trainedSpeed(profile)
	local oldSpeed = Balance.walkSpeed(profile)
	profile.training = math.min((profile.training or 0) + Balance.trainGain(profile), Balance.TRAIN_MAX)
	player:SetAttribute("Treino", profile.training)
	if Balance.trainedSpeed(profile) > before then
		FarmService.applySpeed(player)
		DataService.push(player)
		local speed = Balance.walkSpeed(profile)
		-- Comemora quando passa um guardião: é aí que o treino faz diferença na hora de fugir.
		local passed = nil
		for _, routeId in Guardians.order do
			local guardian = Guardians.byRoute[routeId]
			if oldSpeed <= guardian.speed and speed > guardian.speed then
				passed = guardian
			end
		end
		if passed then
			Notify.big(
				player,
				"⚡ VELOCIDADE " .. speed .. "!",
				"Agora você corre mais que o " .. passed.emoji .. " " .. passed.name .. " (⚡" .. passed.speed .. ")",
				Color3.fromRGB(120, 230, 255),
				"revelar"
			)
		else
			Notify.toast(player, "⚡ +1 de velocidade! Agora: " .. speed, Color3.fromRGB(120, 230, 255), "boost")
		end
	end
end

function TrainingService.setup(player: Player)
	local profile = DataService.get(player)
	player:SetAttribute("Treino", if profile then profile.training or 0 else 0)
	player:SetAttribute("TreinoMax", Balance.TRAIN_MAX)
end

function TrainingService.init(plots)
	for _, plot in plots do
		table.insert(belts, plot.treadmill)
	end
	task.spawn(function()
		while true do
			task.wait(TICK)
			for _, player in Players:GetPlayers() do
				tick(player)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		progress[player] = nil
	end)
end

return TrainingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">TreasureService</string><ProtectedString name="Source"><![CDATA[-- Baú do Tesouro no topo da árvore de cada rota. Cada jogador pode abrir a cada 5 minutos.
-- Os itens vão para a cesta (ainda precisa levar para casa); as moedas entram na hora.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Materials = require(Shared.Config.Materials)
local Routes = require(Shared.Config.Routes)

local Basket = require(script.Parent.Basket)
local DataService = require(script.Parent.DataService)
local Notify = require(script.Parent.Notify)

local TreasureService = {}

local COOLDOWN = 5 * 60
local RARE_AMOUNT = 3
local CRYSTAL_CHANCE = 0.35
local COINS_PER_ROUTE = 150
local GOLD = Color3.fromRGB(255, 200, 50)

local opened: { [Player]: { [string]: number } } = {}
local rng = Random.new()

local function rareMaterial(route): string?
	for _, def in route.nodes do
		if def.material and Materials.byId[def.material].tier == 3 then
			return def.material
		end
	end
	return nil
end

local function open(player: Player, routeId: string, index: number)
	local profile = DataService.get(player)
	if not profile or not profile.routes[routeId] then
		return
	end
	local mine = opened[player] or {}
	opened[player] = mine
	local last = mine[routeId]
	local wait = if last then last + COOLDOWN - os.clock() else 0
	if wait > 0 then
		Notify.toast(player, "⏳ O baú enche de novo em " .. Format.time(wait), GOLD)
		return
	end
	mine[routeId] = os.clock()
	profile.stats.chests = (profile.stats.chests or 0) + 1
	profile.stats["chest_" .. routeId] = (profile.stats["chest_" .. routeId] or 0) + 1

	local route = Routes.byId[routeId]
	local parts = {}
	local material = rareMaterial(route)
	if material then
		local added = Basket.add(player, material, RARE_AMOUNT)
		if added > 0 then
			table.insert(parts, "+" .. added .. " " .. Materials.byId[material].emoji)
		end
	end
	if rng:NextNumber() < CRYSTAL_CHANCE and Basket.add(player, "CristalEstelar", 1) > 0 then
		table.insert(parts, "+1 💎")
	end
	local coins = COINS_PER_ROUTE * index
	DataService.addCoins(player, coins)
	DataService.push(player)
	table.insert(parts, "+💰 " .. Format.number(coins))
	Notify.big(player, "🎁 BAÚ DO TESOURO!", table.concat(parts, "   ") .. "   • leve a cesta para casa!", GOLD, "revelar")
end

function TreasureService.init(zones)
	for index, routeId in Routes.order do
		local zone = zones[routeId]
		if zone and zone.treasure then
			local prompt = Instance.new("ProximityPrompt")
			prompt.ActionText = "Abrir baú"
			prompt.ObjectText = "Baú do Tesouro"
			prompt.HoldDuration = 1
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt.Parent = zone.treasure
			prompt.Triggered:Connect(function(player)
				open(player, routeId, index)
			end)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		opened[player] = nil
	end)
end

return TreasureService
]]></ProtectedString></Properties></Item></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX0000003D"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000003C"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000003B"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local State = require(script.State)
local World = require(script.World)
local Guide = require(script.Guide)
local Effects = require(script.Effects)
local DoubleJump = require(script.DoubleJump)
local Sfx = require(script.Sfx)
local Treadmill = require(script.Treadmill)
local Punch = require(script.Punch)
local Rainbow = require(script.Rainbow)
local Welcome = require(script.UI.Welcome)
local MissionPanel = require(script.UI.MissionPanel)
local TrainingPanel = require(script.UI.TrainingPanel)
local Hud = require(script.UI.Hud)
local Kit = require(script.UI.Kit)
local Notifications = require(script.UI.Notifications)
local Panel = require(script.UI.Panel)
local Pages = script.UI.Pages

local player = Players.LocalPlayer

local PAGES = {
	{ id = "Animais", title = "🐔 Meus Animais", color = Kit.colors.green, render = require(Pages.Animais) },
	{ id = "Rotas", title = "🗺️ Rotas", color = Kit.colors.blue, render = require(Pages.Rotas) },
	{ id = "Loja", title = "🛒 Loja", color = Kit.colors.yellow, render = require(Pages.Loja) },
	{ id = "Indice", title = "📖 Índice", color = Color3.fromRGB(165, 100, 225), render = require(Pages.Indice) },
	{ id = "Mochila", title = "🎒 Mochila", color = Color3.fromRGB(180, 120, 70), render = require(Pages.Mochila) },
}

local gui = Kit.new("ScreenGui", {
	Name = "FazendaUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local scales: { UIScale } = {}
local panels = {}
local renderers = {}
local current: string? = nil

local function closeAll()
	for _, panel in panels do
		panel:setVisible(false)
	end
	current = nil
end

local function act(action: string, arg: string?): (boolean, any)
	local ok, result = State.request(action, arg)
	if ok and (action == "BuyUpgrade" or action == "UnlockRoute" or action == "Sell") then
		Sfx.play("comprar")
	end
	if type(result) == "string" then
		Notifications.toast(result, if ok then Kit.colors.green else Kit.colors.red)
	end
	return ok, result
end

local baseCtx = { act = act, close = closeAll }

local function renderCurrent()
	if current and State.profile then
		panels[current]:render(renderers[current], State.profile, baseCtx, State.coins())
	end
end

local function open(id: string)
	if current == id then
		closeAll()
		return
	end
	closeAll()
	current = id
	panels[id]:setVisible(true)
	renderCurrent()
end

for _, page in PAGES do
	local panel = Panel.new(gui, page.title, page.color, closeAll)
	panels[page.id] = panel
	renderers[page.id] = page.render
	table.insert(scales, panel.scale)
end

Hud.mount(gui, scales, {
	{
		id = "Animais",
		emoji = "🐔",
		label = "Animais",
		color = Kit.colors.green,
		onClick = function()
			open("Animais")
		end,
	},
	{
		id = "Rotas",
		emoji = "🗺️",
		label = "Rotas",
		color = Kit.colors.blue,
		onClick = function()
			open("Rotas")
		end,
	},
	{
		id = "Loja",
		emoji = "🛒",
		label = "Loja",
		color = Kit.colors.yellow,
		onClick = function()
			open("Loja")
		end,
	},
	{
		id = "Indice",
		emoji = "📖",
		label = "Índice",
		color = Color3.fromRGB(165, 100, 225),
		onClick = function()
			open("Indice")
		end,
	},
	{
		id = "Mochila",
		emoji = "🎒",
		label = "Mochila",
		color = Color3.fromRGB(180, 120, 70),
		onClick = function()
			open("Mochila")
		end,
	},
	{
		id = "Fazenda",
		emoji = "🏡",
		label = "Fazenda",
		color = Color3.fromRGB(120, 170, 70),
		onClick = function()
			act("Travel", "Fazenda")
		end,
	},
})

Notifications.mount(gui, scales)
MissionPanel.mount(gui, scales)
TrainingPanel.mount(gui, scales)

local camera = Workspace.CurrentCamera
local function rescale()
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min(viewport.X / 1000, viewport.Y / 640), 0.5, 1)
	for _, uiScale in scales do
		uiScale.Scale = scale
	end
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

Remotes.event("Notify").OnClientEvent:Connect(function(payload)
	Sfx.play(payload.sfx or (if payload.kind == "reveal" then "revelar" else nil))
	if payload.kind == "welcome" then
		Welcome.show(gui, scales, payload.amount, payload.seconds)
	elseif payload.kind == "toast" then
		Notifications.toast(payload.text, payload.color)
	elseif payload.kind == "big" then
		Notifications.big(payload.text, payload.sub, payload.color)
	elseif payload.kind == "reveal" then
		Notifications.reveal(payload)
	end
end)

State.onProfile(function()
	renderCurrent()
	Hud.tick()
end)

State.onCoins(function(coins)
	Hud.setCoins(coins)
	if current then
		panels[current]:refreshCosts(coins)
	end
end)

State.start()
World.start()
Guide.start()
Effects.start()
DoubleJump.start()
Sfx.start()
Treadmill.start()
Punch.start()
Rainbow.start()

-- Galo cantando quando o Galo Bravo começa a correr atrás de você.
player:GetAttributeChangedSignal("Perseguido"):Connect(function()
	local chaser = player:GetAttribute("Perseguido")
	if chaser and string.find(chaser, "Galo", 1, true) then
		Sfx.play("galo")
	end
end)

while true do
	Hud.tick()
	Guide.update()
	MissionPanel.tick()
	TrainingPanel.tick()
	task.wait(0.5)
end
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">DoubleJump</string><ProtectedString name="Source"><![CDATA[-- Pulo duplo/triplo das Botas de Pulo. JumpRequest dispara tanto no teclado quanto no
-- botão de pular do celular. Os pulos extras recarregam ao encostar no chão.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Balance = require(ReplicatedStorage:WaitForChild("Shared").Balance)

local Sfx = require(script.Parent.Sfx)
local State = require(script.Parent.State)

local DoubleJump = {}

local MIN_AIR_TIME = 0.18 -- evita gastar o pulo extra no mesmo toque do pulo normal

local player = Players.LocalPlayer
local used = 0
local leftGround = 0

local function puff(root: BasePart)
	local cloud = Instance.new("Part")
	cloud.Size = Vector3.new(0.2, 2.6, 2.6)
	cloud.Shape = Enum.PartType.Cylinder
	cloud.Color = Color3.new(1, 1, 1)
	cloud.Material = Enum.Material.SmoothPlastic
	cloud.Transparency = 0.2
	cloud.Anchored = true
	cloud.CanCollide = false
	cloud.CanQuery = false
	cloud.CanTouch = false
	cloud.CFrame = CFrame.new(root.Position - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	cloud.Parent = workspace.CurrentCamera
	local start = os.clock()
	task.spawn(function()
		while os.clock() - start < 0.35 do
			local t = (os.clock() - start) / 0.35
			cloud.Size = Vector3.new(0.2, 2.6 + t * 3, 2.6 + t * 3)
			cloud.Transparency = 0.2 + t * 0.8
			task.wait()
		end
		cloud:Destroy()
	end)
end

local function watch(character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	used = 0
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			used = 0
		elseif new == Enum.HumanoidStateType.Freefall or new == Enum.HumanoidStateType.Jumping then
			if leftGround == 0 or used == 0 then
				leftGround = os.clock()
			end
		end
	end)
end

function DoubleJump.start()
	if player.Character then
		task.spawn(watch, player.Character)
	end
	player.CharacterAdded:Connect(watch)

	UserInputService.JumpRequest:Connect(function()
		local profile = State.profile
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not profile or not humanoid or not root or humanoid.PlatformStand then
			return
		end
		local state = humanoid:GetState()
		local inAir = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
		if not inAir or os.clock() - leftGround < MIN_AIR_TIME then
			return
		end
		if used >= Balance.extraJumps(profile) then
			return
		end
		used += 1
		-- Mesma velocidade de subida de um pulo normal com a altura atual.
		local rise = math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)
		root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, rise, root.AssemblyLinearVelocity.Z)
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		puff(root)
		Sfx.play("pulo")
	end)
end

return DoubleJump
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Efeitos pedidos pelo servidor que precisam rodar no cliente (o personagem é do cliente).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Style = require(Shared.Style)

local Punch = require(script.Parent.Punch)
local Sfx = require(script.Parent.Sfx)

local Effects = {}

local KNOCK_SPEED = 55
local KNOCK_LIFT = 32
local DIZZY_SECONDS = 1.2

local player = Players.LocalPlayer

-- Estrelinhas girando em cima da cabeça enquanto está tonto.
local function dizzy(head: BasePart)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(3, 1.5)
	gui.StudsOffset = Vector3.new(0, 2.4, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = "💫💫"
	label.TextScaled = true
	Style.outline(label, 2)
	label.Parent = gui
	gui.Parent = head
	TweenService:Create(label, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Rotation = 12,
	}):Play()
	task.delay(DIZZY_SECONDS + 0.3, function()
		gui:Destroy()
	end)
end

local function knock(from: Vector3)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	local away = Vector3.new(root.Position.X - from.X, 0, root.Position.Z - from.Z)
	away = if away.Magnitude > 0.1 then away.Unit else -root.CFrame.LookVector

	Sfx.play("empurrao")
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = away * KNOCK_SPEED + Vector3.new(0, KNOCK_LIFT, 0)
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		dizzy(head)
	end
	-- Tremidinha na câmera.
	task.spawn(function()
		for i = 1, 8 do
			humanoid.CameraOffset = Vector3.new(math.random(-10, 10), math.random(-10, 10), 0) / (20 + i * 4)
			task.wait(0.03)
		end
		humanoid.CameraOffset = Vector3.zero
	end)
	task.delay(DIZZY_SECONDS, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

function Effects.start()
	Remotes.event("Effect").OnClientEvent:Connect(function(payload)
		if payload.kind == "knock" then
			knock(payload.from)
		elseif payload.kind == "pow" then
			Punch.pow(payload.at)
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[-- Diz ao jogador o que fazer agora, em poucas palavras, e mostra o caminho:
-- trilha de bolinhas no chão + seta pulando em cima do objetivo, ou seta num botão do menu.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Rarities = require(Shared.Config.Rarities)
local Routes = require(Shared.Config.Routes)
local Style = require(Shared.Style)
local Upgrades = require(Shared.Config.Upgrades)

local State = require(script.Parent.State)
local Hud = require(script.Parent.UI.Hud)

local Guide = {}

local DOT_COUNT = 22
local DOT_SPACING = 4
local DOT_SPEED = 6
local STOP_DISTANCE = 6
local ZONE_MARGIN = 30

local player = Players.LocalPlayer
local target: Vector3? = nil
local dots: { BasePart } = {}
local arrowAnchor: BasePart
local arrowGui: BillboardGui

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function currentZone(position: Vector3): string?
	for _, routeId in Routes.order do
		local route = Routes.byId[routeId]
		local offset = position - route.origin
		local half = route.size / 2 + ZONE_MARGIN
		if math.abs(offset.X) < half and math.abs(offset.Z) < half then
			return routeId
		end
	end
	return nil
end

local function nearestNode(routeId: string, from: Vector3, nestsOnly: boolean, speed: number?): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local zones = world and world:FindFirstChild("Rotas")
	local zone = zones and zones:FindFirstChild(routeId)
	local nodes = zone and zone:FindFirstChild("Nos")
	if not nodes then
		return nil
	end
	local best: Vector3? = nil
	local bestDistance = math.huge
	for _, node in nodes:GetChildren() do
		local reachable = (node:GetAttribute("Requisito") or 0) <= (speed or math.huge)
		local wanted = if nestsOnly then node.Name == "Ninho" and reachable else node.Name ~= "Ninho"
		if node:IsA("Model") and wanted then
			local position = node:GetPivot().Position
			local distance = (position - from).Magnitude
			if distance < bestDistance then
				best, bestDistance = position, distance
			end
		end
	end
	return best
end

local function nearestGuardian(routeId: string, from: Vector3): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local zones = world and world:FindFirstChild("Rotas")
	local zone = zones and zones:FindFirstChild(routeId)
	local folder = zone and zone:FindFirstChild("Guardioes")
	local best: Vector3? = nil
	local bestDistance = math.huge
	for _, model in (if folder then folder:GetChildren() else {}) do
		if model:IsA("Model") then
			local position = model:GetPivot().Position
			if (position - from).Magnitude < bestDistance then
				best, bestDistance = position, (position - from).Magnitude
			end
		end
	end
	return best
end

local function bossPosition(routeId: string): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local zones = world and world:FindFirstChild("Rotas")
	local zone = zones and zones:FindFirstChild(routeId)
	local boss = zone and zone:FindFirstChild("Chefe")
	return if boss then (boss :: Model):GetPivot().Position else nil
end

local function portalPosition(routeId: string): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local portals = world and world:FindFirstChild("Portais")
	local portal = portals and portals:FindFirstChild(routeId)
	local field = portal and portal:FindFirstChild("Campo")
	return if field then (field :: BasePart).Position else nil
end

local function returnPortalPosition(routeId: string): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local zones = world and world:FindFirstChild("Rotas")
	local zone = zones and zones:FindFirstChild(routeId)
	local portal = zone and zone:FindFirstChild("Retorno")
	local field = portal and portal:FindFirstChild("Campo")
	return if field then (field :: BasePart).Position else nil
end

local function safeZonePosition(routeId: string): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local zones = world and world:FindFirstChild("Rotas")
	local zone = zones and zones:FindFirstChild(routeId)
	local safe = zone and zone:FindFirstChild("ZonaSegura")
	return if safe then (safe :: BasePart).Position else nil
end

-- Esteira da fazenda deste jogador (a placa do lote tem o nome dele).
local function myTreadmill(): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local lotes = world and world:FindFirstChild("Lotes")
	if not lotes then
		return nil
	end
	for _, lote in lotes:GetChildren() do
		for _, label in lote:GetDescendants() do
			if label:IsA("TextLabel") and label.Name == "Dono" and string.find(label.Text, player.DisplayName, 1, true) then
				local belt = lote:FindFirstChild("Esteira") and lote.Esteira:FindFirstChild("Lona")
				return if belt then (belt :: BasePart).Position else nil
			end
		end
	end
	return nil
end

local function treasurePosition(routeId: string): Vector3?
	local world = Workspace:FindFirstChild("Mundo")
	local zones = world and world:FindFirstChild("Rotas")
	local zone = zones and zones:FindFirstChild(routeId)
	local tree = zone and zone:FindFirstChild("ArvoreDoTesouro")
	local chest = tree and tree:FindFirstChild("Bau")
	return if chest then (chest :: BasePart).Position else nil
end

-- Materiais guardados + o que está na cesta: "se eu levar isso para casa, dá para evoluir?".
local function withBasket(profile)
	local ok, basket = pcall(HttpService.JSONDecode, HttpService, player:GetAttribute("CestaItens") or "{}")
	if not ok or type(basket) ~= "table" or next(basket) == nil then
		return profile
	end
	local merged = table.clone(profile.materials)
	for materialId, amount in basket do
		merged[materialId] = (merged[materialId] or 0) + amount
	end
	return setmetatable({ materials = merged }, { __index = profile })
end

local function canEvolveSomething(profile, coins: number): boolean
	for _, animal in profile.animals do
		if animal.rarity < Rarities.MAX then
			local cost = Balance.evolveCost(animal.species, animal.rarity)
			if cost and Balance.missingForCost(profile, coins, cost) then
				return true
			end
		end
	end
	return false
end

local function canUnlockNextRoute(profile, coins: number): boolean
	for _, routeId in Routes.order do
		if not profile.routes[routeId] then
			return (Balance.canUnlockRoute(profile, coins, routeId))
		end
	end
	return false
end

local function bestUnlockedRoute(profile): string
	local best = Routes.order[1]
	for _, routeId in Routes.order do
		if profile.routes[routeId] then
			best = routeId
		end
	end
	return best
end

-- Decide o próximo passo: texto curtinho + um botão OU um lugar no mapa.
function Guide.update()
	local profile = State.profile
	local root = rootPart()
	if not profile or not root then
		return
	end
	local coins = State.coins()
	local zone = currentZone(root.Position)

	local text: string
	local button: string? = nil
	local place: Vector3? = nil
	local chaser = player:GetAttribute("Perseguido")
	local hint = player:GetAttribute("MissaoDica")
	local mission = player:GetAttribute("MissaoTexto") or ""
	local missionUpgrade = player:GetAttribute("MissaoUpgrade")
	local basket = player:GetAttribute("Cesta") or 0
	local basketFull = basket >= (player:GetAttribute("CestaMax") or math.huge)
	local bossRoute = Workspace:GetAttribute("ChefeRota")
	local bossName = Workspace:GetAttribute("ChefeNome") or "Chefão"
	if bossRoute and zone == bossRoute and not chaser then
		text, place = "⚔️ Bata no " .. bossName .. " com 👊 (F)!", bossPosition(bossRoute)
	elseif bossRoute and not zone and profile.routes[bossRoute] then
		text, place = "⚔️ Chefão! Entre no portal e ajude!", portalPosition(bossRoute)
	elseif player:GetAttribute("NaEsteira") then
		local points = player:GetAttribute("Treino") or 0
		if points >= (player:GetAttribute("TreinoMax") or math.huge) then
			text = "🏃 Treino completo! Velocidade máxima"
		else
			text = "🏃 Treinando! " .. (points % Balance.TRAIN_PER_SPEED) .. "/" .. Balance.TRAIN_PER_SPEED .. " para +1 velocidade"
		end
	elseif chaser then
		text = "🏃 Fuja para a zona segura ou 👊 bata (F)!"
		place = if zone then safeZonePosition(zone) else nil
	elseif zone and basketFull then
		text, place = "🧺 Cesta cheia! Volte para casa!", returnPortalPosition(zone)
	elseif zone and basket > 0 and not canEvolveSomething(profile, coins) and canEvolveSomething(withBasket(profile), coins) then
		text, place = "🧺 Leve a cesta para casa!", returnPortalPosition(zone)
	elseif hint == "esteira" and not zone then
		text, place = "🏃 " .. mission, myTreadmill()
	elseif hint == "loja" and missionUpgrade and coins >= Upgrades.cost(missionUpgrade, profile.upgrades[missionUpgrade] or 0) then
		text, button = "🛒 " .. mission, "Loja"
	elseif hint == "tesouro" and zone then
		text, place = "💎 Suba até o baú no topo da árvore!", treasurePosition(zone)
	elseif canEvolveSomething(profile, coins) then
		text, button = "⬆️ Evolua seu animal!", "Animais"
	elseif canUnlockNextRoute(profile, coins) then
		text, button = "🗺️ Libere uma rota nova!", "Rotas"
	elseif zone then
		-- Dentro da rota o guia segue o que a missão pede.
		local stat = player:GetAttribute("MissaoStat")
		local nest = nearestNode(zone, root.Position, true, Balance.walkSpeed(profile))
		local guardian = if type(stat) == "string" and string.sub(stat, 1, 3) == "ko_" then nearestGuardian(zone, root.Position) else nil
		if guardian then
			text, place = "👊 Bata no bicho 3 vezes (F)!", guardian
		elseif stat == "collected" or not nest then
			text, place = "✨ Colete os itens!", nearestNode(zone, root.Position, false)
		else
			text, place = "🥚 Abra o ninho!", nest
		end
	else
		text, place = "🌀 Entre no portal!", portalPosition(bestUnlockedRoute(profile))
	end

	Hud.setObjective(text)
	Hud.point(button)
	target = place
end

local function makeDot(parent: Instance): BasePart
	local dot = Instance.new("Part")
	dot.Name = "Trilha"
	-- Disco branco deitado no chão (sem Neon: com o Bloom ele virava uma bola de luz).
	dot.Shape = Enum.PartType.Cylinder
	dot.Size = Vector3.new(0.2, 1.8, 1.8)
	dot.Material = Enum.Material.SmoothPlastic
	dot.Color = Color3.new(1, 1, 1)
	dot.Anchored = true
	dot.CanCollide = false
	dot.CanQuery = false
	dot.CanTouch = false
	dot.CastShadow = false
	dot.Parent = parent
	return dot
end

local function render()
	local root = rootPart()
	local goal = target
	local show = root ~= nil and goal ~= nil
	arrowGui.Enabled = show
	if not show then
		for _, dot in dots do
			dot.Transparency = 1
		end
		return
	end
	local from = (root :: BasePart).Position - Vector3.new(0, 2.4, 0)
	local to = goal :: Vector3
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local distance = flat.Magnitude
	local direction = if distance > 0 then flat.Unit else Vector3.zero
	local phase = (os.clock() * DOT_SPEED) % DOT_SPACING

	for i, dot in dots do
		local along = i * DOT_SPACING - phase
		if along > 0 and along < distance - STOP_DISTANCE then
			local height = from.Y + (to.Y - from.Y) * math.clamp(along / distance, 0, 1)
			dot.CFrame = CFrame.new(Vector3.new(from.X, height, from.Z) + direction * along)
				* CFrame.Angles(0, 0, math.rad(90))
			-- Some aos poucos perto do jogador e no fim da trilha.
			dot.Transparency = math.clamp(1 - along / 6, 0, 0.8) + math.clamp((i - DOT_COUNT + 4) / 5, 0, 1)
		else
			dot.Transparency = 1
		end
	end

	arrowAnchor.Position = to + Vector3.new(0, 7 + math.abs(math.sin(os.clock() * 4)) * 2.5, 0)
end

function Guide.start()
	local folder = Instance.new("Folder")
	folder.Name = "Guia"
	folder.Parent = Workspace.CurrentCamera

	for i = 1, DOT_COUNT do
		dots[i] = makeDot(folder)
	end

	arrowAnchor = Instance.new("Part")
	arrowAnchor.Name = "SetaAlvo"
	arrowAnchor.Anchored = true
	arrowAnchor.CanCollide = false
	arrowAnchor.CanQuery = false
	arrowAnchor.CanTouch = false
	arrowAnchor.Transparency = 1
	arrowAnchor.Size = Vector3.one
	arrowAnchor.Parent = folder

	arrowGui = Instance.new("BillboardGui")
	arrowGui.Size = UDim2.fromScale(6, 6)
	arrowGui.AlwaysOnTop = true
	arrowGui.LightInfluence = 0
	arrowGui.Enabled = false
	arrowGui.Parent = arrowAnchor
	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromScale(1, 1)
	arrow.Font = Enum.Font.FredokaOne
	arrow.Text = "▼"
	arrow.TextScaled = true
	arrow.TextColor3 = Color3.fromRGB(255, 220, 60)
	Style.outline(arrow, 4)
	arrow.Parent = arrowGui

	RunService.RenderStepped:Connect(render)
end

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Punch</string><ProtectedString name="Source"><![CDATA[-- 👊 Bater: tecla F (ou botão X do controle) e um botão na tela do celular.
-- O cliente só faz o avanço e a animação; quem decide se acertou é o servidor (GuardianService.hit).
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Remotes)

local Sfx = require(script.Parent.Sfx)

local Punch = {}

local COOLDOWN = 0.7
local LUNGE = 28

local player = Players.LocalPlayer
local last = 0

local function swing()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root or humanoid.PlatformStand then
		return
	end
	-- Animação de golpe que já vem no Animate do Roblox (toolslash), se existir.
	local animate = character:FindFirstChild("Animate")
	local slash = animate and animate:FindFirstChild("toolslash")
	local animation = slash and slash:FindFirstChildOfClass("Animation")
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if animation and animator then
		local track = animator:LoadAnimation(animation)
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.05, 1, 1.4)
	end
	-- Pequeno avanço para a frente, dá a sensação de soco.
	local forward = root.CFrame.LookVector
	root.AssemblyLinearVelocity = Vector3.new(forward.X * LUNGE, root.AssemblyLinearVelocity.Y, forward.Z * LUNGE)
end

local function onAction(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	local now = os.clock()
	if now - last < COOLDOWN then
		return Enum.ContextActionResult.Sink
	end
	last = now
	swing()
	Remotes.event("Bater"):FireServer()
	return Enum.ContextActionResult.Sink
end

function Punch.start()
	ContextActionService:BindAction("Bater", onAction, true, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("Bater", "👊")
	ContextActionService:SetPosition("Bater", UDim2.new(1, -170, 1, -150))
end

-- "💥 POW!" onde o golpe acertou (o servidor manda quando acerta).
function Punch.pow(at: Vector3)
	Sfx.play("empurrao")
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(at + Vector3.new(0, 5, 0))
	anchor.Parent = workspace.CurrentCamera
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(7, 3)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = "💥 POW!"
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 60)
	label.TextStrokeTransparency = 0
	label.Rotation = math.random(-12, 12)
	label.Parent = gui
	task.delay(0.6, function()
		anchor:Destroy()
	end)
end

return Punch
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Rainbow</string><ProtectedString name="Source"><![CDATA[-- Peças marcadas com a tag de arco-íris (animais Míticos) trocam de cor sem parar.
-- Roda no cliente para não mandar mudança de cor pela rede a cada quadro.
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnimalModel = require(ReplicatedStorage:WaitForChild("Shared").AnimalModel)

local Rainbow = {}

local SPEED = 0.25 -- voltas no círculo de cores por segundo

function Rainbow.start()
	RunService.RenderStepped:Connect(function()
		local base = os.clock() * SPEED
		for index, part in CollectionService:GetTagged(AnimalModel.RAINBOW_TAG) do
			if part:IsA("BasePart") then
				-- Cada peça um pouco defasada: o arco-íris "corre" pelo corpo.
				part.Color = Color3.fromHSV((base + index * 0.07) % 1, 0.75, 1)
			end
		end
	end)
end

return Rainbow
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[-- Toca os efeitos sonoros só para este jogador (SoundService:PlayLocalSound).
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Sounds = require(ReplicatedStorage:WaitForChild("Shared").Config.Sounds)

local Sfx = {}

local cache: { [string]: Sound } = {}

function Sfx.play(name: string?)
	local sound = name and cache[name]
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end

function Sfx.start()
	local folder = Instance.new("Folder")
	folder.Name = "Efeitos"
	folder.Parent = SoundService
	local list = {}
	for name, def in Sounds do
		local sound = Instance.new("Sound")
		sound.Name = name
		sound.SoundId = def.id
		sound.Volume = def.volume
		sound.Parent = folder
		cache[name] = sound
		table.insert(list, sound)
	end
	task.spawn(function()
		pcall(ContentProvider.PreloadAsync, ContentProvider, list)
	end)
end

return Sfx
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Remotes = require(Shared.Remotes)

local player = Players.LocalPlayer
local Request = Remotes.func("Request")

local State = {}
State.profile = nil :: any

local listeners: { (any) -> () } = {}

local function setProfile(profile)
	State.profile = profile
	for _, listener in listeners do
		task.spawn(listener, profile)
	end
end

function State.onProfile(listener: (any) -> ())
	table.insert(listeners, listener)
	if State.profile then
		task.spawn(listener, State.profile)
	end
end

function State.onCoins(listener: (number) -> ())
	task.spawn(function()
		local leaderstats = player:WaitForChild("leaderstats")
		local coins = leaderstats:WaitForChild("Moedas") :: NumberValue
		listener(coins.Value)
		coins.Changed:Connect(listener)
	end)
end

function State.request(action: string, arg: string?): (boolean, any)
	local ok, success, result = pcall(function()
		return Request:InvokeServer(action, arg)
	end)
	if not ok then
		return false, "Sem conexão com o servidor"
	end
	return success, result
end

function State.coins(): number
	local leaderstats = player:FindFirstChild("leaderstats")
	local coins = leaderstats and leaderstats:FindFirstChild("Moedas")
	return if coins then (coins :: NumberValue).Value else 0
end

function State.hasPass(key: string): boolean
	return player:GetAttribute("Pass_" .. key) == true
end

function State.goldenHourEnds(): number
	return Workspace:GetAttribute("GoldenHourEnds") or 0
end

function State.isGoldenHour(): boolean
	return State.goldenHourEnds() > Workspace:GetServerTimeNow()
end

function State.production(): number
	return if State.profile then Balance.totalProduction(State.profile, State.hasPass("VIP")) else 0
end

function State.luck(): number
	return if State.profile then Balance.luck(State.profile, State.hasPass("SorteDupla"), State.isGoldenHour()) else 1
end

function State.capacity(): number
	return if State.profile then Balance.capacity(State.profile, State.hasPass("FazendaGigante")) else 0
end

function State.start()
	Remotes.event("Profile").OnClientEvent:Connect(setProfile)
	task.spawn(function()
		while not State.profile do
			local ok, result = State.request("GetProfile")
			if ok and type(result) == "table" then
				if not State.profile then
					setProfile(result)
				end
				return
			end
			task.wait(1)
		end
	end)
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">Treadmill</string><ProtectedString name="Source"><![CDATA[-- Visual da esteira no cliente: setas da lona correndo, boneco correndo sozinho,
-- "+10 ⚡" subindo a cada ganho e aura de fogo enquanto treina.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Style = require(ReplicatedStorage:WaitForChild("Shared").Style)

local Treadmill = {}

local BELT_SPEED = 7 -- studs/s das setas
local RUN_ANIMATION_SPEED = 1.6
local FLAME = "rbxasset://textures/particles/fire_main.dds"

local player = Players.LocalPlayer
local runTrack: AnimationTrack? = nil
local aura: ParticleEmitter? = nil

type Chevron = { model: Model, belt: BasePart, base: number }
local chevrons: { Chevron } = {}

local function collectChevrons()
	local lotes = Workspace:WaitForChild("Mundo"):WaitForChild("Lotes")
	for _, lote in lotes:GetChildren() do
		local esteira = lote:FindFirstChild("Esteira")
		local belt = esteira and esteira:FindFirstChild("Lona")
		local setas = esteira and esteira:FindFirstChild("Setas")
		if belt and setas then
			for _, seta in setas:GetChildren() do
				if seta:IsA("Model") then
					local local_ = (belt :: BasePart).CFrame:PointToObjectSpace(seta:GetPivot().Position)
					table.insert(chevrons, { model = seta, belt = belt :: BasePart, base = local_.Z })
				end
			end
		end
	end
end

-- Setas andam para trás (de quem corre) e voltam para a frente ao chegar no fim.
local function animateChevrons()
	local shift = os.clock() * BELT_SPEED
	for _, chevron in chevrons do
		local length = chevron.belt.Size.Z
		local z = (chevron.base + length / 2 + shift) % length - length / 2
		chevron.model:PivotTo(chevron.belt.CFrame * CFrame.new(0, chevron.belt.Size.Y / 2 + 0.03, z))
	end
end

local function nearestBelt(root: BasePart): BasePart?
	for _, chevron in chevrons do
		local rel = chevron.belt.CFrame:PointToObjectSpace(root.Position)
		if math.abs(rel.X) <= chevron.belt.Size.X / 2 + 0.3 and math.abs(rel.Z) <= chevron.belt.Size.Z / 2 then
			return chevron.belt
		end
	end
	return nil
end

local function startRunning(character: Model, belt: BasePart)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not humanoid or not root or not animator then
		return
	end
	-- Vira o boneco para a frente da esteira (o painel fica em -Z da lona).
	local forward = -belt.CFrame.LookVector
	forward = Vector3.new(forward.X, 0, forward.Z).Unit
	root.CFrame = CFrame.lookAt(root.Position, root.Position - forward)

	local animate = character:FindFirstChild("Animate")
	local runFolder = animate and animate:FindFirstChild("run")
	local animation = runFolder and runFolder:FindFirstChildOfClass("Animation")
	if animation then
		runTrack = animator:LoadAnimation(animation)
		local track = runTrack :: AnimationTrack
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.2, 1, RUN_ANIMATION_SPEED)
	end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "AuraTreino"
	emitter.Texture = FLAME
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60), Color3.fromRGB(255, 70, 30))
	emitter.LightEmission = 0.8
	emitter.Rate = 40
	emitter.Lifetime = NumberRange.new(0.4, 0.7)
	emitter.Speed = NumberRange.new(4, 7)
	emitter.SpreadAngle = Vector2.new(30, 30)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 2.2),
		NumberSequenceKeypoint.new(1, 0.4),
	})
	emitter.Transparency = NumberSequence.new(0.2, 1)
	emitter.Parent = root
	aura = emitter
end

local function stopRunning()
	if runTrack then
		runTrack:Stop(0.2)
		runTrack = nil
	end
	if aura then
		aura:Destroy()
		aura = nil
	end
end

-- "+10 ⚡" que sobe e some em cima do boneco.
local function popup(amount: number)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(root.Position + Vector3.new(math.random(-20, 20) / 10, 2, math.random(-20, 20) / 10))
	anchor.Parent = Workspace.CurrentCamera
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(5, 1.6)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = "👟+" .. amount
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(120, 200, 255)
	Style.outline(label, 3)
	label.Parent = gui
	local info = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(anchor, info, { CFrame = anchor.CFrame + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, info, { TextTransparency = 1 }):Play()
	task.delay(1.2, function()
		anchor:Destroy()
	end)
end

function Treadmill.start()
	collectChevrons()
	RunService.RenderStepped:Connect(animateChevrons)

	local running = false
	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local belt = root and nearestBelt(root)
		if belt and not running then
			running = true
			startRunning(character :: Model, belt)
		elseif not belt and running then
			running = false
			stopRunning()
		end
	end)
	player.CharacterAdded:Connect(function()
		running = false
		runTrack = nil
		aura = nil
	end)

	local last = player:GetAttribute("Treino") or 0
	player:GetAttributeChangedSignal("Treino"):Connect(function()
		local now = player:GetAttribute("Treino") or 0
		if now > last then
			popup(now - last)
		end
		last = now
	end)
end

return Treadmill
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000039"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Style = require(Shared.Style)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)

export type MenuEntry = { id: string, emoji: string, label: string, color: Color3, onClick: () -> () }

local Hud = {}

local GOLD = Color3.fromRGB(255, 205, 60)
local MONEY = Color3.fromRGB(95, 235, 70)
local BUTTON_SIZE = Vector2.new(196, 62)

local coinsLabel: TextLabel
local coinsScale: UIScale
local rateLabel: TextLabel
local luckLabel: TextLabel
local basketLabel: TextLabel
local basketScale: UIScale
local boostLabels: { [string]: TextLabel } = {}
local speedLabel: TextLabel
local speedScale: UIScale

-- Boosts ativos (mesmos ids do BoostService no servidor).
local BOOSTS = {
	{ id = "Velocidade", emoji = "👟", color = Color3.fromRGB(80, 200, 255) },
	{ id = "Ima", emoji = "🧲", color = Color3.fromRGB(255, 90, 100) },
	{ id = "Escudo", emoji = "🛡️", color = Color3.fromRGB(255, 215, 70) },
}
local goldenFrame: Frame
local goldenLabel: TextLabel
local objectiveLabel: TextLabel
local objectiveScale: UIScale

type MenuButton = { button: TextButton, pointer: TextLabel, badge: Frame }
local buttons: { [string]: MenuButton } = {}
local pointed: string? = nil

-- Texto grande com contorno preto, o "jeito simulador" de escrever.
local function bigText(props: { [string]: any }, outline: number?): TextLabel
	local label = Kit.label(props)
	label.Font = Enum.Font.FredokaOne
	label.TextWrapped = false
	Style.outline(label, outline or 3)
	return label
end

local function menuButton(parent: Instance, entry: MenuEntry, order: number): MenuButton
	local button = Kit.button("", entry.color, entry.onClick, {
		Name = entry.id,
		Size = UDim2.fromOffset(BUTTON_SIZE.X, BUTTON_SIZE.Y),
		LayoutOrder = order,
		Parent = parent,
	})
	-- Botão "gordinho": claro em cima, escuro embaixo, borda escura grossa.
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Thickness = 3.5
		stroke.Color = Kit.darken(entry.color, 0.55)
	end
	Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(175, 175, 175)),
		Rotation = 90,
		Parent = button,
	})
	Kit.label({
		Text = entry.emoji,
		TextSize = 38,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(6, 0),
		Size = UDim2.new(0, 52, 1, 0),
		Parent = button,
	})
	bigText({
		Text = entry.label,
		TextSize = 30,
		TextColor3 = Kit.colors.white,
		Position = UDim2.fromOffset(62, 0),
		Size = UDim2.new(1, -66, 1, 0),
		Parent = button,
	}, 2.5)

	local badge = Kit.new("Frame", {
		BackgroundColor3 = Kit.colors.red,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(30, 30),
		Visible = false,
		ZIndex = 3,
		Parent = button,
	}, { Kit.corner(15), Kit.stroke(Color3.new(1, 1, 1), 2.5) })
	bigText({
		Text = "!",
		TextSize = 24,
		TextColor3 = Kit.colors.white,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Parent = badge,
	}, 2)

	local pointer = bigText({
		Text = "◀",
		TextSize = 44,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, 10, 0.5, 0),
		Size = UDim2.fromOffset(50, 50),
		Visible = false,
		Parent = button,
	}, 3)

	return { button = button, pointer = pointer, badge = badge }
end

function Hud.mount(gui: ScreenGui, scales: { UIScale }, menu: { MenuEntry })
	-- Topo: objetivo em letras grandes, como "Quebre um ovo".
	local top = Kit.new("Frame", {
		Name = "Topo",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(760, 130),
		Parent = gui,
	})
	table.insert(scales, Kit.new("UIScale", { Parent = top }))

	objectiveLabel = bigText({
		Text = "",
		TextSize = 44,
		TextColor3 = Kit.colors.white,
		TextXAlignment = Enum.TextXAlignment.Center,
		BackgroundColor3 = Color3.fromRGB(20, 12, 8),
		BackgroundTransparency = 0.55,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(0, 64),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = top,
	}, 4)
	Kit.corner(14).Parent = objectiveLabel
	Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, 26),
		PaddingRight = UDim.new(0, 26),
		Parent = objectiveLabel,
	})
	objectiveScale = Kit.new("UIScale", { Parent = objectiveLabel })

	goldenFrame = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(120, 80, 10),
		BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(380, 76),
		Size = UDim2.fromOffset(260, 44),
		Visible = false,
		Parent = top,
	}, { Kit.corner(22), Kit.stroke(GOLD, 3) })
	goldenLabel = bigText({
		Text = "🌟 0:00",
		TextSize = 26,
		TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = goldenFrame,
	}, 2.5)

	-- Esquerda: botões grandes com ícone e nome.
	local menuLayout = Kit.list(10)
	menuLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	menuLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	local menuFrame = Kit.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, -20),
		Size = UDim2.fromOffset(BUTTON_SIZE.X + 70, #menu * (BUTTON_SIZE.Y + 10)),
		Parent = gui,
	}, { menuLayout })
	table.insert(scales, Kit.new("UIScale", { Parent = menuFrame }))
	for order, entry in menu do
		buttons[entry.id] = menuButton(menuFrame, entry, order)
	end

	-- Canto de baixo: dinheiro enorme e verde.
	local money = Kit.new("Frame", {
		Name = "Dinheiro",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -14),
		Size = UDim2.fromOffset(420, 112),
		Parent = gui,
	})
	table.insert(scales, Kit.new("UIScale", { Parent = money }))
	rateLabel = bigText({
		Text = "+0/s",
		TextSize = 26,
		TextColor3 = MONEY,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.fromOffset(130, 32),
		Parent = money,
	}, 2.5)
	luckLabel = bigText({
		Text = "🍀 x1.00",
		TextSize = 26,
		TextColor3 = Kit.colors.white,
		Position = UDim2.fromOffset(140, 0),
		Size = UDim2.fromOffset(130, 32),
		Parent = money,
	}, 2.5)
	basketLabel = bigText({
		Text = "🧺 0/20",
		TextSize = 26,
		TextColor3 = Kit.colors.white,
		Position = UDim2.fromOffset(272, 0),
		Size = UDim2.fromOffset(150, 32),
		Parent = money,
	}, 2.5)
	basketScale = Kit.new("UIScale", { Parent = basketLabel })

	-- Linha dos boosts ativos, logo acima do dinheiro.
	local boostLayout = Kit.list(14, true)
	boostLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	local boostRow = Kit.new("Frame", {
		Name = "Boosts",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, -46),
		Size = UDim2.fromOffset(420, 42),
		Parent = money,
	}, { boostLayout })
	-- Velocidade atual sempre à mostra: é onde o treino e as botas aparecem.
	speedLabel = bigText({
		Text = "⚡ 16",
		TextSize = 30,
		TextColor3 = Color3.fromRGB(255, 225, 70),
		Size = UDim2.fromOffset(0, 40),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 0,
		Parent = boostRow,
	}, 3)
	speedScale = Kit.new("UIScale", { Parent = speedLabel })
	for order, boost in BOOSTS do
		boostLabels[boost.id] = bigText({
			Text = boost.emoji,
			TextSize = 30,
			TextColor3 = boost.color,
			Size = UDim2.fromOffset(0, 40),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = order,
			Visible = false,
			Parent = boostRow,
		}, 3)
	end
	Kit.label({
		Text = "💰",
		TextSize = 56,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.fromOffset(72, 72),
		Parent = money,
	})
	coinsLabel = bigText({
		Text = "0",
		TextSize = 60,
		TextColor3 = MONEY,
		Position = UDim2.fromOffset(78, 36),
		Size = UDim2.fromOffset(340, 72),
		Parent = money,
	}, 4.5)
	coinsScale = Kit.new("UIScale", { Parent = coinsLabel })

	-- A setinha do botão apontado fica pulando para chamar atenção.
	RunService.RenderStepped:Connect(function()
		if not pointed then
			return
		end
		local entry = buttons[pointed]
		if entry then
			local bounce = math.abs(math.sin(os.clock() * 6)) * 14
			entry.pointer.Position = UDim2.new(1, 10 + bounce, 0.5, 0)
		end
	end)
end

function Hud.setCoins(value: number)
	coinsLabel.Text = Format.number(value)
	coinsScale.Scale = 1.1
	TweenService:Create(coinsScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

function Hud.setObjective(text: string)
	if objectiveLabel.Text == text then
		return
	end
	objectiveLabel.Text = text
	objectiveScale.Scale = 1.25
	TweenService:Create(objectiveScale, TweenInfo.new(0.4, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

-- Aponta um botão do menu (ou nenhum, com nil): seta pulando + bolinha "!".
function Hud.point(id: string?)
	if pointed == id then
		return
	end
	for buttonId, entry in buttons do
		local active = buttonId == id
		entry.pointer.Visible = active
		entry.badge.Visible = active
	end
	pointed = id
end

-- Cesta: branca normal, vermelha e pulsando quando está cheia.
function Hud.setBasket(count: number, max: number)
	local text = "🧺 " .. count .. "/" .. max
	if basketLabel.Text ~= text then
		basketLabel.Text = text
		basketScale.Scale = 1.2
		TweenService:Create(basketScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	basketLabel.TextColor3 = if count >= max then Kit.colors.red else Kit.colors.white
end

function Hud.tick()
	local player = Players.LocalPlayer
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local text = "⚡ " .. math.floor(humanoid.WalkSpeed + 0.5)
		if speedLabel.Text ~= text then
			speedLabel.Text = text
			speedScale.Scale = 1.4
			TweenService:Create(speedScale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
	end
	local now = Workspace:GetServerTimeNow()
	for _, boost in BOOSTS do
		local left = (player:GetAttribute("Boost" .. boost.id) or 0) - now
		local label = boostLabels[boost.id]
		label.Visible = left > 0
		if left > 0 then
			label.Text = boost.emoji .. " " .. math.ceil(left) .. "s"
		end
	end
	Hud.setBasket(player:GetAttribute("Cesta") or 0, player:GetAttribute("CestaMax") or 20)
	if State.profile then
		rateLabel.Text = "+" .. Format.rate(State.production()) .. "/s"
		luckLabel.Text = string.format("🍀 x%.2f", State.luck())
	end
	local golden = State.isGoldenHour()
	goldenFrame.Visible = golden
	if golden then
		goldenLabel.Text = "🌟 Hora Dourada " .. Format.time(State.goldenHourEnds() - Workspace:GetServerTimeNow())
	end
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local Kit = {}

Kit.colors = {
	panel = Color3.fromRGB(255, 248, 232),
	card = Color3.fromRGB(246, 234, 208),
	border = Color3.fromRGB(122, 80, 42),
	text = Color3.fromRGB(78, 50, 26),
	muted = Color3.fromRGB(145, 115, 85),
	green = Color3.fromRGB(92, 192, 88),
	yellow = Color3.fromRGB(255, 192, 55),
	red = Color3.fromRGB(232, 88, 72),
	blue = Color3.fromRGB(78, 148, 238),
	gray = Color3.fromRGB(168, 158, 148),
	white = Color3.new(1, 1, 1),
	good = Color3.fromRGB(45, 150, 60),
	bad = Color3.fromRGB(200, 60, 50),
}

function Kit.new(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Kit.corner(radius: number?): UICorner
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Kit.stroke(color: Color3?, thickness: number?): UIStroke
	return Kit.new("UIStroke", {
		Color = color or Kit.colors.border,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.padding(pixels: number): UIPadding
	local p = UDim.new(0, pixels)
	return Kit.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function Kit.list(spacing: number, horizontal: boolean?): UIListLayout
	return Kit.new("UIListLayout", {
		Padding = UDim.new(0, spacing),
		FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

function Kit.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = Kit.colors.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Kit.new("TextLabel", defaults)
end

function Kit.darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function Kit.hex(color: Color3, text: string): string
	return string.format('<font color="#%s">%s</font>', color:ToHex(), text)
end

function Kit.button(text: string, color: Color3, onClick: () -> (), props: { [string]: any }?): TextButton
	local button = Kit.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Font = Enum.Font.FredokaOne,
		Text = text,
		TextColor3 = Kit.colors.white,
		TextSize = 18,
		TextStrokeTransparency = 0.6,
		Size = UDim2.fromOffset(140, 40),
	}, { Kit.corner(10), Kit.stroke(Kit.darken(color, 0.35), 2) })
	if props then
		for key, value in props do
			(button :: any)[key] = value
		end
	end
	local scale = Kit.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	button.Activated:Connect(function()
		scale.Scale = 0.92
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		onClick()
	end)
	return button
end

function Kit.paint(button: TextButton, color: Color3)
	button.BackgroundColor3 = color
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Kit.darken(color, 0.35)
	end
end

function Kit.card(height: number, order: number, accent: Color3?): Frame
	return Kit.new("Frame", {
		BackgroundColor3 = Kit.colors.card,
		Size = UDim2.new(1, -8, 0, height),
		LayoutOrder = order,
	}, { Kit.corner(12), Kit.stroke(accent or Kit.colors.border, 2) })
end

function Kit.section(text: string, order: number): TextLabel
	return Kit.label({
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextSize = 22,
		Size = UDim2.new(1, -8, 0, 30),
		LayoutOrder = order,
	})
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">MissionPanel</string><ProtectedString name="Source"><![CDATA[-- Painel fixo da missão atual (lado direito): número, texto, barra de progresso e prêmio.
-- Lê os atributos "Missao*" publicados pelo MissionService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Style = require(Shared.Style)

local Kit = require(script.Parent.Kit)

local MissionPanel = {}

local GOLD = Color3.fromRGB(255, 205, 60)
local GREEN = Color3.fromRGB(95, 235, 70)

local player = Players.LocalPlayer
local header: TextLabel
local body: TextLabel
local fill: Frame
local count: TextLabel
local reward: TextLabel
local scale: UIScale
local lastNumber = 0

local function text(props: { [string]: any }, outline: number): TextLabel
	local label = Kit.label(props)
	label.Font = Enum.Font.FredokaOne
	Style.outline(label, outline)
	return label
end

function MissionPanel.mount(gui: ScreenGui, scales: { UIScale })
	-- Duas camadas: o Roblox aplica só um UIScale por elemento (tamanho da tela + "pulo").
	local holder = Kit.new("Frame", {
		Name = "Missao",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, -10),
		Size = UDim2.fromOffset(330, 150),
		Parent = gui,
	})
	table.insert(scales, Kit.new("UIScale", { Parent = holder }))
	local frame = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(30, 22, 14),
		BackgroundTransparency = 0.25,
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	}, { Kit.corner(16), Kit.stroke(GOLD, 3), Kit.padding(12) })
	scale = Kit.new("UIScale", { Parent = frame })

	header = text({
		Text = "📜 MISSÃO 1",
		TextSize = 20,
		TextColor3 = GOLD,
		Size = UDim2.new(1, 0, 0, 22),
		TextWrapped = false,
		Parent = frame,
	}, 2)
	body = text({
		Text = "",
		TextSize = 22,
		TextColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 52),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	}, 2.5)
	local bar = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(15, 10, 6),
		Position = UDim2.fromOffset(0, 82),
		Size = UDim2.new(1, 0, 0, 22),
		Parent = frame,
	}, { Kit.corner(11) })
	fill = Kit.new("Frame", {
		BackgroundColor3 = GREEN,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { Kit.corner(11) })
	count = text({
		Text = "0/10",
		TextSize = 18,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
		Parent = bar,
	}, 2)
	reward = text({
		Text = "🎁 +💰 0",
		TextSize = 20,
		TextColor3 = GREEN,
		Position = UDim2.fromOffset(0, 108),
		Size = UDim2.new(1, 0, 0, 22),
		TextWrapped = false,
		Parent = frame,
	}, 2)
end

function MissionPanel.tick()
	local number = player:GetAttribute("MissaoNumero")
	if not number then
		return
	end
	local progress = player:GetAttribute("MissaoProgresso") or 0
	local goal = math.max(player:GetAttribute("MissaoMeta") or 1, 1)
	header.Text = "📜 MISSÃO " .. number
	body.Text = player:GetAttribute("MissaoTexto") or ""
	count.Text = if goal == 1 then (if progress >= 1 then "✅" else "0/1") else Format.number(progress) .. "/" .. Format.number(goal)
	reward.Text = "🎁 Prêmio: 💰 " .. Format.number(player:GetAttribute("MissaoPremio") or 0)
	TweenService:Create(fill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(progress / goal, 0, 1), 1) }):Play()
	-- Missão nova: o painel dá um pulo para chamar atenção.
	if number ~= lastNumber then
		if lastNumber ~= 0 then
			scale.Scale = 1.25
			TweenService:Create(scale, TweenInfo.new(0.5, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		lastNumber = number
	end
end

return MissionPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)

local Notifications = {}

local TOAST_SECONDS = 2.6
local MAX_TOASTS = 5
local BIG_SECONDS = 3.8
local REVEAL_SECONDS = 3.2

local toastList: Frame
local toastCount = 0
local bigLabel: TextLabel
local bigSub: TextLabel
local bigToken = 0
local revealFrame: TextButton
local revealTitle: TextLabel
local revealName: TextLabel
local revealSub: TextLabel
local revealGradient: UIGradient
local revealQueue = {}
local revealing = false

function Notifications.mount(gui: ScreenGui, scales: { UIScale })
	local toastLayout = Kit.list(6)
	toastLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	toastList = Kit.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(460, 260),
		Parent = gui,
	}, { toastLayout })
	table.insert(scales, Kit.new("UIScale", { Parent = toastList }))

	local big = Kit.new("Frame", {
		Name = "Aviso",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(820, 110),
		Parent = gui,
	})
	table.insert(scales, Kit.new("UIScale", { Parent = big }))
	bigLabel = Kit.label({
		Font = Enum.Font.FredokaOne,
		TextSize = 44,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.fromRGB(60, 35, 15),
		Size = UDim2.new(1, 0, 0, 60),
		Parent = big,
	})
	bigSub = Kit.label({
		Font = Enum.Font.GothamBold,
		TextSize = 20,
		TextColor3 = Kit.colors.white,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.2,
		TextTransparency = 1,
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = big,
	})

	revealGradient = Kit.new("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(255, 240, 200)),
	})
	revealFrame = Kit.new("TextButton", {
		Name = "Revelacao",
		AutoButtonColor = false,
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 230),
		BackgroundColor3 = Kit.colors.panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, { Kit.corner(22), Kit.stroke(Kit.colors.border, 5), revealGradient })
	local revealScale = Kit.new("UIScale", { Parent = revealFrame })
	table.insert(scales, revealScale)
	revealTitle = Kit.label({
		Font = Enum.Font.FredokaOne,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 34),
		ZIndex = 11,
		Parent = revealFrame,
	})
	revealName = Kit.label({
		Font = Enum.Font.FredokaOne,
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.fromRGB(60, 35, 15),
		Position = UDim2.fromOffset(10, 64),
		Size = UDim2.new(1, -20, 0, 90),
		TextScaled = true,
		ZIndex = 11,
		Parent = revealFrame,
	})
	revealSub = Kit.label({
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = Kit.colors.muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(16, 166),
		Size = UDim2.new(1, -32, 0, 48),
		ZIndex = 11,
		Parent = revealFrame,
	})
	revealFrame.Activated:Connect(function()
		revealFrame.Visible = false
	end)
end

function Notifications.toast(text: string, color: Color3?)
	local accent = color or Kit.colors.yellow
	local toasts = {}
	for _, child in toastList:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts >= MAX_TOASTS then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	toastCount += 1

	local toast = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 30, 20),
		BackgroundTransparency = 0.25,
		Size = UDim2.fromOffset(440, 38),
		LayoutOrder = toastCount,
		Parent = toastList,
	}, { Kit.corner(10), Kit.stroke(accent, 2) })
	local label = Kit.label({
		Text = text,
		Font = Enum.Font.FredokaOne,
		TextSize = 19,
		TextColor3 = accent:Lerp(Color3.new(1, 1, 1), 0.35),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.5,
		Size = UDim2.fromScale(1, 1),
		Parent = toast,
	})
	task.delay(TOAST_SECONDS, function()
		if not toast.Parent then
			return
		end
		local info = TweenInfo.new(0.4)
		TweenService:Create(toast, info, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.4)
		toast:Destroy()
	end)
end

function Notifications.big(title: string, subtitle: string?, color: Color3?)
	bigToken += 1
	local token = bigToken
	bigLabel.Text = title
	bigLabel.TextColor3 = color or Kit.colors.yellow
	bigSub.Text = subtitle or ""
	bigLabel.TextTransparency = 0
	bigLabel.TextStrokeTransparency = 0
	bigSub.TextTransparency = 0
	bigSub.TextStrokeTransparency = 0.2
	bigLabel.TextSize = 20
	TweenService:Create(bigLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back), { TextSize = 44 }):Play()
	task.delay(BIG_SECONDS, function()
		if token ~= bigToken then
			return
		end
		local info = TweenInfo.new(0.6)
		TweenService:Create(bigLabel, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		TweenService:Create(bigSub, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

local function showNextReveal()
	local payload = table.remove(revealQueue, 1)
	if not payload then
		revealing = false
		return
	end
	revealing = true
	local color: Color3 = payload.color or Kit.colors.yellow
	revealTitle.Text = payload.title or ""
	revealName.Text = payload.name or ""
	revealName.TextColor3 = color
	revealSub.Text = payload.sub or ""
	revealGradient.Color = ColorSequence.new(Kit.colors.panel, Kit.colors.panel:Lerp(color, 0.35))
	revealGradient.Rotation = 0
	revealFrame.Size = UDim2.fromOffset(300, 150)
	revealFrame.Visible = true
	TweenService:Create(revealFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(460, 230) })
		:Play()
	TweenService:Create(revealGradient, TweenInfo.new(REVEAL_SECONDS), { Rotation = 180 }):Play()

	local started = os.clock()
	while revealFrame.Visible and os.clock() - started < REVEAL_SECONDS do
		task.wait(0.1)
	end
	revealFrame.Visible = false
	task.wait(0.15)
	showNextReveal()
end

function Notifications.reveal(payload)
	table.insert(revealQueue, payload)
	if not revealing then
		task.spawn(showNextReveal)
	end
end

return Notifications
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000035"><Properties><string name="Name">Pages</string></Properties><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">Animais</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Materials = require(Shared.Config.Materials)
local Rarities = require(Shared.Config.Rarities)
local Species = require(Shared.Config.Species)

local Kit = require(script.Parent.Parent.Kit)
local State = require(script.Parent.Parent.Parent.State)

local SELL_CONFIRM_SECONDS = 3

local function sorted(animals)
	local list = table.clone(animals)
	table.sort(list, function(a, b)
		local pa, pb = Balance.animalProduction(a), Balance.animalProduction(b)
		if pa ~= pb then
			return pa > pb
		end
		return a.id < b.id
	end)
	return list
end

local function materialLine(profile, cost): (string, boolean)
	local parts = { "💰 " .. Format.number(cost.coins) }
	local enough = true
	for _, materialId in Materials.order do
		local need = cost.materials[materialId]
		if need then
			local have = profile.materials[materialId] or 0
			local ok = have >= need
			enough = enough and ok
			local material = Materials.byId[materialId]
			table.insert(
				parts,
				Kit.hex(
					if ok then Kit.colors.good else Kit.colors.bad,
					material.emoji .. " " .. Format.number(have) .. "/" .. Format.number(need)
				)
			)
		end
	end
	return table.concat(parts, "   "), enough
end

local function sellButton(parent: Instance, animal, ctx)
	local price = "Vender 💰 " .. Format.number(Balance.sellPrice(animal))
	local armed = false
	local button: TextButton
	button = Kit.button(price, Kit.colors.yellow, function()
		if not armed then
			armed = true
			button.Text = "Confirmar?"
			Kit.paint(button, Kit.colors.red)
			task.delay(SELL_CONFIRM_SECONDS, function()
				if armed and button.Parent then
					armed = false
					button.Text = price
					Kit.paint(button, Kit.colors.yellow)
				end
			end)
			return
		end
		armed = false
		ctx.act("Sell", animal.id)
	end, { Size = UDim2.fromOffset(150, 32), TextSize = 15, LayoutOrder = 2, Parent = parent })
end

return function(content: Frame, profile, ctx)
	local header = Kit.card(62, 0)
	header.Parent = content
	Kit.label({
		Text = "🏡 Espaços: " .. #profile.animals .. "/" .. State.capacity(),
		Font = Enum.Font.FredokaOne,
		TextSize = 21,
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(0.5, -14, 0, 26),
		Parent = header,
	})
	Kit.label({
		Text = "💰 " .. Format.rate(State.production()) .. " por segundo",
		Font = Enum.Font.FredokaOne,
		TextSize = 21,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.fromScale(0.5, 0) + UDim2.fromOffset(0, 6),
		Size = UDim2.new(0.5, -14, 0, 26),
		Parent = header,
	})
	Kit.label({
		Text = "Evolua com materiais das rotas: cada raridade produz MUITO mais moedas!",
		Font = Enum.Font.Gotham,
		TextSize = 14,
		TextColor3 = Kit.colors.muted,
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 22),
		Parent = header,
	})

	for order, animal in sorted(profile.animals) do
		local species = Species.byId[animal.species]
		local rarity = Rarities.list[animal.rarity]
		local card = Kit.card(104, order, rarity.color)
		card.Parent = content

		Kit.label({
			Text = species.emoji,
			TextSize = 46,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(6, 0),
			Size = UDim2.fromOffset(64, 104),
			Parent = card,
		})
		Kit.label({
			Text = Balance.animalName(animal),
			Font = Enum.Font.FredokaOne,
			TextSize = 22,
			TextColor3 = Kit.darken(rarity.color, 0.25),
			Position = UDim2.fromOffset(74, 8),
			Size = UDim2.new(1, -250, 0, 26),
			Parent = card,
		})
		Kit.label({
			Text = "Produz 💰 " .. Format.rate(Balance.animalProduction(animal)) .. "/s",
			TextColor3 = Kit.colors.muted,
			TextSize = 15,
			Position = UDim2.fromOffset(74, 34),
			Size = UDim2.new(1, -250, 0, 20),
			Parent = card,
		})

		local layout = Kit.list(8)
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		local buttons = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(150, 90),
			Parent = card,
		}, { layout })

		if animal.rarity >= Rarities.MAX then
			Kit.label({
				Text = "⭐ RARIDADE MÁXIMA",
				Font = Enum.Font.FredokaOne,
				TextSize = 15,
				TextColor3 = Kit.darken(rarity.color, 0.2),
				Position = UDim2.fromOffset(74, 58),
				Size = UDim2.new(1, -250, 0, 36),
				Parent = card,
			})
		else
			local cost = Balance.evolveCost(animal.species, animal.rarity)
			if cost then
				local nextRarity = Rarities.list[animal.rarity + 1]
				local nextName = species.name .. " " .. Rarities.label(nextRarity.id, species.feminine)
				local line, materialsOk = materialLine(profile, cost)
				Kit.label({
					RichText = true,
					Text = "▶ " .. Kit.hex(Kit.darken(nextRarity.color, 0.25), nextName) .. "\n" .. line,
					TextSize = 14,
					TextYAlignment = Enum.TextYAlignment.Top,
					Position = UDim2.fromOffset(74, 56),
					Size = UDim2.new(1, -250, 0, 44),
					Parent = card,
				})
				local evolve = Kit.button("⬆ Evoluir", Kit.colors.green, function()
					ctx.act("Evolve", animal.id)
				end, { Size = UDim2.fromOffset(150, 42), LayoutOrder = 1, Parent = buttons })
				ctx.track(evolve, if materialsOk then cost.coins else math.huge, function(affordable)
					Kit.paint(evolve, if affordable then Kit.colors.green else Kit.colors.gray)
				end)
			end
		end
		sellButton(buttons, animal, ctx)
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">Indice</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local Species = require(Shared.Config.Species)

local Kit = require(script.Parent.Parent.Kit)

return function(content: Frame, profile, _ctx)
	local total = #Species.order * Rarities.MAX
	local found = 0
	for _ in profile.index do
		found += 1
	end

	local header = Kit.card(52, 0)
	header.Parent = content
	Kit.label({
		Text = string.format("📖 Descobertos: %d/%d (%d%%)", found, total, math.floor(found / total * 100)),
		Font = Enum.Font.FredokaOne,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		Parent = header,
	})

	for order, speciesId in Species.order do
		local species = Species.byId[speciesId]
		local card = Kit.card(104, order)
		card.Parent = content
		Kit.label({
			Text = species.emoji .. " " .. species.name,
			Font = Enum.Font.FredokaOne,
			TextSize = 20,
			Position = UDim2.fromOffset(14, 6),
			Size = UDim2.new(1, -28, 0, 26),
			Parent = card,
		})

		local layout = Kit.list(6, true)
		local row = Kit.new("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(8, 38),
			Size = UDim2.new(1, -16, 0, 56),
			Parent = card,
		}, { layout })

		for _, rarity in Rarities.list do
			local discovered = profile.index[speciesId .. ":" .. rarity.id] == true
			Kit.new("TextLabel", {
				BackgroundColor3 = if discovered then rarity.color else Kit.colors.gray,
				BackgroundTransparency = if discovered then 0 else 0.4,
				Size = UDim2.new(1 / Rarities.MAX, -6, 1, 0),
				LayoutOrder = rarity.id,
				Font = Enum.Font.FredokaOne,
				TextScaled = true,
				TextColor3 = Kit.colors.white,
				TextStrokeTransparency = 0.4,
				Text = if discovered then Rarities.label(rarity.id, species.feminine) else "?",
				Parent = row,
			}, { Kit.corner(10), Kit.padding(6) })
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">Loja</string><ProtectedString name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local GamePasses = require(Shared.Config.GamePasses)
local Upgrades = require(Shared.Config.Upgrades)

local Kit = require(script.Parent.Parent.Kit)
local State = require(script.Parent.Parent.Parent.State)

local priceCache: { [number]: number } = {}

-- Cada efeito devolve (nome, valor) para mostrar "agora → depois de comprar".
local EFFECTS: { [string]: (any) -> (string, string) } = {
	Sorte = function(profile)
		return "Sorte", string.format("x%.2f", 1 + Balance.LUCK_PER_LEVEL * (profile.upgrades.Sorte or 0))
	end,
	Fazenda = function(profile)
		return "Espaços", tostring(Balance.capacity(profile, State.hasPass("FazendaGigante")))
	end,
	Velocidade = function(profile)
		return "Velocidade", "⚡" .. Balance.walkSpeed(profile)
	end,
	Pulo = function(profile)
		return "Pulos seguidos", (1 + Balance.extraJumps(profile)) .. " (altura " .. string.format("%.1f", Balance.jumpHeight(profile)) .. ")"
	end,
	Rede = function(profile)
		return "Itens a mais", string.format("+%.1f por coleta", Balance.NET_CHANCE_PER_LEVEL * (profile.upgrades.Rede or 0))
	end,
	Cesta = function(profile)
		return "Cesta", Balance.basketCapacity(profile) .. " itens"
	end,
	Esteira = function(profile)
		return "Treino", "+" .. Balance.trainGain(profile) .. "/s"
	end,
}

-- Perfil de mentira com um nível a mais, para calcular o "depois".
local function withLevel(profile, upgradeId: string, level: number)
	local upgrades = table.clone(profile.upgrades)
	upgrades[upgradeId] = level
	return setmetatable({ upgrades = upgrades }, { __index = profile })
end

local function showPrice(button: TextButton, passId: number)
	local function apply(price: number)
		if button.Parent then
			button.Text = "Comprar • " .. price .. " Robux"
		end
	end
	if priceCache[passId] then
		apply(priceCache[passId])
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(passId, Enum.InfoType.GamePass)
		end)
		if ok and info and info.PriceInRobux then
			priceCache[passId] = info.PriceInRobux
			apply(info.PriceInRobux)
		end
	end)
end

local function upgradeCards(content: Frame, profile, ctx, ids: { string }, firstOrder: number)
	for index, upgradeId in ids do
		local order = firstOrder + index
		local def = Upgrades.byId[upgradeId]
		local level = profile.upgrades[upgradeId] or 0
		local card = Kit.card(92, order)
		card.Parent = content
		Kit.label({
			Text = def.emoji .. " " .. def.name .. "   " .. Kit.hex(Kit.colors.muted, "Nv " .. level .. "/" .. def.max),
			RichText = true,
			Font = Enum.Font.FredokaOne,
			TextSize = 21,
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -200, 0, 26),
			Parent = card,
		})
		local label, now = EFFECTS[upgradeId](profile)
		local effect = label .. ": " .. now
		if level < def.max then
			local _, after = EFFECTS[upgradeId](withLevel(profile, upgradeId, level + 1))
			effect = label .. ": " .. now .. "  →  " .. Kit.hex(Kit.colors.good, "<b>" .. after .. "</b>")
		end
		Kit.label({
			Text = def.desc .. "\n" .. effect,
			RichText = true,
			Font = Enum.Font.Gotham,
			TextSize = 14,
			TextColor3 = Kit.colors.muted,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(14, 38),
			Size = UDim2.new(1, -200, 0, 44),
			Parent = card,
		})
		local buttonProps = {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(160, 48),
			Parent = card,
		}
		-- Item que a missão atual pede ganha destaque.
		if Players.LocalPlayer:GetAttribute("MissaoUpgrade") == upgradeId and level < def.max then
			local stroke = card:FindFirstChildOfClass("UIStroke")
			if stroke then
				stroke.Color = Kit.colors.yellow
				stroke.Thickness = 4
			end
			Kit.label({
				Text = "⭐ MISSÃO",
				Font = Enum.Font.FredokaOne,
				TextSize = 15,
				TextColor3 = Color3.fromRGB(200, 120, 0),
				TextXAlignment = Enum.TextXAlignment.Center,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, 2),
				Size = UDim2.fromOffset(160, 18),
				Parent = card,
			})
		end
		if level >= def.max then
			Kit.button("MÁXIMO ⭐", Kit.colors.gray, function() end, buttonProps)
		else
			local cost = Upgrades.cost(upgradeId, level)
			local buy = Kit.button("💰 " .. Format.number(cost), Kit.colors.gray, function()
				ctx.act("BuyUpgrade", upgradeId)
			end, buttonProps)
			ctx.track(buy, cost, function(affordable)
				Kit.paint(buy, if affordable then Kit.colors.green else Kit.colors.gray)
			end)
		end
	end
end

return function(content: Frame, profile, ctx)
	Kit.section("🎒 Equipamentos", 0).Parent = content
	upgradeCards(content, profile, ctx, Upgrades.equipment, 0)
	Kit.section("⚒️ Melhorias da Fazenda", 10).Parent = content
	upgradeCards(content, profile, ctx, Upgrades.farm, 10)

	Kit.section("⭐ Passes Premium", 20).Parent = content

	for order, key in GamePasses.order do
		local pass = GamePasses.byId[key]
		local owned = State.hasPass(key)
		local card = Kit.card(80, 20 + order, Kit.colors.yellow)
		card.Parent = content
		Kit.label({
			Text = pass.emoji .. " " .. pass.name,
			Font = Enum.Font.FredokaOne,
			TextSize = 21,
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -220, 0, 26),
			Parent = card,
		})
		Kit.label({
			Text = pass.desc,
			Font = Enum.Font.Gotham,
			TextSize = 14,
			TextColor3 = Kit.colors.muted,
			Position = UDim2.fromOffset(14, 38),
			Size = UDim2.new(1, -220, 0, 32),
			Parent = card,
		})
		local props = {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(190, 46),
			TextSize = 16,
			Parent = card,
		}
		if owned then
			Kit.button("✅ Ativo", Kit.colors.green, function() end, props)
		elseif pass.id <= 0 then
			Kit.button("Em breve", Kit.colors.gray, function() end, props)
		else
			local buy = Kit.button("Comprar", Kit.colors.yellow, function()
				ctx.act("BuyPass", key)
			end, props)
			showPrice(buy, pass.id)
		end
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">Mochila</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Materials = require(Shared.Config.Materials)

local Kit = require(script.Parent.Parent.Kit)

return function(content: Frame, profile, _ctx)
	Kit.label({
		Text = "⬆️ Estes itens servem para EVOLUIR seus animais: abra o 🐔 Animais e aperte Evoluir.\nItens que brilham nas rotas são raros!",
		Font = Enum.Font.FredokaOne,
		TextSize = 17,
		TextColor3 = Kit.colors.text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -8, 0, 46),
		LayoutOrder = 0,
		Parent = content,
	})

	local grid = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = content,
	}, {
		Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(142, 78),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}),
	})

	for order, materialId in Materials.order do
		local material = Materials.byId[materialId]
		local count = profile.materials[materialId] or 0
		local cell = Kit.new("Frame", {
			BackgroundColor3 = Kit.colors.card,
			BackgroundTransparency = if count > 0 then 0 else 0.5,
			LayoutOrder = order,
			Parent = grid,
		}, { Kit.corner(12), Kit.stroke(if material.tier >= 3 then material.color else Kit.colors.border, 2) })
		Kit.label({
			Text = material.emoji,
			TextSize = 30,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 4),
			Size = UDim2.new(0, 46, 1, -8),
			Parent = cell,
		})
		Kit.label({
			Text = material.name,
			TextSize = 13,
			Position = UDim2.fromOffset(46, 8),
			Size = UDim2.new(1, -50, 0, 32),
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = cell,
		})
		Kit.label({
			Text = "x" .. Format.number(count),
			Font = Enum.Font.FredokaOne,
			TextSize = 20,
			TextColor3 = if count > 0 then Kit.colors.text else Kit.colors.muted,
			Position = UDim2.fromOffset(46, 44),
			Size = UDim2.new(1, -50, 0, 26),
			Parent = cell,
		})
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">Rotas</string><ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Materials = require(Shared.Config.Materials)
local Routes = require(Shared.Config.Routes)
local Species = require(Shared.Config.Species)

local Kit = require(script.Parent.Parent.Kit)

return function(content: Frame, profile, ctx)
	Kit.button("🏡 Voltar para a minha fazenda", Kit.colors.green, function()
		local ok = ctx.act("Travel", "Fazenda")
		if ok then
			ctx.close()
		end
	end, { Size = UDim2.new(1, -8, 0, 46), TextSize = 20, LayoutOrder = 0, Parent = content })

	for order, routeId in Routes.order do
		local route = Routes.byId[routeId]
		local species = Species.byId[route.species]
		local unlocked = profile.routes[routeId] == true
		local card = Kit.card(118, order, if unlocked then route.theme else Kit.colors.gray)
		card.Parent = content

		local materialNames = {}
		for _, materialId in species.materials do
			local material = Materials.byId[materialId]
			table.insert(materialNames, material.emoji .. " " .. material.name)
		end

		Kit.label({
			Text = species.emoji .. " " .. route.name,
			Font = Enum.Font.FredokaOne,
			TextSize = 23,
			TextColor3 = Kit.darken(route.theme, 0.3),
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -200, 0, 28),
			Parent = card,
		})
		Kit.label({
			Text = table.concat(materialNames, "  •  ")
				.. "\n🥚 Ninhos de "
				.. species.name
				.. "  •  💎 Cristal Estelar (raro)",
			Font = Enum.Font.Gotham,
			TextSize = 14,
			TextColor3 = Kit.colors.muted,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(14, 38),
			Size = UDim2.new(1, -200, 0, 40),
			Parent = card,
		})

		if unlocked then
			Kit.button("Ir agora ▶", route.theme, function()
				local ok = ctx.act("Travel", routeId)
				if ok then
					ctx.close()
				end
			end, {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(160, 50),
				TextSize = 21,
				Parent = card,
			})
		else
			local req = route.requirement
			local hasReq = req == nil or Balance.hasAnimal(profile, req.species, req.rarity)
			Kit.label({
				RichText = true,
				Text = Kit.hex(
					if hasReq then Kit.colors.good else Kit.colors.bad,
					(if hasReq then "✔ " else "✖ ") .. Balance.requirementText(routeId)
				),
				TextSize = 14,
				Position = UDim2.fromOffset(14, 84),
				Size = UDim2.new(1, -200, 0, 24),
				Parent = card,
			})
			local unlock = Kit.button("🔓 💰 " .. Format.number(route.unlockCost), Kit.colors.gray, function()
				ctx.act("UnlockRoute", routeId)
			end, {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(160, 50),
				TextSize = 19,
				Parent = card,
			})
			ctx.track(unlock, if hasReq then route.unlockCost else math.huge, function(affordable)
				Kit.paint(unlock, if affordable then Kit.colors.blue else Kit.colors.gray)
			end)
		end
	end
end
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">Panel</string><ProtectedString name="Source"><![CDATA[local Kit = require(script.Parent.Kit)

export type Context = {
	act: (action: string, arg: string?) -> (boolean, any),
	track: (target: GuiObject, cost: number, apply: (affordable: boolean) -> ()) -> (),
	close: () -> (),
}

export type Renderer = (content: Frame, profile: any, ctx: Context) -> ()

local Panel = {}
Panel.__index = Panel

function Panel.new(parent: Instance, title: string, accent: Color3, onClose: () -> ())
	local self = setmetatable({}, Panel)
	self.costs = {} :: { { cost: number, apply: (boolean) -> () } }
	self.content = nil :: Frame?

	self.frame = Kit.new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(640, 470),
		BackgroundColor3 = Kit.colors.panel,
		Visible = false,
		Parent = parent,
	}, { Kit.corner(18), Kit.stroke(Kit.colors.border, 4) })
	self.scale = Kit.new("UIScale", { Parent = self.frame })

	local header = Kit.new("Frame", {
		BackgroundColor3 = accent,
		Size = UDim2.new(1, 0, 0, 58),
		Parent = self.frame,
	}, { Kit.corner(18) })
	Kit.new("Frame", {
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = header,
	})
	Kit.label({
		Text = title,
		Font = Enum.Font.FredokaOne,
		TextSize = 30,
		TextColor3 = Kit.colors.white,
		TextStrokeTransparency = 0.5,
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(1, -90, 1, 0),
		ZIndex = 2,
		Parent = header,
	})
	Kit.button("X", Kit.colors.red, onClose, {
		Size = UDim2.fromOffset(42, 42),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		TextSize = 22,
		ZIndex = 2,
		Parent = header,
	})

	self.body = Kit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(12, 68),
		Size = UDim2.new(1, -24, 1, -80),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = Kit.colors.border,
		Parent = self.frame,
	})
	return self
end

function Panel:isOpen(): boolean
	return self.frame.Visible
end

function Panel:setVisible(visible: boolean)
	self.frame.Visible = visible
end

function Panel:render(renderer: Renderer, profile, baseCtx, coins: number)
	local scroll = self.body.CanvasPosition
	if self.content then
		self.content:Destroy()
	end
	self.costs = {}
	local content = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = self.body,
	}, {
		Kit.list(10),
		Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 10) }),
	})
	self.content = content

	local ctx: Context = {
		act = baseCtx.act,
		close = baseCtx.close,
		track = function(_target, cost, apply)
			table.insert(self.costs, { cost = cost, apply = apply })
			apply(coins >= cost)
		end,
	}
	renderer(content, profile, ctx)
	task.defer(function()
		self.body.CanvasPosition = scroll
	end)
end

function Panel:refreshCosts(coins: number)
	for _, entry in self.costs do
		entry.apply(coins >= entry.cost)
	end
end

return Panel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">TrainingPanel</string><ProtectedString name="Source"><![CDATA[-- Painel que aparece embaixo enquanto o jogador está na esteira: quanto ganha por segundo,
-- barra até o próximo +1 e "⚡ 18 → 19", com o próximo guardião a ultrapassar.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Guardians = require(Shared.Config.Guardians)
local Style = require(Shared.Style)

local Kit = require(script.Parent.Kit)
local State = require(script.Parent.Parent.State)

local TrainingPanel = {}

local BLUE = Color3.fromRGB(120, 210, 255)

local player = Players.LocalPlayer
local holder: Frame
local title: TextLabel
local fill: Frame
local speedText: TextLabel
local goalText: TextLabel

local function text(props: { [string]: any }, outline: number): TextLabel
	local label = Kit.label(props)
	label.Font = Enum.Font.FredokaOne
	label.TextWrapped = false
	label.TextXAlignment = Enum.TextXAlignment.Center
	Style.outline(label, outline)
	return label
end

function TrainingPanel.mount(gui: ScreenGui, scales: { UIScale })
	holder = Kit.new("Frame", {
		Name = "Treino",
		BackgroundColor3 = Color3.fromRGB(12, 24, 48),
		BackgroundTransparency = 0.2,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(480, 132),
		Visible = false,
		Parent = gui,
	}, { Kit.corner(18), Kit.stroke(BLUE, 3), Kit.padding(10) })
	table.insert(scales, Kit.new("UIScale", { Parent = holder }))

	title = text({ Text = "🏃 TREINANDO  +10/s", TextSize = 28, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.new(1, 0, 0, 30), Parent = holder }, 3)
	local bar = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(5, 10, 22),
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = holder,
	}, { Kit.corner(15) })
	fill = Kit.new("Frame", { BackgroundColor3 = BLUE, Size = UDim2.fromScale(0, 1), Parent = bar }, { Kit.corner(15) })
	speedText = text({ Text = "⚡ 16 → 17", TextSize = 24, TextColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = bar }, 2.5)
	goalText = text({ Text = "", TextSize = 20, TextColor3 = Color3.fromRGB(255, 225, 90), Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 24), Parent = holder }, 2)
end

function TrainingPanel.tick()
	local profile = State.profile
	local training = player:GetAttribute("NaEsteira") == true
	holder.Visible = training and profile ~= nil
	if not holder.Visible then
		return
	end
	local points = player:GetAttribute("Treino") or 0
	local speed = Balance.walkSpeed(profile)
	if points >= Balance.TRAIN_MAX then
		title.Text = "🏃 TREINO COMPLETO!"
		speedText.Text = "⚡ " .. speed .. " (máximo)"
		fill.Size = UDim2.fromScale(1, 1)
		goalText.Text = "Compre 👢 Botas na Loja para ficar ainda mais rápido"
		return
	end
	title.Text = "🏃 TREINANDO  +" .. Balance.trainGain(profile) .. "/s"
	local within = points % Balance.TRAIN_PER_SPEED
	speedText.Text = "⚡ " .. speed .. "  →  " .. (speed + 1) .. "     (" .. within .. "/" .. Balance.TRAIN_PER_SPEED .. ")"
	TweenService:Create(fill, TweenInfo.new(0.45), { Size = UDim2.fromScale(within / Balance.TRAIN_PER_SPEED, 1) }):Play()
	-- Mostra o próximo guardião a ultrapassar: é o motivo de treinar.
	goalText.Text = "Você já corre mais que todos os guardiões! 🏆"
	for _, routeId in Guardians.order do
		local guardian = Guardians.byRoute[routeId]
		if speed <= guardian.speed then
			goalText.Text = "Próximo: passar o " .. guardian.emoji .. " " .. guardian.name .. " (⚡" .. guardian.speed .. ")"
			break
		end
	end
end

return TrainingPanel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">Welcome</string><ProtectedString name="Source"><![CDATA[-- Janela "Bem-vindo de volta!" com os ganhos offline (as moedas já entraram no servidor;
-- o botão só fecha a janela com festa).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)
local Style = require(Shared.Style)

local Kit = require(script.Parent.Kit)

local Welcome = {}

local BLUE = Color3.fromRGB(70, 160, 245)
local MONEY = Color3.fromRGB(95, 235, 70)

local function outlined(props: { [string]: any }, thickness: number): TextLabel
	local label = Kit.label(props)
	label.Font = Enum.Font.FredokaOne
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextWrapped = false
	Style.outline(label, thickness)
	return label
end

function Welcome.show(gui: ScreenGui, scales: { UIScale }, amount: number, seconds: number)
	local shade = Kit.new("Frame", {
		Name = "BemVindo",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = gui,
	})
	local window = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(120, 40, 45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 420),
		ZIndex = 51,
		Parent = shade,
	}, { Kit.corner(18), Kit.stroke(Color3.fromRGB(40, 12, 14), 5) })
	local scale = Kit.new("UIScale", { Scale = 0.2, Parent = window })
	table.insert(scales, scale)

	local header = Kit.new("Frame", {
		BackgroundColor3 = BLUE,
		Size = UDim2.new(1, 0, 0, 74),
		ZIndex = 52,
		Parent = window,
	}, { Kit.corner(18), Kit.stroke(Color3.fromRGB(25, 70, 130), 4) })
	outlined({
		Text = "Bem-vindo de volta!",
		TextSize = 40,
		TextColor3 = Color3.new(1, 1, 1),
		Size = UDim2.fromScale(1, 1),
		ZIndex = 53,
		Parent = header,
	}, 3.5)

	outlined({
		Text = "GANHOS OFFLINE",
		TextSize = 44,
		TextColor3 = Color3.new(1, 1, 1),
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.new(1, 0, 0, 50),
		ZIndex = 52,
		Parent = window,
	}, 4)
	outlined({
		Text = "💰",
		TextSize = 70,
		Position = UDim2.fromOffset(0, 146),
		Size = UDim2.new(1, 0, 0, 80),
		ZIndex = 52,
		Parent = window,
	}, 0)
	outlined({
		Text = "+" .. Format.number(amount),
		TextSize = 64,
		TextColor3 = MONEY,
		Position = UDim2.fromOffset(0, 226),
		Size = UDim2.new(1, 0, 0, 72),
		ZIndex = 52,
		Parent = window,
	}, 5)
	outlined({
		Text = "Sua fazenda trabalhou por " .. Format.time(seconds),
		TextSize = 20,
		TextColor3 = Color3.fromRGB(255, 230, 200),
		Position = UDim2.fromOffset(0, 296),
		Size = UDim2.new(1, 0, 0, 26),
		ZIndex = 52,
		Parent = window,
	}, 2)

	local function close()
		TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.1 }):Play()
		task.delay(0.2, function()
			local index = table.find(scales, scale)
			if index then
				table.remove(scales, index)
			end
			shade:Destroy()
		end)
	end
	local button = Kit.button("Resgatar!", Kit.colors.green, close, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 334),
		Size = UDim2.fromOffset(260, 66),
		TextSize = 34,
		ZIndex = 53,
		Parent = window,
	})
	Style.outline(button, 3)

	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

return Welcome
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Balance = require(Shared.Balance)
local Format = require(Shared.Format)
local Routes = require(Shared.Config.Routes)

local State = require(script.Parent.State)

local World = {}

local function statusLabel(routeId: string): TextLabel?
	local world = Workspace:FindFirstChild("Mundo")
	local portals = world and world:FindFirstChild("Portais")
	local portal = portals and portals:FindFirstChild(routeId)
	local beam = portal and (portal :: Model).PrimaryPart
	local gui = beam and beam:FindFirstChild("Rotulo")
	local label = gui and gui:FindFirstChild("Status")
	return label :: TextLabel?
end

local function updatePortals(profile)
	for _, routeId in Routes.order do
		local label = statusLabel(routeId)
		if label then
			if profile.routes[routeId] then
				label.Text = "✅ Entrar"
				label.TextColor3 = Color3.fromRGB(150, 255, 150)
			else
				local route = Routes.byId[routeId]
				label.Text = "🔒 "
					.. Balance.requirementText(routeId)
					.. " + 💰 "
					.. Format.number(route.unlockCost)
				label.TextColor3 = Color3.fromRGB(255, 190, 170)
			end
		end
	end
end

function World.start()
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "HoraDourada"
	tint.Parent = Lighting
	local golden = false

	task.spawn(function()
		while true do
			local active = State.isGoldenHour()
			if active ~= golden then
				golden = active
				TweenService:Create(tint, TweenInfo.new(1.5), {
					TintColor = if active then Color3.fromRGB(255, 232, 185) else Color3.new(1, 1, 1),
					Brightness = if active then 0.04 else 0,
				}):Play()
			end
			if State.profile then
				updatePortals(State.profile)
			end
			task.wait(0.5)
		end
	end)
end

return World
]]></ProtectedString></Properties></Item></Item></Item></Item>
